	Если Не ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ОбъектыПравилаПоТексту(Текст);
КонецПроцедуры

&НаКлиенте
Функция ОбъектыПравилаПоТексту(Текст)
	Результат = Новый СписокЗначений;
	ТекстПоиска = НРег(СокрЛП(Текст));
	Для Каждого ЭлементСписка Из Элементы.ПравилоОбъект.СписокВыбора Цикл
		Если СтрНайти(НРег(ЭлементСписка.Представление), ТекстПоиска) > 0
			Или СтрНайти(НРег(Строка(ЭлементСписка.Значение)), ТекстПоиска) > 0 Тогда
			Результат.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

