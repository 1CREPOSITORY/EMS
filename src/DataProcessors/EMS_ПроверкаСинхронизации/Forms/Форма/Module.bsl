КонецПроцедуры  

&НаКлиенте
Процедура КопироватьСтрокуДляВсехБаз(Команда)

	Если Элементы.ОбъектыМетаданных.ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, "Выделите строку объектов метаданных.");
		Возврат;
	КонецЕсли;

	ТекстВопроса =
	"Скопировать выбранную строку на все базы, у которых заполнены код организации и наименование узла?
	|
	|Копирование остаётся в источнике запуска выбранной строки. Строки другого источника не изменяются.
	|
	|Если для базы строки ещё нет, она будет создана: скопируются все поля, изменится только база.
	|
	|Если строка уже есть, остальные поля будут заменены значениями выбранной строки. Основные и дополнительные поля для сверки заполнятся только когда они пустые. Уже заполненные поля сверки останутся без изменения.";
	Оповещение = Новый ОписаниеОповещения("КопироватьСтрокуДляВсехБазПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура КопироватьСтрокуДляВсехБазПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	КопироватьСтрокуДляВсехБазНаСервере();
	Элементы.ОбъектыМетаданных.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСписокОбъектНеНайденДляБазы(Команда) 
	ТаблицаСообщений = Элементы.СообщенияСинхронизации;
	ТекущаяСтрока = ТаблицаСообщений.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗначениеБазы = ТекущаяСтрока.База;
	ТабДокумент = Новый ТабличныйДокумент;
	ПолучитьСписокОбъектНеНайденДляБазыНаСервере(ТабДокумент, ЗначениеБазы);
	ТабДокумент.Показать("Результаты обработки сообщений");

КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьКОбмену(Команда)

	ТекущаяСтрока = Элементы.СообщенияСинхронизации.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, "Выделите строку в сообщениях синхронизации.");
		Возврат;
	КонецЕсли;

	ТабДокумент = Новый ТабличныйДокумент;
	ЗарегистрироватьКОбменуНаСервере(ТабДокумент, ТекущаяСтрока.База, ТекущаяСтрока.ИсточникЗапуска);
	ТабДокумент.Показать("Результат регистрации объектов к обмену");

КонецПроцедуры

