&НаСервере
Процедура ПроверитьСинхронизациюНаСервере(ПараметрыБазы)
	Диагностика = Неопределено;
	Если ДиагностикаПроизводительности Тогда
		Диагностика = Новый Структура("Включена", Истина);
	КонецЕсли;
	EMS_ПроверкаСинхронизации.ВыполнитьСинхронизацию(Истина, Диагностика, ПараметрыБазы,
		Перечисления.EMS_ИсточникиЗапускаСинхронизации.РучнойЗапуск);
	Если ДиагностикаПроизводительности Тогда
		ЗаполнитьДиагностикуФормы(Диагностика);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура КопироватьСтрокуДляВсехБазНаСервере()
	КлючЗаписи = Элементы.ОбъектыМетаданных.ТекущаяСтрока;
	Если КлючЗаписи = Неопределено Тогда
		Возврат;	
	КонецЕсли;   
	МенеджерЗаписи = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьМенеджерЗаписи();
    ЗаполнитьЗначенияСвойств(МенеджерЗаписи, КлючЗаписи);
    МенеджерЗаписи.Прочитать();
	АктуальныеБазы = Справочники.EMS_ПараметрыБаз.СписокАктуальныхБаз();
	НаборЗаписей = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьНаборЗаписей();
	НаложитьОтборНаНаборЗаписей(НаборЗаписей, КлючЗаписи);  
	ЗаполнитьНаборЗаписей(НаборЗаписей, АктуальныеБазы, МенеджерЗаписи);
	НаборЗаписей.Записать(РежимЗамещения.Слияние);
КонецПроцедуры    

&НаСервере
Процедура НаложитьОтборНаНаборЗаписей(НаборЗаписей, КлючЗаписи)
	МетаданныеРегистра = Метаданные.РегистрыСведений.EMS_ОбъектыМетаданных;
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Если Измерение.Имя <> "ПараметрыБазы" И КлючЗаписи[Измерение.Имя] <> Неопределено Тогда
			НаборЗаписей.Отбор[Измерение.Имя].Установить(КлючЗаписи[Измерение.Имя]);
		КонецЕсли;
	КонецЦикла;		
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьНаборЗаписей(НаборЗаписей, АктуальныеБазы, МенеджерЗаписи)
	СуществующиеЗаписи = СуществующиеПоляСверкиНабора(НаборЗаписей);
	НаборЗаписей.Очистить();
	Для Каждого ПараметрыБазы Из АктуальныеБазы Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ПараметрыБазы = ПараметрыБазы;
		ЗаполнитьЗначенияСвойств(НоваяЗапись, МенеджерЗаписи, , "ПараметрыБазы");
		НоваяЗапись.ИсточникЗапуска = МенеджерЗаписи.ИсточникЗапуска;
		СуществующаяЗапись = СуществующиеЗаписи.Получить(ПараметрыБазы);
		Если СуществующаяЗапись <> Неопределено Тогда
			СохранитьЗаполненныеПоляСверки(НоваяЗапись, СуществующаяЗапись);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СуществующиеПоляСверкиНабора(НаборЗаписей)

	НаборЗаписей.Прочитать();
	Результат = Новый Соответствие;
	Для Каждого Запись Из НаборЗаписей Цикл
		Результат.Вставить(Запись.ПараметрыБазы, Новый Структура(
			"ОсновныеПоляДляСверки, ДополнительныеПоляДляСверки",
			Запись.ОсновныеПоляДляСверки,
			Запись.ДополнительныеПоляДляСверки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура СохранитьЗаполненныеПоляСверки(НоваяЗапись, СуществующаяЗапись)

	Если ЗначениеЗаполнено(СуществующаяЗапись.ОсновныеПоляДляСверки) Тогда
		НоваяЗапись.ОсновныеПоляДляСверки = СуществующаяЗапись.ОсновныеПоляДляСверки;
	КонецЕсли;
	Если ЗначениеЗаполнено(СуществующаяЗапись.ДополнительныеПоляДляСверки) Тогда
		НоваяЗапись.ДополнительныеПоляДляСверки = СуществующаяЗапись.ДополнительныеПоляДляСверки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокОбъектНеНайденДляБазыНаСервере(ТабДокумент, ЗначениеБазы)	

	ТабДокумент.Область("R1C1:R1C4").Объединить();
	ТабДокумент.Область("R1C1").Текст = "Результаты обработки сообщений синхронизации";
	ТабДокумент.Область("R2C1").Текст = "";
	ТабДокумент.Область("R3C1:R3C4").Объединить();
	ТабДокумент.Область("R3C1").Текст = "База: " + ЗначениеБазы;
	ТабДокумент.Область("R4C1").Текст = "";
	ТабДокумент.Область("R5C1").Текст = "№";
	ТабДокумент.Область("R5C2").Текст = "Извлеченное сообщение";
	ТабДокумент.Область("R5C3").Текст = "Вид объекта метаданных";
	ТабДокумент.Область("R5C4").Текст = "Представление";
	ТабДокумент.Область("R6C1").Текст = "";
	
	РегулярноеВыражение = "<Объект не найден> \([^)]*\)";
	ДобавленныеСообщения = Новый Соответствие;
	Фрагменты = Новый Массив;
	СообщенияБезСсылки = Новый Массив;
	
	ИсполняемаяСхема = Элементы.СообщенияСинхронизации.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	ИсполняемыеНастройки = Элементы.СообщенияСинхронизации.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ИсполняемыеНастройки.Отбор,
		"База",
		ЗначениеБазы,
		ВидСравненияКомпоновкиДанных.Равно);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ИсполняемаяСхема, ИсполняемыеНастройки, , , 
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		
		ТекстСообщения = СтрокаТаблицы.Сообщение;
		РезультатПоиска = СтрНайтиВсеПоРегулярномуВыражению(ТекстСообщения, РегулярноеВыражение);
		ЕстьФрагмент = Ложь;
		
		Если РезультатПоиска <> Неопределено Тогда
			
			Для Каждого Совпадение Из РезультатПоиска Цикл
				
				ЕстьФрагмент = Истина;
				НайденнаяПодстрока = Сред(ТекстСообщения, Совпадение.НачальнаяПозиция, Совпадение.Длина);
				Если ДобавленныеСообщения.Получить(НайденнаяПодстрока) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ДобавленныеСообщения.Вставить(НайденнаяПодстрока, Истина);
				Фрагменты.Добавить(НайденнаяПодстрока);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Не ЕстьФрагмент И ЗначениеЗаполнено(ТекстСообщения)
			И ДобавленныеСообщения.Получить(ТекстСообщения) = Неопределено Тогда
			ДобавленныеСообщения.Вставить(ТекстСообщения, Истина);
			СообщенияБезСсылки.Добавить(Новый Структура(
				"Тип, Вид, Сообщение", СтрокаТаблицы.Тип, СтрокаТаблицы.Вид, ТекстСообщения));
		КонецЕсли;
		
	КонецЦикла;

	Описания = EMS_ПроверкаСинхронизации.ОписанияОбъектовНеНайден(ЗначениеБазы, Фрагменты);
	ТаблицаСтрок = Новый ТаблицаЗначений;
	ТаблицаСтрок.Колонки.Добавить("Фрагмент", Новый ОписаниеТипов("Строка"));
	ТаблицаСтрок.Колонки.Добавить("ВидМетаданных", Новый ОписаниеТипов("Строка"));
	ТаблицаСтрок.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));

	Для Каждого Фрагмент Из Фрагменты Цикл
		Описание = Описания.Получить(Фрагмент);
		СтрокаОтчета = ТаблицаСтрок.Добавить();
		СтрокаОтчета.Фрагмент = Фрагмент;
		Если Описание <> Неопределено Тогда
			СтрокаОтчета.ВидМетаданных = Описание.ВидМетаданных;
			СтрокаОтчета.Представление = Описание.Представление;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СообщениеБезСсылки Из СообщенияБезСсылки Цикл
		СтрокаОтчета = ТаблицаСтрок.Добавить();
		СтрокаОтчета.Фрагмент = ТекстСообщенияБезОтбора(СообщениеБезСсылки.Сообщение);
		СтрокаОтчета.ВидМетаданных = ВидМетаданныхСообщения(СообщениеБезСсылки.Тип, СообщениеБезСсылки.Вид);
		СтрокаОтчета.Представление = ПредставлениеКлючаСообщения(СообщениеБезСсылки.Сообщение);
	КонецЦикла;
	ТаблицаСтрок.Сортировать("ВидМетаданных, Фрагмент");

	НомерСтроки = 0;
	ТекущаяСтрокаТД = 7;
	Для Каждого СтрокаОтчета Из ТаблицаСтрок Цикл
		НомерСтроки = НомерСтроки + 1;
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C1").Текст = Строка(НомерСтроки);
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C2").Текст = СтрокаОтчета.Фрагмент;
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C3").Текст = СтрокаОтчета.ВидМетаданных;
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C4").Текст = СтрокаОтчета.Представление;
		ТекущаяСтрокаТД = ТекущаяСтрокаТД + 1;
	КонецЦикла;

	УстановитьШиринуКолонокПоСодержимому(ТабДокумент, 5, 4);
	ТабДокумент.АвтоМасштаб = Ложь;

КонецПроцедуры

&НаСервере
Функция ВидМетаданныхСообщения(Тип, Вид)

	ИменаКоллекций = Новый Соответствие;
	ИменаКоллекций.Вставить("Справочники", "Справочник");
	ИменаКоллекций.Вставить("Документы", "Документ");
	ИменаКоллекций.Вставить("РегистрыСведений", "РегистрСведений");
	ИменаКоллекций.Вставить("РегистрыНакопления", "РегистрНакопления");
	ИменаКоллекций.Вставить("РегистрыБухгалтерии", "РегистрБухгалтерии");
	ИменаКоллекций.Вставить("РегистрыРасчета", "РегистрРасчета");
	ИменаКоллекций.Вставить("ПланыВидовХарактеристик", "ПланВидовХарактеристик");

	ИмяКоллекции = ИменаКоллекций.Получить(Тип);
	Если ИмяКоллекции = Неопределено Тогда
		ИмяКоллекции = Тип;
	КонецЕсли;

	ПолноеИмя = ИмяКоллекции + "." + Вид;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Синоним = ОбъектМетаданных.Представление();
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Возврат Синоним + " (" + ПолноеИмя + ")";

КонецФункции

&НаСервере
Функция ТекстСообщенияБезОтбора(ТекстСообщения)

	Позиция = СтрНайти(ТекстСообщения, "#ОТБОР#");
	Если Позиция = 0 Тогда
		Возврат ТекстСообщения;
	КонецЕсли;
	Возврат СокрП(Лев(ТекстСообщения, Позиция - 1));

КонецФункции

&НаСервере
Функция ПредставлениеКлючаСообщения(ТекстСообщения)

	Текст = ТекстСообщенияБезОтбора(ТекстСообщения);
	Префикс = "В<Л|";
	Если СтрНачинаетсяС(Текст, Префикс) Тогда
		Текст = Сред(Текст, СтрДлина(Префикс) + 1);
	КонецЕсли;

	Части = СтрРазделить(Текст, "|", Ложь);
	Значения = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Часть = СокрЛП(Часть);
		Если СтрЗаканчиваетсяНа(Часть, ",") Тогда
			Часть = СокрЛП(Лев(Часть, СтрДлина(Часть) - 1));
		КонецЕсли;
		Если ЗначениеЗаполнено(Часть) Тогда
			Значения.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Значения, "; ");

КонецФункции

&НаСервере
Процедура УстановитьШиринуКолонокПоСодержимому(ТабДокумент, НомерПервойСтроки, КоличествоКолонок)

	ВысотаТаблицы = Макс(ТабДокумент.ВысотаТаблицы, НомерПервойСтроки);

	Для НомерКолонки = 1 По КоличествоКолонок Цикл

		МаксимальнаяДлина = 0;
		Для НомерСтроки = НомерПервойСтроки По ВысотаТаблицы Цикл
			ДлинаТекста = СтрДлина(СокрЛП(ТабДокумент.Область(НомерСтроки, НомерКолонки).Текст));
			МаксимальнаяДлина = Макс(МаксимальнаяДлина, ДлинаТекста);
		КонецЦикла;

		ШиринаКолонки = МаксимальнаяДлина + 2;
		Если ШиринаКолонки < 4 Тогда
			ШиринаКолонки = 4;
		КонецЕсли;

		ОбластьКолонки = ТабДокумент.Область(НомерПервойСтроки, НомерКолонки, ВысотаТаблицы, НомерКолонки);
		ОбластьКолонки.ШиринаКолонки = ШиринаКолонки;
		ОбластьКолонки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДиагностику(Команда)
	ТабличныйДокумент = ТабличныйДокументДиагностики();
	ТабличныйДокумент.Показать("Диагностика производительности");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиагностикуФормы(Диагностика)

	ДиагностикаОбъекты.Очистить();
	ДиагностикаПакеты.Очистить();
	ДиагностикаЧтение.Очистить();
	Если ТипЗнч(Диагностика) <> Тип("Структура") Или Не Диагностика.Свойство("Объекты") Тогда
		СводкаДиагностики = "Диагностика не собрана.";
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаОбъекта Из УпорядочитьСтруктурыДиагностики(Диагностика.Объекты, "ОбщаяДлительностьМс") Цикл
		СтрокаФормы = ДиагностикаОбъекты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФормы, СтрокаОбъекта);
		ЗаписатьДлительностиФормы(СтрокаФормы, СтрокаОбъекта,
			"ВерхняяБазаМс,HTTPМс,НижняяБазаМс,ОбработкаМс,СравнениеМс,ОбщаяДлительностьМс,ВремяСамогоЭтапаМс,ПодготовкаЗапросаМс,ФормированиеОтбораМс");
	КонецЦикла;

	Для Каждого СтрокаПакета Из Диагностика.Пакеты Цикл
		СтрокаФормы = ДиагностикаПакеты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФормы, СтрокаПакета);
		ЗаписатьДлительностиФормы(СтрокаФормы, СтрокаПакета, "HTTPМс");
	КонецЦикла;

	Для Каждого СтрокаОбъекта Из УпорядочитьСтруктурыДиагностики(Диагностика.Объекты, "ВерхняяБазаМс") Цикл
		СтрокаФормы = ДиагностикаЧтение.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФормы, СтрокаОбъекта);
		ЗаписатьДлительностиФормы(СтрокаФормы, СтрокаОбъекта, "ВерхняяБазаМс,СравнениеМс");
	КонецЦикла;

	СводкаДиагностики = ТекстСводкиДиагностики(Диагностика);

КонецПроцедуры

&НаСервере
Функция ТекстСводкиДиагностики(Диагностика)

	СтрокСверху = ДиагностикаОбъекты.Итог("СтрокСверху");
	СтрокСнизу = ДиагностикаОбъекты.Итог("СтрокСнизу");
	ОтсутствуетСверху = ДиагностикаОбъекты.Итог("ОтсутствуетСверху");
	ОтличияЗначений = ДиагностикаОбъекты.Итог("ОтличияЗначений");
	ПроверенныхБаз = 0;
	Для Каждого СтрокаБазы Из Диагностика.Базы Цикл
		Если СтрокаБазы.Статус = "Проверена" Тогда
			ПроверенныхБаз = ПроверенныхБаз + 1;
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить("Общее время сверки: " + ТекстДлительностиМс(Диагностика.ОбщееВремяМс));
	Строки.Добавить("Проверенных баз: " + Формат(ПроверенныхБаз, "ЧГ=0")
		+ " из " + Формат(Диагностика.Базы.Количество(), "ЧГ=0"));
	Строки.Добавить("Объектов метаданных: " + Формат(ДиагностикаОбъекты.Количество(), "ЧГ=0"));
	КлючейОтбора = 0;
	ВремяОтбора = 0;
	Для Каждого СтрокаОбъекта Из Диагностика.Объекты Цикл
		Если СтрокаОбъекта.Свойство("КлючейОтбора") И ТипЗнч(СтрокаОбъекта.КлючейОтбора) = Тип("Число") Тогда
			КлючейОтбора = КлючейОтбора + СтрокаОбъекта.КлючейОтбора;
		КонецЕсли;
		Если СтрокаОбъекта.Свойство("ФормированиеОтбораМс") И ТипЗнч(СтрокаОбъекта.ФормированиеОтбораМс) = Тип("Число") Тогда
			ВремяОтбора = ВремяОтбора + СтрокаОбъекта.ФормированиеОтбораМс;
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить("Строк сверху после отбора по ключам нижней базы: " + Формат(СтрокСверху, "ЧГ=0")
		+ ", строк снизу: " + Формат(СтрокСнизу, "ЧГ=0")
		+ ", ключей отбора: " + Формат(КлючейОтбора, "ЧГ=0")
		+ ". Формирование отбора: " + ТекстДлительностиМс(ВремяОтбора));
	Строки.Добавить("Расхождений В<Л: " + Формат(ОтсутствуетСверху, "ЧГ=0")
		+ ", В<>Л: " + Формат(ОтличияЗначений, "ЧГ=0"));
	Строки.Добавить("HTTP-вызовов: " + Формат(Диагностика.ВызововHTTP, "ЧГ=0")
		+ ", неудачных пакетов: " + Формат(Диагностика.НеудачныхПакетов, "ЧГ=0")
		+ ", переходов в одиночный режим: " + Формат(Диагностика.ПереходовВОдиночный, "ЧГ=0"));
	Строки.Добавить("Повторных одиночных запросов: " + Формат(Диагностика.ПовторныхЗапросов, "ЧГ=0")
		+ ", их HTTP: " + ТекстДлительностиМс(Диагностика.ПовторМс)
		+ ". Одиночных запросов после перехода: " + Формат(Диагностика.ОдиночныхПослеПерехода, "ЧГ=0"));
	Строки.Добавить("Чтение параметров баз: " + ТекстДлительностиМс(Диагностика.ЧтениеПараметровБазМс)
		+ ". Настройки полей: " + ТекстДлительностиМс(Диагностика.НастройкиПолейМс)
		+ ". Запись сообщений: " + ТекстДлительностиМс(Диагностика.ЗаписьСообщенийМс));
	Строки.Добавить(ТекстПодготовкиБазДиагностики(Диагностика));
	Строки.Добавить("Рейтинг построен по времени объекта без времени HTTP-пакета. Время пакета показано отдельной таблицей.");
	Строки.Добавить("Детализация чтения и ключей — вторая таблица. «не измерено» значит, что этап не выполнялся или нижняя база не вернула новый показатель. Обход выборки и преобразование значений измерены вместе.");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервере
Функция ТекстПодготовкиБазДиагностики(Диагностика)

	Части = Новый Массив;
	Для Каждого СтрокаБазы Из Диагностика.Базы Цикл
		Части.Добавить(СтрокаБазы.База + ": " + СтрокаБазы.Статус
			+ ", соединение " + ТекстДлительностиМс(СтрокаБазы.СоединениеМс)
			+ ", соответствия " + ТекстДлительностиМс(СтрокаБазы.СоответствияМс)
			+ ", список объектов " + ТекстДлительностиМс(СтрокаБазы.ОбъектыМетаданныхМс));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "Подготовка баз не измерялась.";
	КонецЕсли;
	Возврат "Подготовка баз. " + СтрСоединить(Части, "; ");

КонецФункции

&НаСервере
Функция УпорядочитьСтруктурыДиагностики(МассивСтруктур, ИмяПоля)

	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Число"));
	Порядок.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Число"));
	Индекс = 0;
	Для Каждого Элемент Из МассивСтруктур Цикл
		СтрокаПорядка = Порядок.Добавить();
		СтрокаПорядка.Ключ = 0;
		Если Элемент.Свойство(ИмяПоля) И ТипЗнч(Элемент[ИмяПоля]) = Тип("Число") Тогда
			СтрокаПорядка.Ключ = Элемент[ИмяПоля];
		КонецЕсли;
		СтрокаПорядка.Индекс = Индекс;
		Индекс = Индекс + 1;
	КонецЦикла;
	Порядок.Сортировать("Ключ Убыв");

	Результат = Новый Массив;
	Для Каждого СтрокаПорядка Из Порядок Цикл
		Результат.Добавить(МассивСтруктур[СтрокаПорядка.Индекс]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаписатьДлительностиФормы(Приемник, Источник, ИменаПолей)

	Для Каждого ИмяПоля Из СтрРазделить(ИменаПолей, ",", Ложь) Цикл
		Если Не Источник.Свойство(ИмяПоля) Или ТипЗнч(Источник[ИмяПоля]) <> Тип("Число") Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяПоля = "НижняяБазаМс"
			И Источник.Свойство("НижняяБазаИзмерена")
			И Источник.НижняяБазаИзмерена <> Истина Тогда
			Приемник[ИмяПоля] = "не измерено";
		Иначе
			Приемник[ИмяПоля] = ТекстДлительностиМс(Источник[ИмяПоля]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ТекстДлительностиМс(Миллисекунды)

	ДесятыеСекунды = -Цел(-Миллисекунды / 100);
	Секунды = ДесятыеСекунды / 10;
	Возврат Формат(Миллисекунды, "ЧГ=0") + " (" + Формат(Секунды, "ЧДЦ=1; ЧГ=0") + " с)";

КонецФункции

&НаСервере
Функция ТабличныйДокументДиагностики()

	ТабличныйДокумент = Новый ТабличныйДокумент;
	НомерСтроки = 1;
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = "Диагностика производительности";
	НомерСтроки = НомерСтроки + 2;
	Для Каждого СтрокаСводки Из СтрРазделить(СводкаДиагностики, Символы.ПС, Ложь) Цикл
		ТабличныйДокумент.Область(НомерСтроки, 1).Текст = СтрокаСводки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	НомерСтроки = НомерСтроки + 1;
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = "Объекты";
	НомерСтроки = НомерСтроки + 1;
	КолонкиОбъектов = КолонкиТаблицыДиагностики("ДиагностикаОбъекты");
	ВывестиТаблицуДиагностики(ТабличныйДокумент, НомерСтроки, ДиагностикаОбъекты, КолонкиОбъектов);

	НомерСтроки = НомерСтроки + 2;
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = "Детализация чтения и ключей";
	НомерСтроки = НомерСтроки + 1;
	КолонкиЧтения = КолонкиТаблицыДиагностики("ДиагностикаЧтение");
	ВывестиТаблицуДиагностики(ТабличныйДокумент, НомерСтроки, ДиагностикаЧтение, КолонкиЧтения);

	НомерСтроки = НомерСтроки + 2;
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = "HTTP-пакеты";
	НомерСтроки = НомерСтроки + 1;
	КолонкиПакетов = КолонкиТаблицыДиагностики("ДиагностикаПакеты");
	ВывестиТаблицуДиагностики(ТабличныйДокумент, НомерСтроки, ДиагностикаПакеты, КолонкиПакетов);
	Возврат ТабличныйДокумент;

КонецФункции

&НаСервере
Функция КолонкиТаблицыДиагностики(ИмяТаблицы)

	Колонки = Новый Массив;
	Для Каждого РеквизитКолонки Из ПолучитьРеквизиты(ИмяТаблицы) Цикл
		ЗаголовокКолонки = РеквизитКолонки.Заголовок;
		Если Не ЗначениеЗаполнено(ЗаголовокКолонки) Тогда
			ЗаголовокКолонки = РеквизитКолонки.Имя;
		КонецЕсли;
		Колонки.Добавить(Новый Структура("Имя, Заголовок", РеквизитКолонки.Имя, ЗаголовокКолонки));
	КонецЦикла;
	Возврат Колонки;

КонецФункции

&НаСервере
Процедура ВывестиТаблицуДиагностики(ТабличныйДокумент, НомерСтроки, Таблица, Колонки)

	НомерКолонки = 1;
	Для Каждого Колонка Из Колонки Цикл
		Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
		Область.Текст = Колонка.Заголовок;
		Область.Шрифт = Новый Шрифт(, , Истина);
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НомерКолонки = 1;
		Для Каждого Колонка Из Колонки Цикл
			ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст = Строка(СтрокаТаблицы[Колонка.Имя]);
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецПроцедуры
#КонецОбласти
