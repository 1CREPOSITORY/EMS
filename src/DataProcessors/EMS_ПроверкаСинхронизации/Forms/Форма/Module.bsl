&НаКлиенте
Процедура ЗаполнитьМетаданные(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗаполнитьМетаданныеПослеВыбораБазы", ЭтотОбъект);
	ОткрытьФорму("Обработка.EMS_ПроверкаСинхронизации.Форма.ФормаЗаполненияМетаданных",
		, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМетаданныеПослеВыбораБазы(ПараметрыБазы, ДополнительныеПараметры) Экспорт

	Если ПараметрыБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Результат = ЗаполнитьМетаданныеНаСервере(ПараметрыБазы);
	Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ТекстСообщения = СтрШаблон(
		"Добавлено строк: %1, удалено исключённых: %2.
		|База: %3, источник запуска: %4, план обмена: %5, объектов в составе выгрузки: %6, пропущено нижней базой: %7.",
		Результат.ДобавленоСтрок, Результат.УдаленоСтрок, Результат.База, Результат.ИсточникЗапуска,
		Результат.ИмяПланаОбмена, Результат.ВсегоОбъектов, Результат.ПропущеноОбъектов);
	Если Результат.ПравилаКорреспондентаНайдены Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС
			+ "Оставлены объекты, у которых в правилах корреспондента правило включено.";
	Иначе
		ТекстСообщения = ТекстСообщения + Символы.ПС
			+ "Правила корреспондента не загружены или в них нет включённых правил. Отбор по ним не выполнен.";
	КонецЕсли;
	Если Результат.НетВЭтойБазе > 0 Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + СтрШаблон(
			"Нет в метаданных этой базы: %1. Такие объекты записаны, но сверка по ним не пройдёт.",
			Результат.НетВЭтойБазе);
	КонецЕсли;
	Если Результат.Свойство("ОшибкиБаз") И ЗначениеЗаполнено(Результат.ОшибкиБаз) Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + "Не заполнены:" + Символы.ПС + Результат.ОшибкиБаз;
	КонецЕсли;
	ПоказатьПредупреждение(, ТекстСообщения);
	Элементы.ОбъектыМетаданных.Обновить();

КонецПроцедуры

&НаКлиенте
