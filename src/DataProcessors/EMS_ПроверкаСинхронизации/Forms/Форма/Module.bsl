#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗарегистрироватьКОбменуНаСервере(ТабДокумент, ЗначениеБазы, ИсточникЗапуска)

	ТаблицаРезультата = EMS_ПроверкаСинхронизации.ЗарегистрироватьОбъектыКОбмену(ЗначениеБазы, ИсточникЗапуска);

	ТабДокумент.Область("R1C1").Текст = "Результат регистрации объектов к обмену";
	ТабДокумент.Область("R2C1").Текст = "";
	ТабДокумент.Область("R3C1").Текст = "База: " + Строка(ЗначениеБазы);
	ТабДокумент.Область("R4C1").Текст = "";
	ТабДокумент.Область("R5C1").Текст = "№";
	ТабДокумент.Область("R5C2").Текст = "Объект";
	ТабДокумент.Область("R5C3").Текст = "ГУИД";
	ТабДокумент.Область("R5C4").Текст = "Результат";

	НомерСтроки = 0;
	ТекущаяСтрокаТД = 6;

	Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл

		НомерСтроки = НомерСтроки + 1;
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C1").Текст = Строка(НомерСтроки);
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C2").Текст = СтрокаРезультата.ПолноеИмяМетаданных;
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C3").Текст = СтрокаРезультата.УникальныйИдентификатор;
		ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C4").Текст = СтрокаРезультата.Результат;

		ТекущаяСтрокаТД = ТекущаяСтрокаТД + 1;

	КонецЦикла;

	ТабДокумент.АвтоМасштаб = Истина;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьМетаданныеНаСервере(ПараметрыБазы)

	ИсточникЗапуска = ИсточникЗапускаОбъектов;
	Если Не ЗначениеЗаполнено(ИсточникЗапуска) Тогда
		ИсточникЗапуска = Перечисления.EMS_ИсточникиЗапускаСинхронизации.РучнойЗапуск;
	КонецЕсли;
	Возврат EMS_ПроверкаСинхронизации.ЗаполнитьОбъектыМетаданныхПоБазе(ПараметрыБазы, ИсточникЗапуска);

КонецФункции

&НаСервере
Функция ЗаполнитьМетаданныеПоБазамНаСервере(Знач Базы, Знач ИсточникЗапуска)
	Если Не ЗначениеЗаполнено(ИсточникЗапуска) Тогда
		ИсточникЗапуска = Перечисления.EMS_ИсточникиЗапускаСинхронизации.РучнойЗапуск;
	КонецЕсли;
	Результат = EMS_ПроверкаСинхронизации.ЗаполнитьЗашитыеОбъектыМетаданных(Базы, ИсточникЗапуска);
	ИсточникЗапускаОбъектов = ИсточникЗапуска;
	УстановитьОтборОбъектовПоИсточнику();
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗаполнитьНачальныеЗначенияПолейСверкиНаСервере()

	Результат = EMS_ПроверкаСинхронизации.ЗаполнитьНачальныеПоляСверкиПоТипам();
	Возврат СтрШаблон(
		"Начальные настройки заполнены. Создано записей: %1. Существующих записей сохранено: %2.",
		Результат.Создано, Результат.Сохранено);

КонецФункции

&НаСервере
Процедура ЗаполнитьАлгоритмыПоУмолчанию()

	АлгоритмыПоУмолчанию.Очистить();
	Для Каждого Описание Из EMS_АдаптерыСверки.ПредставленияАлгоритмов() Цикл
		СтрокаАлгоритма = АлгоритмыПоУмолчанию.Добавить();
		СтрокаАлгоритма.Представление = Описание.Представление;
		СтрокаАлгоритма.Объект = ПредставлениеОбъектаАлгоритма(Описание.ТипМетаданных, Описание.Вид);
		СтрокаАлгоритма.Поле = ПредставлениеПоляАлгоритма(Описание.ТипМетаданных, Описание.Вид, Описание.ИмяПоля);
		Если Описание.Применимо Тогда
			СтрокаАлгоритма.Статус = "Применим";
			СтрокаАлгоритма.Причина = "";
		Иначе
			СтрокаАлгоритма.Статус = "Не применим";
			СтрокаАлгоритма.Причина = Описание.ТекстНеприменимости;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПравилОбработкиПоБазе()

	Отбор = ПравилаОбработкиПолей.Отбор;
	ПолеБазы = Новый ПолеКомпоновкиДанных("ПараметрыБазы");
	Индекс = Отбор.Элементы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ЭлементОтбора = Отбор.Элементы[Индекс];
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = ПолеБазы Тогда
			Отбор.Элементы.Удалить(ЭлементОтбора);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Отбор, "ПараметрыБазы", БазаОтбораПравилОбработки, ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ГруппаРедакторПравила.Видимость = Ложь;
	Элементы.НадписьВыберитеБазуПравил.Видимость = Не ЗначениеЗаполнено(БазаОтбораПравилОбработки);
	Элементы.ГруппаПользовательскиеПравила.Видимость = ЗначениеЗаполнено(БазаОтбораПравилОбработки);

КонецПроцедуры

&НаСервере
Процедура ПравилоДляВсегоТипаПриИзмененииНаСервере()

	ПравилоОбъект = "";
	ПравилоТип = "";
	ПравилоПоле = "";
	ПравилоАлгоритм = "";
	ЗаполнитьСписокОбъектовПравила();
	ЗаполнитьСписокПолейПравила(Ложь);
	ЗаполнитьСписокАлгоритмовПравила();
	ПоказатьРедакторПравила();

КонецПроцедуры

&НаСервере
Процедура ПравилоОбъектПриИзмененииНаСервере()

	ПравилоПоле = "";
	ПравилоАлгоритм = "";
	ЗаполнитьСписокПолейПравила(Ложь);
	ЗаполнитьСписокАлгоритмовПравила();
	ОбновитьПояснениеПравила();

КонецПроцедуры

&НаСервере
Процедура ПравилоПолеПриИзмененииНаСервере()

	ПравилоАлгоритм = "";
	ЗаполнитьСписокАлгоритмовПравила();
	ОбновитьПояснениеПравила();

КонецПроцедуры

&НаСервере
Процедура ПравилоРежимПриИзмененииНаСервере()

	ЗаполнитьСписокАлгоритмовПравила();
	ОбновитьПояснениеПравила();

КонецПроцедуры

&НаСервере
Процедура НачатьНовоеПравилоНаСервере()

	ПравилоДляВсегоТипа = Ложь;
	ПравилоОбъект = "";
	ПравилоТип = "";
	ПравилоПоле = "";
	ПравилоРежим = Перечисления.EMS_РежимыОбработкиПолейСверки.ПоУмолчанию;
	ПравилоАлгоритм = "";
	ПравилоАктивно = Истина;
	ПравилоИсходныйКлюч = "";
	ЗаполнитьСписокОбъектовПравила();
	ЗаполнитьСписокПолейПравила(Ложь);
	ЗаполнитьСписокАлгоритмовПравила();
	ПоказатьРедакторПравила();

КонецПроцедуры

&НаСервере
Процедура ОткрытьРедакторПравилаНаСервере(ТипМетаданных, Вид, ИмяПоля, Режим, ИдентификаторАлгоритма, Активно)

	ПравилоДляВсегоТипа = Не ЗначениеЗаполнено(Вид);
	Если ПравилоДляВсегоТипа Тогда
		ПравилоОбъект = ТипМетаданных;
	Иначе
		ПравилоОбъект = ТипМетаданных + "|" + Вид;
	КонецЕсли;
	ПравилоТип = ТипМетаданных;
	ПравилоПоле = ИмяПоля;
	ПравилоРежим = Режим;
	ПравилоАлгоритм = ИдентификаторАлгоритма;
	ПравилоАктивно = Активно;
	ПравилоИсходныйКлюч = КлючПравилаФормы(ТипМетаданных, Вид, ИмяПоля);
	ЗаполнитьСписокОбъектовПравила();
	ЗаполнитьСписокПолейПравила(Истина);
	ЗаполнитьСписокАлгоритмовПравила();
	ПоказатьРедакторПравила();

КонецПроцедуры

&НаСервере
Процедура ОтменитьПравилоОбработкиНаСервере()

	Элементы.ГруппаРедакторПравила.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Функция ЗаписатьПравилоОбработкиНаСервере()

	Если Не ЗначениеЗаполнено(БазаОтбораПравилОбработки) Тогда
		Возврат "Выберите информационную базу для настройки правил.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПравилоРежим) Тогда
		Возврат "Выберите режим обработки.";
	КонецЕсли;

	Вид = ВидТекущегоПравила();
	Идентификатор = "";
	Нормализовать = ПравилоРежим = Перечисления.EMS_РежимыОбработкиПолейСверки.Нормализовать;
	Исключить = ПравилоРежим = Перечисления.EMS_РежимыОбработкиПолейСверки.Исключить;
	Если Нормализовать Тогда
		Идентификатор = СокрЛП(ПравилоАлгоритм);
	КонецЕсли;

	ТекстОшибки = EMS_АдаптерыСверки.ТекстОшибкиПравила(
		ПравилоТип, Вид, ПравилоПоле, ПравилоРежим, Идентификатор);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;

	Пояснение = EMS_ПроверкаСинхронизации.ПояснениеПоляПравилаОбработки(
		БазаОтбораПравилОбработки, ПравилоТип, Вид, ПравилоПоле);
	Если Пояснение.ВходитВКлюч И (Нормализовать Или Исключить) Тогда
		Возврат Пояснение.Текст + " Такое правило не записывается.";
	КонецЕсли;

	Ключ = КлючПравилаФормы(ПравилоТип, Вид, ПравилоПоле);
	Менеджер = РегистрыСведений.EMS_ПравилаОбработкиПолей.СоздатьМенеджерЗаписи();
	Менеджер.ПараметрыБазы = БазаОтбораПравилОбработки;
	Менеджер.ТипМетаданных = ПравилоТип;
	Менеджер.Вид = Вид;
	Менеджер.ИмяПоля = ПравилоПоле;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() И Ключ <> ПравилоИсходныйКлюч Тогда
		Возврат "Правило для этого объекта и поля уже есть. Откройте его командой «Изменить».";
	КонецЕсли;
	// Для новой записи Прочитать очищает измерения. Ключ заполняется снова.
	Если Не Менеджер.Выбран() Тогда
		Менеджер.ПараметрыБазы = БазаОтбораПравилОбработки;
		Менеджер.ТипМетаданных = ПравилоТип;
		Менеджер.Вид = Вид;
		Менеджер.ИмяПоля = ПравилоПоле;
	КонецЕсли;

	Менеджер.Режим = ПравилоРежим;
	Менеджер.ИдентификаторАлгоритма = Идентификатор;
	Менеджер.Активно = ПравилоАктивно;
	Менеджер.Записать();

	Если ЗначениеЗаполнено(ПравилоИсходныйКлюч) И ПравилоИсходныйКлюч <> Ключ Тогда
		УдалитьПравилоПоКлючуФормы(ПравилоИсходныйКлюч);
	КонецЕсли;
	Элементы.ГруппаРедакторПравила.Видимость = Ложь;
	Возврат "";

КонецФункции

&НаСервере
Процедура УдалитьПравилоОбработкиНаСервере(ТипМетаданных, Вид, ИмяПоля)

	Ключ = КлючПравилаФормы(ТипМетаданных, Вид, ИмяПоля);
	УдалитьПравилоПоКлючуФормы(Ключ);
	Если ПравилоИсходныйКлюч = Ключ Тогда
		Элементы.ГруппаРедакторПравила.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоказатьРедакторПравила()

	Элементы.ГруппаРедакторПравила.Видимость = Истина;
	Элементы.ПравилоТип.Видимость = Не ПравилоДляВсегоТипа;
	Элементы.ПравилоОбъект.Заголовок = ?(ПравилоДляВсегоТипа, "Тип метаданных", "Объект");
	ОбновитьПояснениеПравила();

КонецПроцедуры

&НаСервере
Процедура ОбновитьПояснениеПравила()

	Вид = ВидТекущегоПравила();
	Текст = "";
	Если ЗначениеЗаполнено(ПравилоТип) И ЗначениеЗаполнено(ПравилоПоле) Тогда
		Пояснение = EMS_ПроверкаСинхронизации.ПояснениеПоляПравилаОбработки(
			БазаОтбораПравилОбработки, ПравилоТип, Вид, ПравилоПоле);
		Текст = Пояснение.Текст;
	КонецЕсли;
	Если ПравилоРежим = Перечисления.EMS_РежимыОбработкиПолейСверки.Нормализовать
		И ЗначениеЗаполнено(ПравилоПоле)
		И Элементы.ПравилоАлгоритм.СписокВыбора.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(Текст) Тогда
			Текст = Текст + " ";
		КонецЕсли;
		Текст = Текст + "Для выбранного объекта и поля нет применимого алгоритма нормализации.";
	КонецЕсли;
	Элементы.НадписьПояснениеПоляПравила.Заголовок = Текст;

КонецПроцедуры

&НаСервере
Функция ВидТекущегоПравила()

	Если ПравилоДляВсегоТипа Тогда
		ПравилоТип = СокрЛП(ПравилоОбъект);
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(ПравилоОбъект, "|");
	Если Позиция = 0 Тогда
		ПравилоТип = "";
		Возврат "";
	КонецЕсли;
	ПравилоТип = Лев(ПравилоОбъект, Позиция - 1);
	Возврат Сред(ПравилоОбъект, Позиция + 1);

КонецФункции

&НаСервере
Функция КлючПравилаФормы(ТипМетаданных, Вид, ИмяПоля)

	Возврат СокрЛП(Строка(ТипМетаданных)) + Символы.ПС + СокрЛП(Строка(Вид)) + Символы.ПС + СокрЛП(Строка(ИмяПоля));

КонецФункции

&НаСервере
Процедура УдалитьПравилоПоКлючуФормы(Ключ)

	Части = СтрРазделить(Ключ, Символы.ПС, Истина);
	Если Части.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;
	Менеджер = РегистрыСведений.EMS_ПравилаОбработкиПолей.СоздатьМенеджерЗаписи();
	Менеджер.ПараметрыБазы = БазаОтбораПравилОбработки;
	Менеджер.ТипМетаданных = Части[0];
	Менеджер.Вид = Части[1];
	Менеджер.ИмяПоля = Части[2];
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		Менеджер.Удалить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОбъектовПравила()

	Список = Элементы.ПравилоОбъект.СписокВыбора;
	Текущее = ПравилоОбъект;
	Список.Очистить();
	Занятые = Новый Соответствие;
	Если ПравилоДляВсегоТипа Тогда
		Для Каждого ТипМетаданных Из ТипыМетаданныхПравил() Цикл
			Список.Добавить(ТипМетаданных.Значение, "Все объекты: " + ТипМетаданных.Представление);
		КонецЦикла;
	Иначе
		Для Каждого ТипМетаданных Из ТипыМетаданныхПравил() Цикл
			Попытка
				Коллекция = Метаданные[ТипМетаданных.Значение];
			Исключение
				Продолжить;
			КонецПопытки;
			Для Каждого ОбъектМД Из Коллекция Цикл
				Синоним = Строка(ОбъектМД.Синоним);
				Если Не ЗначениеЗаполнено(Синоним) Тогда
					Синоним = ОбъектМД.Имя;
				КонецЕсли;
				Представление = Синоним + " (" + ТипМетаданных.Представление + ")";
				Если Занятые.Получить(Представление) <> Неопределено Тогда
					Представление = Синоним + " (" + ОбъектМД.Имя + ", " + ТипМетаданных.Представление + ")";
				КонецЕсли;
				Занятые.Вставить(Представление, Истина);
				Список.Добавить(ТипМетаданных.Значение + "|" + ОбъектМД.Имя, Представление);
			КонецЦикла;
		КонецЦикла;
		Список.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	КонецЕсли;
	Если ЗначениеЗаполнено(Текущее) И Список.НайтиПоЗначению(Текущее) = Неопределено Тогда
		Список.Добавить(Текущее, Текущее);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПолейПравила(СохранятьТекущее)

	Вид = ВидТекущегоПравила();
	Список = Элементы.ПравилоПоле.СписокВыбора;
	Текущее = ПравилоПоле;
	Список.Очистить();
	Поля = Новый Соответствие;
	Если ЗначениеЗаполнено(ПравилоТип) И ЗначениеЗаполнено(Вид) Тогда
		ОбъектМД = EMS_ПроверкаСинхронизации.МетаданныеОбъектаСверки(ПравилоТип, Вид);
		Если ОбъектМД <> Неопределено Тогда
			ДобавитьПоляОбъектаПравила(Поля, ОбъектМД);
		КонецЕсли;
	ИначеЕсли ПравилоДляВсегоТипа И ЗначениеЗаполнено(ПравилоТип) Тогда
		Попытка
			Коллекция = Метаданные[ПравилоТип];
		Исключение
			Коллекция = Новый Массив;
		КонецПопытки;
		Для Каждого ОбъектМД Из Коллекция Цикл
			ДобавитьПоляОбъектаПравила(Поля, ОбъектМД);
		КонецЦикла;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Поля Цикл
		Имя = КлючИЗначение.Ключ;
		Синоним = КлючИЗначение.Значение;
		Если ЗначениеЗаполнено(Синоним) И Синоним <> Имя Тогда
			Представление = Синоним + " (" + Имя + ")";
		Иначе
			Представление = Имя;
		КонецЕсли;
		Список.Добавить(Имя, Представление);
	КонецЦикла;
	Список.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	Если СохранятьТекущее И ЗначениеЗаполнено(Текущее) И Список.НайтиПоЗначению(Текущее) = Неопределено Тогда
		Список.Добавить(Текущее, Текущее);
	КонецЕсли;
	Если Список.НайтиПоЗначению(Текущее) = Неопределено Тогда
		ПравилоПоле = "";
	Иначе
		ПравилоПоле = Текущее;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляОбъектаПравила(Поля, ОбъектМД)

	Для Каждого ИмяКоллекции Из СтрРазделить("СтандартныеРеквизиты,Измерения,Ресурсы,Реквизиты,ПризнакиУчета", ",", Ложь) Цикл
		ДобавитьПоляКоллекцииПравила(Поля, ОбъектМД, ИмяКоллекции);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляКоллекцииПравила(Поля, ОбъектМД, ИмяКоллекции)

	Попытка
		Коллекция = ОбъектМД[ИмяКоллекции];
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Поле Из Коллекция Цикл
		Имя = Поле.Имя;
		Если Не EMS_ПроверкаСинхронизации.ИмяПоляЗапросаДопустимо(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Синоним = "";
		Попытка
			Синоним = Строка(Поле.Синоним);
		Исключение
			Синоним = "";
		КонецПопытки;
		Текущий = Поля.Получить(Имя);
		Если Текущий = Неопределено Или (Не ЗначениеЗаполнено(Текущий) И ЗначениеЗаполнено(Синоним)) Тогда
			Поля.Вставить(Имя, Синоним);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокАлгоритмовПравила()

	Список = Элементы.ПравилоАлгоритм.СписокВыбора;
	Текущий = ПравилоАлгоритм;
	Список.Очистить();
	Нормализация = ПравилоРежим = Перечисления.EMS_РежимыОбработкиПолейСверки.Нормализовать;
	Элементы.ПравилоАлгоритм.Доступность = Нормализация;
	Если Не Нормализация Тогда
		ПравилоАлгоритм = "";
		Возврат;
	КонецЕсли;
	Вид = ВидТекущегоПравила();
	Для Каждого Описание Из EMS_АдаптерыСверки.ПредставленияАлгоритмов() Цикл
		Если Не Описание.Применимо Тогда
			Продолжить;
		КонецЕсли;
		Если Описание.ТипМетаданных <> ПравилоТип Или Описание.ИмяПоля <> ПравилоПоле Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Описание.Вид) И Описание.Вид <> Вид Тогда
			Продолжить;
		КонецЕсли;
		Список.Добавить(Описание.Идентификатор, Описание.Представление);
	КонецЦикла;
	Если Список.НайтиПоЗначению(Текущий) = Неопределено Тогда
		ПравилоАлгоритм = "";
	Иначе
		ПравилоАлгоритм = Текущий;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТипыМетаданныхПравил()

	Типы = Новый СписокЗначений;
	Типы.Добавить("Справочники", "справочник");
	Типы.Добавить("Документы", "документ");
	Типы.Добавить("ПланыВидовХарактеристик", "план видов характеристик");
	Типы.Добавить("РегистрыСведений", "регистр сведений");
	Типы.Добавить("РегистрыНакопления", "регистр накопления");
	Типы.Добавить("РегистрыРасчета", "регистр расчета");
	Типы.Добавить("Последовательности", "последовательность");
	Возврат Типы;

КонецФункции

&НаСервере
Функция ПредставлениеОбъектаАлгоритма(ТипМетаданных, Вид)

	Если Не ЗначениеЗаполнено(Вид) Тогда
		Возврат "Все объекты";
	КонецЕсли;
	ОбъектМД = EMS_ПроверкаСинхронизации.МетаданныеОбъектаСверки(ТипМетаданных, Вид);
	Если ОбъектМД = Неопределено Тогда
		Возврат Вид;
	КонецЕсли;
	Синоним = Строка(ОбъектМД.Синоним);
	Если ЗначениеЗаполнено(Синоним) Тогда
		Возврат Синоним + " (" + Вид + ")";
	КонецЕсли;
	Возврат Вид;

КонецФункции

&НаСервере
Функция ПредставлениеПоляАлгоритма(ТипМетаданных, Вид, ИмяПоля)

	ОбъектМД = EMS_ПроверкаСинхронизации.МетаданныеОбъектаСверки(ТипМетаданных, Вид);
	Если ОбъектМД = Неопределено Тогда
		Возврат ИмяПоля;
	КонецЕсли;
	Синоним = "";
	Для Каждого ИмяКоллекции Из СтрРазделить("СтандартныеРеквизиты,Измерения,Ресурсы,Реквизиты,ПризнакиУчета", ",", Ложь) Цикл
		Попытка
			Поле = ОбъектМД[ИмяКоллекции].Найти(ИмяПоля);
		Исключение
			Поле = Неопределено;
		КонецПопытки;
		Если Поле = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Синоним = Строка(Поле.Синоним);
		Исключение
			Синоним = "";
		КонецПопытки;
		Прервать;
	КонецЦикла;
	Если ЗначениеЗаполнено(Синоним) И Синоним <> ИмяПоля Тогда
		Возврат Синоним + " (" + ИмяПоля + ")";
	КонецЕсли;
	Возврат ИмяПоля;

КонецФункции

&НаСервере
Процедура УстановитьОтборПолейСверкиПоБазе()

	Отбор = ПоляСверкиПоТипам.Отбор;
	ПолеБазы = Новый ПолеКомпоновкиДанных("База");
	Индекс = Отбор.Элементы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ЭлементОтбора = Отбор.Элементы[Индекс];
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = ПолеБазы Тогда
			Отбор.Элементы.Удалить(ЭлементОтбора);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Если ЗначениеЗаполнено(БазаОтбораПолейСверки) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
			Отбор, "База", БазаОтбораПолейСверки, ВидСравненияКомпоновкиДанных.Равно);
	КонецЕсли;

КонецПроцедуры

