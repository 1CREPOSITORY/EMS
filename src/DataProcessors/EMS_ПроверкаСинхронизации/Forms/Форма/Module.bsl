#Область ОписаниеПеременных 
&НаКлиенте
Перем ОтметкиСтрок;
#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Логин = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Логин");
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Пароль");
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СообщенияСинхронизации, "МассивОтмеченных", Новый Массив);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОтметкиСтрок = Новый Соответствие;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиКомандФормы
    
&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
КонецПроцедуры  

&НаКлиенте
Процедура КопироватьСтрокуДляВсехБаз(Команда)
	КопироватьСтрокуДляВсехБазНаСервере(); 
	Элементы.ОбъектыМетаданных.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОбъектыМетаданныхПоВыбраннойБазе(Команда)
	ТекущаяБаза = Элементы.ПараметрыБаз.ТекущаяСтрока;
	Если ТекущаяБаза = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите строку с базой.");
		Возврат;
	КонецЕсли;
	КоличествоДобавленных = ЗаполнитьОбъектыМетаданныхПоВыбраннойБазеНаСервере(ТекущаяБаза);
	Элементы.ОбъектыМетаданных.Обновить();
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		СтрШаблон("Добавлено объектов метаданных: %1.", КоличествоДобавленных));
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСписокОбъектНеНайденДляБазы(Команда) 
	ТаблицаСообщений = Элементы.СообщенияСинхронизации;
	ТекущаяСтрока = ТаблицаСообщений.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗначениеБазы = ТекущаяСтрока.База;
	ТабДокумент = Новый ТабличныйДокумент;
	ПолучитьСписокОбъектНеНайденДляБазыНаСервере(ТабДокумент, ЗначениеБазы);
	ТабДокумент.Показать("Результаты обработки сообщений");
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьВыбранные(Команда)
	ТекущаяСтрока = Элементы.СообщенияСинхронизации.ТекущиеДанные;
	ТекущаяБаза = ?(ТекущаяСтрока = Неопределено, Неопределено, ТекущаяСтрока.База);
	ЗарегистрироватьНаСервере(
		Истина, ТекущаяБаза, ПолучитьМассивОтмеченных());
	Элементы.СообщенияСинхронизации.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьВсе(Команда)  
	ТекущаяСтрока = Элементы.СообщенияСинхронизации.ТекущиеДанные;
	ТекущаяБаза = ?(ТекущаяСтрока = Неопределено, Неопределено, ТекущаяСтрока.База);
	ЗарегистрироватьНаСервере(Ложь, ТекущаяБаза);
	Элементы.СообщенияСинхронизации.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьПоВиду(Команда)
	ТекущаяСтрока = Элементы.СообщенияСинхронизации.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите строку сообщения синхронизации.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.База) Или Не ЗначениеЗаполнено(ТекущаяСтрока.Вид) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В текущей строке не заполнены база или вид.");
		Возврат;
	КонецЕсли;
	Если ОтметкиСтрок = Неопределено Тогда
		ОтметкиСтрок = Новый Соответствие;
	КонецЕсли;
	МассивКлючей = ПолучитьКлючиСообщенийСинхронизацииПоБазеИВиду(ТекущаяСтрока.База, ТекущаяСтрока.Вид);
	Для Каждого КлючСтроки Из МассивКлючей Цикл
		ОтметкиСтрок.Вставить(КлючСтроки, Истина);
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СообщенияСинхронизации, "МассивОтмеченных", ПолучитьМассивОтмеченных());
	Элементы.СообщенияСинхронизации.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура Отмечен(Команда)
	ОтмеченНаСервере(); 
	Элементы.ОбъектыМетаданных.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСинхронизацию(Команда)
	ОтметкиСтрок = Новый Соответствие;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СообщенияСинхронизации, "МассивОтмеченных", Новый Массив);
	ПроверитьСинхронизациюНаСервере();
	Элементы.СообщенияСинхронизации.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОбменДаннымиZ(Команда)
	ТекущаяБаза = Элементы.ПараметрыБаз.ТекущаяСтрока;
	Если ТекущаяБаза = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите строку с базой.");
		Возврат;
	КонецЕсли;
	ДлительнаяОперация = ЗапуститьОбменДаннымиZНаСервере(ТекущаяБаза);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеЗапускаОбменаДаннымиZ", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = "Выполняется обмен с выбранной базой...";
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыСообщенияСинхронизации

&НаКлиенте
Процедура СообщенияСинхронизацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Не Поле.Имя = "СообщенияСинхронизацииОтметка" Тогда
		Возврат;	
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.СообщенияСинхронизации.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ключ = ТекущаяСтрока.КлючСтроки;
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	ТекущееЗначение = ОтметкиСтрок.Получить(Ключ);
	ОтметкиСтрок.Вставить(Ключ, НЕ (ТекущееЗначение = Истина));
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СообщенияСинхронизации, "МассивОтмеченных", ПолучитьМассивОтмеченных());
	Элементы.СообщенияСинхронизации.Обновить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура СохранитьНаСервере()
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("СинхронизацияEMS", Логин, "Логин");
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("СинхронизацияEMS", Пароль, "Пароль");
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивОтмеченных()
	Если ОтметкиСтрок = Неопределено Тогда
		ОтметкиСтрок = Новый Соответствие;
	КонецЕсли;
	МассивОтмеченных = Новый Массив;
	Для Каждого Пара Из ОтметкиСтрок Цикл
		Если Пара.Значение = Истина Тогда
			МассивОтмеченных.Добавить(Пара.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивОтмеченных;
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьСинхронизациюНаСервере()
	EMS_ПроверкаСинхронизации.ВыполнитьСинхронизацию(Истина);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКлючиСообщенийСинхронизацииПоБазеИВиду(Знач База, Знач Вид)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	EMS_СообщенияСинхронизации.КлючСтроки КАК КлючСтроки
		|ИЗ
		|	РегистрСведений.EMS_СообщенияСинхронизации КАК EMS_СообщенияСинхронизации
		|ГДЕ
		|	EMS_СообщенияСинхронизации.База = &База
		|	И EMS_СообщенияСинхронизации.Вид = &Вид";
	Запрос.УстановитьПараметр("База", База);
	Запрос.УстановитьПараметр("Вид", Вид);
	Выборка = Запрос.Выполнить().Выбрать();
	МассивКлючей = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.КлючСтроки) Тогда
			МассивКлючей.Добавить(Выборка.КлючСтроки);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивКлючей;
КонецФункции

&НаСервере
Функция ЗапуститьОбменДаннымиZНаСервере(Знач ПараметрыБазы)
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Синхронизация EMS с выбранной базой";
	ПараметрыВыполнения.УточнениеОшибки = "Не удалось выполнить синхронизацию EMS по причине:";
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"EMS_ПроверкаСинхронизации.ВыполнитьОбменДаннымиZСВыбраннойБазой", ПараметрыБазы);
КонецФункции

// Параметры:
//  Результат - см. ДлительныеОперацииКлиент.НовыйРезультатДлительнойОперации
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ПослеЗапускаОбменаДаннымиZ(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	РезультатОбмена = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если РезультатОбмена = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обмен завершен, результат выполнения не получен.");
		Возврат;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезультатОбмена.Сообщение);
КонецПроцедуры

&НаСервере
Процедура КопироватьСтрокуДляВсехБазНаСервере()
	КлючЗаписи = Элементы.ОбъектыМетаданных.ТекущаяСтрока;
	Если КлючЗаписи = Неопределено Тогда
		Возврат;	
	КонецЕсли;   
	МенеджерЗаписи = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьМенеджерЗаписи();
    ЗаполнитьЗначенияСвойств(МенеджерЗаписи, КлючЗаписи);
    МенеджерЗаписи.Прочитать();
	АктуальныеБазы = Справочники.EMS_ПараметрыБаз.СписокАктуальныхБаз();
	НаборЗаписей = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьНаборЗаписей();
	НаложитьОтборНаНаборЗаписей(НаборЗаписей, КлючЗаписи);  
	ЗаполнитьНаборЗаписей(НаборЗаписей, АктуальныеБазы, МенеджерЗаписи);
	НаборЗаписей.Записать(РежимЗамещения.Слияние);
КонецПроцедуры    

Процедура НаложитьОтборНаНаборЗаписей(НаборЗаписей, КлючЗаписи)
	МетаданныеРегистра = Метаданные.РегистрыСведений.EMS_ОбъектыМетаданных;
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Если Измерение.Имя <> "ПараметрыБазы" И КлючЗаписи[Измерение.Имя] <> Неопределено Тогда
			НаборЗаписей.Отбор[Измерение.Имя].Установить(КлючЗаписи[Измерение.Имя]);
		КонецЕсли;
	КонецЦикла;		
КонецПроцедуры  

Процедура ЗаполнитьНаборЗаписей(НаборЗаписей, АктуальныеБазы, МенеджерЗаписи) 
	Для Каждого ПараметрыБазы Из АктуальныеБазы Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ПараметрыБазы = ПараметрыБазы;
		ЗаполнитьЗначенияСвойств(НоваяЗапись, МенеджерЗаписи, , "ПараметрыБазы");
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьОбъектыМетаданныхПоВыбраннойБазеНаСервере(Знач ПараметрыБазы)
	УдалитьОбъектМетаданныхИзНастройкиБазы(
		ПараметрыБазы, "РегистрыСведений", "СоответствияОбъектовИнформационныхБаз");
	НаборЗаписей = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПараметрыБазы.Установить(ПараметрыБазы);
	НаборЗаписей.Прочитать();
	СуществующиеОбъекты = Новый Соответствие;
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		КлючОбъекта = КлючОбъектаМетаданных(ЗаписьНабора.ОбъектМетаданных, ЗаписьНабора.Вид);
		СуществующиеОбъекты.Вставить(КлючОбъекта, Истина);
	КонецЦикла;
	КоличествоДобавленных = 0;
	Для Каждого ОбъектМетаданных Из ОбъектыМетаданныхОбменаДаннымиZ() Цикл
		КлючОбъекта = КлючОбъектаМетаданных(ОбъектМетаданных.ОбъектМетаданных, ОбъектМетаданных.Вид);
		Если СуществующиеОбъекты.Получить(КлючОбъекта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ПараметрыБазы = ПараметрыБазы;
		НоваяЗапись.ОбъектМетаданных = ОбъектМетаданных.ОбъектМетаданных;
		НоваяЗапись.Вид = ОбъектМетаданных.Вид;
		НоваяЗапись.Представление = ОбъектМетаданных.Представление;
		НоваяЗапись.Выбран = Истина;
		СуществующиеОбъекты.Вставить(КлючОбъекта, Истина);
		КоличествоДобавленных = КоличествоДобавленных + 1;
	КонецЦикла;
	Если КоличествоДобавленных > 0 Тогда
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	Возврат КоличествоДобавленных;
КонецФункции

Функция ОбъектыМетаданныхОбменаДаннымиZ()
	ОбъектыМетаданныхДляЗаполнения = Новый Массив;
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "ФизическиеЛица");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "СтраныМира");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "СпособыОтраженияЗарплатыВБухУчете");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "СпособыОкругленияПриРасчетеЗарплаты");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "РодственникиФизическихЛиц");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "Резервы");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "РегистрацииВНалоговомОргане");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "Пользователи");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "ПодразделенияОрганизаций");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "Организации");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "НастройкиРасчетаРезервовПоОплатеТруда");
	ДобавитьОбъектМетаданныхОбмена(ОбъектыМетаданныхДляЗаполнения, "Справочники", "Контрагенты");
