	КонецЕсли;
	Результат = ЗаполнитьМетаданныеПоБазамНаСервере(Выбор.Базы, Выбор.ИсточникЗапуска);
	Элементы.ОбъектыМетаданных.Обновить();
	ТекстСообщения = СтрШаблон("Добавлено строк: %1. Уже были: %2.", Результат.ДобавленоСтрок, Результат.ПропущеноСтрок);
	ПоказатьПредупреждение(, ТекстСообщения);
КонецПроцедуры

