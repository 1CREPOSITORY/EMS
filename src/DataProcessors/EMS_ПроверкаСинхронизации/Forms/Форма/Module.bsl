&НаСервере
Процедура ПолучитьСписокОбъектНеНайденДляБазыНаСервере(ТабДокумент, ЗначениеБазы)	

    ТабДокумент.Область("R1C1").Текст = "Результаты обработки сообщений синхронизации";
	ТабДокумент.Область("R2C1").Текст = "";
	ТабДокумент.Область("R3C1").Текст = "База: " + ЗначениеБазы;
	ТабДокумент.Область("R4C1").Текст = "";
	ТабДокумент.Область("R5C1").Текст = "№";
	ТабДокумент.Область("R5C2").Текст = "Извлеченное сообщение";
	ТабДокумент.Область("R6C1").Текст = "";
	
	РегулярноеВыражение = "<Объект не найден> \([^)]*\)";
	НомерСтроки = 0;
	ТекущаяСтрокаТД = 7;
	
	ИсполняемаяСхема = Элементы.СообщенияСинхронизации.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	ИсполняемыеНастройки = Элементы.СообщенияСинхронизации.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ИсполняемыеНастройки.Отбор,
		"База",
		ЗначениеБазы,
		ВидСравненияКомпоновкиДанных.Равно);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ИсполняемаяСхема, ИсполняемыеНастройки, , , 
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		
		ТекстСообщения = СтрокаТаблицы.Сообщение;
		РезультатПоиска = СтрНайтиВсеПоРегулярномуВыражению(ТекстСообщения, РегулярноеВыражение);
		
		Если РезультатПоиска <> Неопределено Тогда
			
			Для Каждого Совпадение Из РезультатПоиска Цикл
				
				НомерСтроки = НомерСтроки + 1;
				НайденнаяПодстрока = Сред(ТекстСообщения, Совпадение.НачальнаяПозиция, Совпадение.Длина);
				
				ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C1").Текст = Строка(НомерСтроки);
				ТабДокумент.Область("R" + Формат(ТекущаяСтрокаТД, "ЧГ=0") + "C2").Текст = НайденнаяПодстрока;
				
				ТекущаяСтрокаТД = ТекущаяСтрокаТД + 1;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;	
	ТабДокумент.АвтоМасштаб = Истина;	
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьНаСервере(ТолькоОтмеченные, ТекущаяБаза, МассивОтмеченных = Неопределено)
	МассивГрупп = ПолучитьЗаписиСообщенийДляРегистрацииПоБазам(ТолькоОтмеченные, ТекущаяБаза, МассивОтмеченных);
	Если МассивГрупп.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(?(ТолькоОтмеченные, "Нет отмеченных записей для отправки.", "Нет записей для отправки. Выберите базу в таблице."));
		Возврат;
	КонецЕсли;
	РезультатОтправки = ВыполнитьОтправкуПоБазамИОбновитьРегистр(МассивГрупп);
	Если РезультатОтправки.Успех Тогда
		УспешноКол = 0;
		Для Каждого Рез Из РезультатОтправки.Результаты Цикл
			Если Рез.Success Тогда УспешноКол = УспешноКол + 1; КонецЕсли;
		КонецЦикла;
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Отправлено: %1. Успешно зарегистрировано: %2.", РезультатОтправки.Результаты.Количество(), УспешноКол));
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Ошибка отправки: " + РезультатОтправки.ТекстОшибкиОтправки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВыполнитьОтправкуПоБазамИОбновитьРегистр(МассивГрупп)
	МассивЗаписей = Новый Массив;
	ВсеРезультаты = Новый Массив;
	ИдентификаторПакета = Строка(Новый УникальныйИдентификатор);
	ОбщийУспех = Истина;
	ТекстОшибкиПриНеуспехе = "";
	Для Каждого Группа Из МассивГрупп Цикл
		РезультатОтправки = EMS_ПроверкаСинхронизации.ОтправитьПакетНаРегистрациюИзменений(Группа.Записи);
		РезультатОтправки.ИдентификаторПакета = ИдентификаторПакета;
		Для Каждого Запись Из Группа.Записи Цикл
			МассивЗаписей.Добавить(Запись);
		КонецЦикла;
		ГлобИндекс = МассивЗаписей.Количество() - Группа.Записи.Количество();
		Для Каждого Рез Из РезультатОтправки.Результаты Цикл
			ВсеРезультаты.Добавить(Новый Структура("Индекс, Success, ErrorText, УспехОтправки, ТекстОшибкиОтправкиГруппы",
				ГлобИндекс + Рез.Индекс, Рез.Success, Рез.ErrorText, РезультатОтправки.Успех, РезультатОтправки.ТекстОшибкиОтправки));
		КонецЦикла;
		Если Не РезультатОтправки.Успех Тогда
			ОбщийУспех = Ложь;
			ТекстОшибкиБазы = РезультатОтправки.ТекстОшибкиОтправки;
			Если ЗначениеЗаполнено(ТекстОшибкиБазы) Тогда
				ТекстОшибкиПриНеуспехе = ТекстОшибкиПриНеуспехе + ?(ЗначениеЗаполнено(ТекстОшибкиПриНеуспехе), "; ", "") + ТекстОшибкиБазы;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Не ОбщийУспех И Не ЗначениеЗаполнено(ТекстОшибкиПриНеуспехе) Тогда
		ТекстОшибкиПриНеуспехе = "Не удалось зарегистрировать ни по одной базе.";
	КонецЕсли;
	РезультатОтправки = Новый Структура("Успех, Результаты, ТекстОшибкиОтправки, ИдентификаторПакета", ОбщийУспех, ВсеРезультаты, ТекстОшибкиПриНеуспехе, ИдентификаторПакета);
	ОбновитьРезультатыВРегистре(МассивЗаписей, РезультатОтправки);
	Возврат РезультатОтправки;
КонецФункции

// Возвращает массив групп: каждая группа — Структура("База, Записи", База, Массив записей по одной базе).
// В запросе — ИТОГИ ПО База; обход по выборке: детальные строки (Уровень() = 0) — записи группы, итог (Уровень() = 1) — граница базы.
//
Функция ПолучитьЗаписиСообщенийДляРегистрацииПоБазам(ТолькоОтмеченные, ТекущаяБаза, МассивОтмеченных = Неопределено)
	Если МассивОтмеченных = Неопределено Тогда
		МассивОтмеченных = Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	EMS_СообщенияСинхронизации.База КАК База,
		|	EMS_СообщенияСинхронизации.Тип КАК Тип,
		|	EMS_СообщенияСинхронизации.Вид КАК Вид,
		|	EMS_СообщенияСинхронизации.Сообщение КАК Сообщение,
		|	EMS_СообщенияСинхронизации.Дата КАК Дата,
		|	EMS_СообщенияСинхронизации.ПолноеИмяМетаданных КАК ПолноеИмяМетаданных,
		|	EMS_СообщенияСинхронизации.ВидДанныхДляРегистрации КАК ВидДанныхДляРегистрации,
		|	EMS_СообщенияСинхронизации.КлючРегистрацииОтбор КАК КлючРегистрацииОтбор
		|ИЗ
		|	РегистрСведений.EMS_СообщенияСинхронизации КАК EMS_СообщенияСинхронизации
		|ГДЕ
		|	(НЕ &ТолькоОтмеченные
		|			ИЛИ EMS_СообщенияСинхронизации.КлючСтроки В (&МассивОтмеченных))
		|	И (&ТекущаяБазаПустая
		|			ИЛИ EMS_СообщенияСинхронизации.База = &ТекущаяБаза)
		|
		|УПОРЯДОЧИТЬ ПО
		|	База
		|ИТОГИ ПО
		|	База";
	Запрос.УстановитьПараметр("ТолькоОтмеченные", ТолькоОтмеченные);
	Запрос.УстановитьПараметр("МассивОтмеченных", МассивОтмеченных);
	Запрос.УстановитьПараметр("ТекущаяБаза", ТекущаяБаза);
	Запрос.УстановитьПараметр("ТекущаяБазаПустая", ТекущаяБаза = Неопределено Или Не ЗначениеЗаполнено(ТекущаяБаза));
	ВыборкаПоБазам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	МассивГрупп = Новый Массив;
	Пока ВыборкаПоБазам.Следующий() Цикл
		ТекущаяГруппа = Новый Структура("База, Записи", ВыборкаПоБазам.База, Новый Массив);
		МассивГрупп.Добавить(ТекущаяГруппа);
		ВыборкаЗаписей = ВыборкаПоБазам.Выбрать();
		Пока ВыборкаЗаписей.Следующий() Цикл
			Запись = Новый Структура("База, Тип, Вид, Сообщение, Дата, ПолноеИмяМетаданных, ВидДанныхДляРегистрации, КлючРегистрацииОтбор",
				ВыборкаЗаписей.База, ВыборкаЗаписей.Тип, ВыборкаЗаписей.Вид, ВыборкаЗаписей.Сообщение, ВыборкаЗаписей.Дата,
				ВыборкаЗаписей.ПолноеИмяМетаданных, ВыборкаЗаписей.ВидДанныхДляРегистрации, ВыборкаЗаписей.КлючРегистрацииОтбор);
			ТекущаяГруппа.Записи.Добавить(Запись);
		КонецЦикла;
	КонецЦикла;
	Возврат МассивГрупп;
КонецФункции

Процедура ОбновитьРезультатыВРегистре(МассивЗаписей, РезультатОтправки)
	ДатаОтправки = ТекущаяДатаСеанса();
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	ИдентификаторПакета = РезультатОтправки.ИдентификаторПакета;
	Результаты = РезультатОтправки.Результаты;
	Для Индекс = 0 По МассивЗаписей.Количество() - 1 Цикл
		Запись = МассивЗаписей[Индекс];
		Рез = Неопределено;
		Для Каждого Р Из Результаты Цикл
			Если Р.Индекс = Индекс Тогда 
				Рез = Р; 
				Прервать; 
			КонецЕсли;
		КонецЦикла;
		Если Рез = Неопределено 
			Тогда Продолжить; 
		КонецЕсли;
		НаборЗаписей = РегистрыСведений.EMS_СообщенияСинхронизации.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.База.Установить(Запись.База);
		НаборЗаписей.Отбор.Тип.Установить(Запись.Тип);
		НаборЗаписей.Отбор.Вид.Установить(Запись.Вид);
		НаборЗаписей.Отбор.Сообщение.Установить(Запись.Сообщение);
		НаборЗаписей.Отбор.Дата.Установить(Запись.Дата);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			СтрокаНабора = НаборЗаписей[0];
			УспехОтправки = Рез.УспехОтправки;
			СтрокаНабора.СтатусОтправки = ?(УспехОтправки, "Отправлено", "ОшибкаОтправки");
			СтрокаНабора.ДатаОтправки = ДатаОтправки;
			СтрокаНабора.ИдентификаторПакета = ИдентификаторПакета;
			СтрокаНабора.Пользователь = ТекущийПользователь;
			Если УспехОтправки Тогда
				СтрокаНабора.СтатусРегистрации = ?(Рез.Success, "Зарегистрировано", "ОшибкаРегистрации");
				СтрокаНабора.ДатаРегистрации = ?(Рез.Success, ДатаОтправки, Неопределено);
				СтрокаНабора.ТекстОшибки = ?(Рез.Success, "", Рез.ErrorText);
			Иначе
				СтрокаНабора.ТекстОшибки = Рез.ТекстОшибкиОтправкиГруппы;
			КонецЕсли;
			НаборЗаписей.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОтмеченНаСервере()
	Для Каждого Эл Из Элементы.ОбъектыМетаданных.ВыделенныеСтроки Цикл
		МЗ = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьМенеджерЗаписи(); 
		ЗаполнитьЗначенияСвойств(МЗ, ЭЛ);
		МЗ.Прочитать();
		Если МЗ.Выбран() Тогда
			МЗ.Выбран = Не МЗ.Выбран;
			МЗ.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
