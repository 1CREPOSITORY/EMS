#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИсточникЗапуска = Перечисления.EMS_ИсточникиЗапускаСинхронизации.РучнойЗапуск;
	ЗначениеПараметра = Неопределено;
	Если Параметры.Свойство("ИсточникЗапуска", ЗначениеПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		ИсточникЗапуска = ЗначениеПараметра;
	КонецЕсли;
	ЗначениеПараметра = Неопределено;
	Если Параметры.Свойство("НаименованиеНабора", ЗначениеПараметра) Тогда
		НаименованиеНабора = СокрЛП(Строка(ЗначениеПараметра));
	КонецЕсли;
	ЗаполнитьСписокНаборов();
	ЗаполнитьСписокБаз();
	ЗаполнитьСписокОбъектов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НаборыОтметкаПриИзменении(Элемент)
	ЗаполнитьСписокОбъектов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодтвердитьЗаполнениеМетаданныхПоБазам(Команда)
	Если КоличествоОтмеченныхНаборов() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите хотя бы один набор метаданных.");
		Возврат;
	КонецЕсли;
	Если КоличествоОтмеченныхБаз() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите хотя бы одну базу.");
		Возврат;
	КонецЕсли;
	КоличествоОбъектов = КоличествоКорректныхОбъектовНабора();
	Если КоличествоОбъектов = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"В выбранных наборах нет корректных объектов. Заполнение не выполнено.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИсточникЗапуска) Тогда
		ИсточникЗапуска = ПредопределенноеЗначение("Перечисление.EMS_ИсточникиЗапускаСинхронизации.РучнойЗапуск");
	КонецЕсли;
	ТекстВопроса = СтрШаблон(
		"Заполнить %1 наборов (%2 уникальных объектов) для %3 информационных баз, источник запуска - %4?",
		КоличествоОтмеченныхНаборов(),
		КоличествоОбъектов,
		КоличествоОтмеченныхБаз(),
		Строка(ИсточникЗапуска));
	ТекстВопроса = СтрШаблон("%1 Существующие настройки изменены не будут.", ТекстВопроса);
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьЗаполнениеМетаданныхПоБазамЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьЗаполнениеМетаданныхПоБазам(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодтвердитьЗаполнениеМетаданныхПоБазамЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	БазыКЗаполнению = Новый Массив;
	Для Каждого СтрокаБазы Из Базы Цикл
		Если СтрокаБазы.Отметка Тогда
			БазыКЗаполнению.Добавить(СтрокаБазы.ПараметрыБазы);
		КонецЕсли;
	КонецЦикла;
	ИменаНаборов = Новый Массив;
	Для Каждого СтрокаНабора Из Наборы Цикл
		Если СтрокаНабора.Отметка Тогда
			ИменаНаборов.Добавить(СтрокаНабора.Наименование);
		КонецЕсли;
	КонецЦикла;
	Закрыть(Новый Структура("ИсточникЗапуска, Базы, ИменаНаборов",
		ИсточникЗапуска, БазыКЗаполнению, ИменаНаборов));
КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченныхНаборов()
	Количество = 0;
	Для Каждого СтрокаНабора Из Наборы Цикл
		Если СтрокаНабора.Отметка Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

&НаКлиенте
Функция КоличествоОтмеченныхБаз()
	Количество = 0;
	Для Каждого СтрокаБазы Из Базы Цикл
		Если СтрокаБазы.Отметка Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

&НаКлиенте
Функция КоличествоКорректныхОбъектовНабора()
	Количество = 0;
	Для Каждого СтрокаОбъекта Из Объекты Цикл
		Если СтрокаОбъекта.Статус = "Корректно" Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокНаборов()
	Для Каждого ИмяНабора Из EMS_ПроверкаСинхронизации.ИменаНаборовМетаданных() Цикл
		НоваяСтрока = Наборы.Добавить();
		НоваяСтрока.Наименование = ИмяНабора;
		НоваяСтрока.Отметка = ИмяНабора = НаименованиеНабора;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокБаз()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	EMS_ПараметрыБаз.Ссылка КАК ПараметрыБазы,
	|	EMS_ПараметрыБаз.Наименование КАК Наименование,
	|	EMS_ПараметрыБаз.Код КАК Код
	|ИЗ
	|	Справочник.EMS_ПараметрыБаз КАК EMS_ПараметрыБаз
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Базы.Добавить();
		НоваяСтрока.ПараметрыБазы = Выборка.ПараметрыБазы;
		НоваяСтрока.Наименование = Выборка.Наименование;
		НоваяСтрока.Код = Выборка.Код;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОбъектов()
	Объекты.Очистить();
	ИменаНаборов = Новый Массив;
	Для Каждого СтрокаНабора Из Наборы Цикл
		Если СтрокаНабора.Отметка Тогда
			ИменаНаборов.Добавить(СтрокаНабора.Наименование);
		КонецЕсли;
	КонецЦикла;
	Если ИменаНаборов.Количество() = 0 Тогда
		Элементы.Объекты.Заголовок = "Наборы не выбраны";
		Возврат;
	КонецЕсли;
	Состав = EMS_ПроверкаСинхронизации.СоставНаборовМетаданных(ИменаНаборов);
	Элементы.Объекты.Заголовок = СтрШаблон(
		"Объекты для заполнения: наборов %1, корректных уникальных объектов %2",
		ИменаНаборов.Количество(), Состав.КоличествоКорректных);
	Для Каждого Описание Из Состав.Объекты Цикл
		НоваяСтрока = Объекты.Добавить();
		НоваяСтрока.Тип = Описание.Тип;
		НоваяСтрока.Вид = Описание.Вид;
		НоваяСтрока.ПолноеИмя = Описание.ПолноеИмя;
		НоваяСтрока.Представление = Описание.Представление;
		НоваяСтрока.Статус = Описание.Статус;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
