#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИсточникЗапуска = Перечисления.EMS_ИсточникиЗапускаСинхронизации.РучнойЗапуск;
	Если Параметры.Свойство("ИсточникЗапуска") И ЗначениеЗаполнено(Параметры.ИсточникЗапуска) Тогда
		ИсточникЗапуска = Параметры.ИсточникЗапуска;
	КонецЕсли;
	ЗаполнитьСписокБаз();
	ЗаполнитьСписокОбъектов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодтвердитьЗаполнениеМетаданныхПоБазам(Команда)
	БазыКЗаполнению = Новый Массив;
	Для Каждого СтрокаБазы Из Базы Цикл
		Если СтрокаБазы.Отметка Тогда
			БазыКЗаполнению.Добавить(СтрокаБазы.ПараметрыБазы);
		КонецЕсли;
	КонецЦикла;
	Если БазыКЗаполнению.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите хотя бы одну базу.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИсточникЗапуска) Тогда
		ИсточникЗапуска = ПредопределенноеЗначение("Перечисление.EMS_ИсточникиЗапускаСинхронизации.РучнойЗапуск");
	КонецЕсли;
	Закрыть(Новый Структура("ИсточникЗапуска, Базы", ИсточникЗапуска, БазыКЗаполнению));
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьЗаполнениеМетаданныхПоБазам(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокБаз()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	EMS_ПараметрыБаз.Ссылка КАК ПараметрыБазы,
	|	EMS_ПараметрыБаз.Наименование КАК Наименование,
	|	EMS_ПараметрыБаз.Код КАК Код
	|ИЗ
	|	Справочник.EMS_ПараметрыБаз КАК EMS_ПараметрыБаз
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Базы.Добавить();
		НоваяСтрока.ПараметрыБазы = Выборка.ПараметрыБазы;
		НоваяСтрока.Наименование = Выборка.Наименование;
		НоваяСтрока.Код = Выборка.Код;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОбъектов()
	Описания = EMS_ПроверкаСинхронизации.ОписанияЗашитыхДокументовМетаданных();
	Для Каждого Описание Из Описания Цикл
		НоваяСтрока = Объекты.Добавить();
		НоваяСтрока.Вид = Описание.Вид;
		НоваяСтрока.Представление = Описание.Представление;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
