#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РазрешитьПустуюБазу = Ложь;
	Если Параметры.Свойство("РазрешитьПустуюБазу") Тогда
		РазрешитьПустуюБазу = Параметры.РазрешитьПустуюБазу;
	КонецЕсли;
	Элементы.ПараметрыБазы.АвтоОтметкаНезаполненного = Ложь;
	Элементы.ПараметрыБазы.ОтметкаНезаполненного = Ложь;
	Элементы.ПараметрыБазы.КнопкаОчистки = Истина;
	Если РазрешитьПустуюБазу Тогда
		Заголовок = "Сравнение";
		Элементы.Заполнить.Заголовок = "Сравнить";
		Элементы.Заполнить.Подсказка =
			"Если база выбрана, сравниваются только её объекты. Если поле пустое, сравнение выполняется по всем базам.";
		Элементы.Отмена.Подсказка = "Сравнение не запускается.";
		Элементы.ПараметрыБазы.Подсказка =
			"Можно оставить пустым: тогда сверка идёт по всем базам. Чтобы сверить одну базу, выберите её.";
	Иначе
		Элементы.Заполнить.Подсказка =
			"Если база выбрана, состав выгрузки запрашивается только у неё. Если поле пустое, заполнение выполняется по всем базам.";
		Элементы.Отмена.Подсказка = "Заполнение не выполняется.";
		Элементы.ПараметрыБазы.Подсказка =
			"Можно оставить пустым: тогда объекты заполняются по всем базам. Чтобы заполнить одну базу, выберите её.";
	КонецЕсли;
	Элементы.ПараметрыБазы.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	Элементы.Заполнить.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	Элементы.Отмена.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Закрыть(ПараметрыБазы);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

#КонецОбласти
