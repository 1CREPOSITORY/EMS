#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РазрешитьПустуюБазу = Ложь;
	Если Параметры.Свойство("РазрешитьПустуюБазу") Тогда
		РазрешитьПустуюБазу = Параметры.РазрешитьПустуюБазу;
	КонецЕсли;
	Если РазрешитьПустуюБазу Тогда
		Заголовок = "Сравнение";
		Элементы.Заполнить.Заголовок = "Сравнить";
		Элементы.Заполнить.Подсказка =
			"Если база выбрана, сравниваются только её объекты. Если поле пустое, сравнение выполняется по всем базам. Сообщения остальных баз сохраняются.";
		Элементы.Отмена.Подсказка = "Сравнение не запускается.";
	Иначе
		Элементы.Заполнить.Подсказка =
			"По выбранной базе запрашивается состав выгрузки. Недостающие объекты добавляются, строки вне состава удаляются.";
		Элементы.Отмена.Подсказка = "Заполнение не выполняется.";
	КонецЕсли;
	Элементы.Заполнить.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	Элементы.Отмена.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Если Не РазрешитьПустуюБазу И Не ЗначениеЗаполнено(ПараметрыБазы) Тогда
		ПоказатьПредупреждение(, "Выберите базу.");
		Возврат;
	КонецЕсли;

	Закрыть(ПараметрыБазы);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

#КонецОбласти
