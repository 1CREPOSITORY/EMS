#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Запись.НаименованиеНабора = СокрЛП(Запись.НаименованиеНабора);
	ИсходноеНаименование = Запись.НаименованиеНабора;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.НаименованиеНабора = СокрЛП(ТекущийОбъект.НаименованиеНабора);
	Если Не ЗначениеЗаполнено(ТекущийОбъект.НаименованиеНабора) Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажите наименование набора.", , , , Отказ);
		Возврат;
	КонецЕсли;
	Если ТекущийОбъект.НаименованиеНабора = ИсходноеНаименование Тогда
		Возврат;
	КонецЕсли;
	Менеджер = РегистрыСведений.EMS_НаборыМетаданных.СоздатьМенеджерЗаписи();
	Менеджер.НаименованиеНабора = ТекущийОбъект.НаименованиеНабора;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Набор ""%1"" уже есть.", ТекущийОбъект.НаименованиеНабора), , , , Отказ);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Если Не ЗначениеЗаполнено(ИсходноеНаименование)
		Или ИсходноеНаименование = ТекущийОбъект.НаименованиеНабора Тогда
		ИсходноеНаименование = ТекущийОбъект.НаименованиеНабора;
		Возврат;
	КонецЕсли;
	Менеджер = РегистрыСведений.EMS_НаборыМетаданных.СоздатьМенеджерЗаписи();
	Менеджер.НаименованиеНабора = ИсходноеНаименование;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		Менеджер.Удалить();
	КонецЕсли;
	ИсходноеНаименование = ТекущийОбъект.НаименованиеНабора;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Модифицированность = Ложь;
	Закрыть(Запись.НаименованиеНабора);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьНабор(Команда)
	Записать();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьНабор(Команда)
	Модифицированность = Ложь;
	Закрыть();
КонецПроцедуры

#КонецОбласти
