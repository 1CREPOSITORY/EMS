#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.ОбластьДействия
			= Перечисления.EMS_ОбластиДействияПолейСверки.ОбъектМетаданных Тогда
			Если Не ЗначениеЗаполнено(Запись.ОбъектМетаданных) Тогда
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю(
					"Для области действия «Объект метаданных» необходимо выбрать объект метаданных.");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ЕстьДругаяОбщаяНастройка(Запись) Тогда
			Отказ = Истина;
			ТекстОшибки = СтрШаблон(
				"Для базы «%1» и типа метаданных «%2» уже существует общая настройка полей сверки.",
				Запись.База, Запись.ТипМетаданных);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЕстьДругаяОбщаяНастройка(Запись)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Поля.ОбластьДействия КАК ОбластьДействия,
	|	Поля.ОбъектМетаданных КАК ОбъектМетаданных
	|ИЗ
	|	РегистрСведений.EMS_ПоляСверкиПоТипамМетаданных КАК Поля
	|ГДЕ
	|	Поля.База = &База
	|	И Поля.ТипМетаданных = &ТипМетаданных";
	Запрос.УстановитьПараметр("База", Запись.База);
	Запрос.УстановитьПараметр("ТипМетаданных", Запись.ТипМетаданных);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОбластьДействия
			= Перечисления.EMS_ОбластиДействияПолейСверки.ОбъектМетаданных Тогда
			Продолжить;
		КонецЕсли;
		Если Выборка.ОбъектМетаданных = Запись.ОбъектМетаданных
			И (Выборка.ОбластьДействия = Запись.ОбластьДействия
				Или Не ЗначениеЗаполнено(Выборка.ОбластьДействия)) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
