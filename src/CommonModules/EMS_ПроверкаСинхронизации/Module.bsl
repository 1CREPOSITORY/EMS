Функция ВыполнитьОбменДаннымиZВНижнейБазе(Знач ПараметрыБазы)
	Соединение = ПолучитьПодключениеHTTPСервер(ПараметрыБазы);
	Если Соединение = Неопределено Тогда
		Возврат РезультатЗапускаОбменаДаннымиZ(
			Ложь, "", "Не удалось установить соединение с нижней базой.");
	КонецЕсли;
	ДанныеЗапроса = Новый Структура("НаименованиеУзлаИБ", ПараметрыБазы.НаименованиеУзлаИБ);
	ПутьНаСервере = СтрШаблон("%1/hs/sverka/V1/run-exchange", ПараметрыБазы.WSИмяБазы);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	Запрос = Новый HTTPЗапрос(ПутьНаСервере, Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		JSON(ДанныеЗапроса, Ложь), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат РезультатЗапускаОбменаДаннымиZ(Ложь, "", ТекстОшибки);
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОшибки = СтрШаблон("Код ответа нижней базы: %1", Ответ.КодСостояния);
		Возврат РезультатЗапускаОбменаДаннымиZ(Ложь, "", ТекстОшибки);
	КонецЕсли;
	Попытка
		ДанныеОтвета = unJSON(Ответ.ПолучитьТелоКакСтроку());
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка разбора ответа нижней базы: %1", ОписаниеОшибки());
		Возврат РезультатЗапускаОбменаДаннымиZ(Ложь, "", ТекстОшибки);
	КонецПопытки;
	Успех = Ложь;
	Сообщение = "";
	ТекстОшибки = "";
	ДанныеОтвета.Свойство("Успех", Успех);
	ДанныеОтвета.Свойство("Сообщение", Сообщение);
	ДанныеОтвета.Свойство("ТекстОшибки", ТекстОшибки);
	Если Не Успех И Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТекстОшибки = "Нижняя база вернула неуспешный результат без текста ошибки.";
	КонецЕсли;
	Возврат РезультатЗапускаОбменаДаннымиZ(Успех, Сообщение, ТекстОшибки);
КонецФункции

 Функция ЗапросКБазеПриемнику(ДанныеБазы, ИмяКоманды, ДанныеЗапроса, ПутьНаСервере)
	 База = ДанныеБазы.База;
	 ПутьНаСервере = База.WSИмяБазы + "/hs/sverka/V1/Обороты";
	 //Соединение = ПолучитьПодключениеHTTPСервер(База);
	 
	 Заголовки = Новый Соответствие;
	 Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	 
	 Запрос = Новый HTTPЗапрос(ПутьНаСервере, Заголовки);
	 Запрос.УстановитьТелоИзСтроки(JSON(ДанныеЗапроса, Ложь), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);   
	 
	 Ответ = ДанныеБазы.Соединение.ОтправитьДляОбработки(Запрос);	
	 Если Ответ.КодСостояния = 200 Тогда
		 
		 ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
		 
		 Попытка
			 ДанныеОтвета = unJSON(ТекстОтвета);
		 Исключение        
			 Коммментарий = СтрШаблон("Ошибка получения структуры из json. Причина: %1%2Данные ответа: %3", 
			 	ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, ДанныеОтвета);
			 ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. Разбор JSON'", ОбщегоНазначения.КодОсновногоЯзыка()),
			 УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий); 
			 ВызватьИсключение;
		 КонецПопытки;
		 
		 Возврат ДанныеОтвета;
		 
	 ИначеЕсли Ответ.КодСостояния = 302 или Ответ.КодСостояния = 301 Тогда 
		 НовыйАдрес = Ответ.Заголовки.Получить("Location"); 
	 Иначе        
		 Коммментарий = СтрШаблон("Не удалось выполнить запрос веб-сервиса. Код ответа: %1", Ответ.КодСостояния);
		 ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. Код состояния'", ОбщегоНазначения.КодОсновногоЯзыка()),
		 УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);   
		ВызватьИсключение("Не удалось выполнить запрос веб-сервиса.");
	 КонецЕсли;
	 
КонецФункции

Функция JSON(Данные, СОтступами = Истина)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	Если СОтступами Тогда
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(, "	");
	Иначе
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	КонецЕсли;
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Результат = ЗаписьJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция unJSON(JSONСтрока)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONСтрока);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПодключениеHTTPСервер(База)  

	Попытка
		//ssl = Новый ЗащищенноеСоединениеOpenSSL();
		//Соединение = Новый HTTPСоединение(База.WSИмяСервера, , База.WSИмяПользователя, База.WSПароль, , , ssl);
		Соединение = Новый HTTPСоединение(База.WSИмяСервера, , База.WSИмяПользователя, База.WSПароль);	
	Исключение 
		Коммментарий = СтрШаблон("Ошибка получения http соединения с базой. Причина: %1", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. ПолучитьПодключениеHTTPСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);  
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции
#КонецОбласти  

#Область ПреобразованияСтрок
 	
Функция СтрокаПустогоЗначения(Знач Тип) 
	Возврат ЗначениеВСтрокуВнутр(ПустоеЗначение(Тип));
КонецФункции

Функция ПустоеЗначение(Знач Тип) 
	Если Тип =  "DocumentRef.Трансляция" или Тип = "DocumentRef.ТрансформационнаяКорректировка" Тогда
	 	Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Тип) = Тип("Строка") Тогда
		ТипСтр = Тип;
		Тип = Тип(Тип);
	Иначе 
		ТипСтр = XMLТип(Тип).ИмяТипа;
	КонецЕсли;
	
	ТипСтр = СтрРазделить(ТипСтр, ".")[0];
	
	Если      ТипСтр = "EnumRef" Тогда
		Возврат XMLЗначение(Тип, "");
	Иначе
		Возврат XMLЗначение(Тип, "00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Процедура СтрокаВнутрАнализ(СтрВн, Смв = "", Тип = "", Код = "", УИД = "")
	Смв = ""; Тип = ""; Код = ""; УИД = "";
	
	мСтр = СтрРазделить(Сред(СтрВн, 2, СтрДлина(СтрВн) - 2), ",", Истина);
	КолВо = мСтр.Количество();
	
	Смв = Сред(мСтр[0], 2, 1);
	
	Если КолВо < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Тип = мСтр[1];
	
	Если КолВо < 3 Тогда
		Возврат;
	КонецЕсли;
	
	мКодУИД = СтрРазделить(мСтр[2], ":", Истина);
	Код = мКодУИД[0];
	УИД = мКодУИД[1];
КонецПроцедуры

Функция СтрокаВнутрСинтез(Смв, Тип, Код, УИД)
	Возврат "{"
		+ """" + Смв + """" + ","
		+ Тип + ","
		+ Код + ":"
		+ УИД
		+ "}"
	;
КонецФункции

Функция СтрТипЗнч(ЗнчСтр) 
	Знч = ЗначениеИзСтрокиВнутр(ЗнчСтр);
	Тип = ТипЗнч(Знч);
	Возврат XMLТип(Тип).ИмяТипа;
КонецФункции
#КонецОбласти 

#Область АдаптацияДанных
Функция АдаптироватьHTTP(Знач Зн, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, АдаптироватьHTTP(Стр.Значение, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;
		
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(АдаптироватьHTTP(Стр, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;
		
	Иначе
		Рез = Зн;
		Смв = ""; ТипУИД = ""; КодУИД = ""; УИД = "";
		СтрокаВнутрАнализ(Рез, Смв, ТипУИД, КодУИД, УИД);
		
		Если Смв = "#" И УИД <> "" Тогда 
			Пустое = Типы.Получить(ТипУИД);
			Если Пустое = Неопределено Тогда
				тТипСтр = мТипы.Получить(ТипУИД); 
				Пустое = СтрокаПустогоЗначения(тТипСтр);
				Типы.Вставить(ТипУИД, Пустое);
			КонецЕсли;
			
			СтрокаВнутрАнализ(Пустое,, ТипУИД, КодУИД, );
			
			Рез = СтрокаВнутрСинтез(Смв, ТипУИД, КодУИД, УИД);   
			
			Если НаружуИстинаВнутрьЛожь = Истина И СоответствияОбъектов <> Неопределено Тогда
				Соо = СоответствияОбъектов.Получить(Рез);
				Если Соо <> Неопределено Тогда
					Рез = Соо;
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция СтуктураВИзСтрокиВнутр(Зн, ВИстинаИзЛожь)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, СтуктураВИзСтрокиВнутр(Стр.Значение, ВИстинаИзЛожь));
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(СтуктураВИзСтрокиВнутр(Стр, ВИстинаИзЛожь));
		КонецЦикла;
	Иначе
		Рез = ?(ВИстинаИзЛожь, ЗначениеВСтрокуВнутр(Зн), ЗначениеИзСтрокиВнутр(Зн));
	КонецЕсли;
	Возврат Рез;
КонецФункции  

Функция СтуктураВИзСтрокиВнутрНорм(Зн)
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Для Каждого мСтр Из Стр Цикл
				Если мСтр = "{""B"",0}" Тогда
					Продолжить;	
				КонецЕсли;
				Рез.Добавить(ЗначениеИзСтрокиВнутр(мСтр));	
			КонецЦикла;
			
		КонецЦикла;
	Возврат Рез;
КонецФункции

#КонецОбласти

#Область СравнениеКлючей

Функция ПолучитьПолноеИмяМетаданныхДляРегистрации(Тип, Вид)
	Префикс = "";
	Если Тип = "Справочники" Тогда
		Префикс = "Catalog";
	ИначеЕсли Тип = "Документы" Тогда
		Префикс = "Document";
	ИначеЕсли Тип = "РегистрыСведений" Тогда
		Префикс = "InformationRegister";
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		Префикс = "AccumulationRegister";
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		Префикс = "ChartOfCharacteristicTypes";
	ИначеЕсли Тип = "Последовательности" Тогда
		Префикс = "Sequence";
	ИначеЕсли Тип = "РегистрыРасчета" Тогда
		Префикс = "AccountingRegister";
	Иначе
		Возврат "";
	КонецЕсли;
	Возврат Префикс + "." + Вид;
КонецФункции

Функция ПолучитьВидДанныхДляРегистрации(Тип)
	Если Тип = "Справочники" Тогда
		Возврат "Catalog";
	ИначеЕсли Тип = "Документы" Тогда
		Возврат "Document";
	ИначеЕсли Тип = "РегистрыСведений" Тогда
		Возврат "InformationRegister";
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		Возврат "AccumulationRegister";
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		Возврат "ChartOfCharacteristicTypes";
	ИначеЕсли Тип = "Последовательности" Тогда
		Возврат "Sequence";
	ИначеЕсли Тип = "РегистрыРасчета" Тогда
		Возврат "AccountingRegister";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ПостроитьКлючРегистрацииОтборJSON(Поля, мСтр)
	Если Поля = Неопределено Или Поля.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	СтруктураКлюча = Новый Структура;
	КолПоля = Поля.Количество();
	КолСтр = мСтр.Количество();
	Для Сч = 0 По Мин(КолПоля, КолСтр) - 1 Цикл
		ИмяПоля = Поля[Сч];
		ЗначСтр = мСтр[Сч];
		Если ТипЗнч(ЗначСтр) = Тип("Строка") Тогда
			СтруктураКлюча.Вставить(ИмяПоля, ЗначСтр);
		Иначе
			СтруктураКлюча.Вставить(ИмяПоля, Строка(ЗначСтр));
		КонецЕсли;
	КонецЦикла;
	Возврат JSON(СтруктураКлюча, Ложь);
КонецФункции
 
Функция ПолучитьРазницуПоКлючам(
	соЛокал, соВнешн, Индекс, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, Поля = Неопределено,
	соВнешнИсходные = Неопределено)
	Если ДанныеБазы.Отладка Тогда
		Сообщить("Л " + соЛокал.Количество() + ", В " + соВнешн.Количество()); 
	КонецЕсли;
	соРазница = Новый Соответствие;
	мКлючЗаписиРС = Новый Массив;
	Для Каждого Стр Из соВнешн Цикл
		Если соЛокал.Получить(Стр.Ключ) = Неопределено Тогда
			мСтр = Стр.Значение;
			мСтрКлючРегистрации = СтрокаКлючаРегистрации(мСтр, соВнешнИсходные, Стр.Ключ);
			СтрокаНабора = НаборЗаписейСообщений.Добавить();
			СтрокаНабора.Дата = ТекущаяДатаСеанса();
			СтрокаНабора.База = ДанныеБазы.База.Ссылка;
			СтрокаНабора.Вид = ОбъектМетаданных.Вид;
			СтрокаНабора.Тип = ОбъектМетаданных.Тип;
			СтрокаНабора.Сообщение = СообщитьМассивСтрокуЗн(мСтр, "В<Л", ДанныеБазы.Отладка);
			КлючРегистрацииОтборJSON = ПостроитьКлючРегистрацииОтборJSON(Поля, мСтрКлючРегистрации);
			СтрокаНабора.ДанныеВнешнейБазы = КлючРегистрацииОтборJSON;
			СтрокаНабора.ПолноеИмяМетаданных = ПолучитьПолноеИмяМетаданныхДляРегистрации(ОбъектМетаданных.Тип, ОбъектМетаданных.Вид);
			СтрокаНабора.ВидДанныхДляРегистрации = ПолучитьВидДанныхДляРегистрации(ОбъектМетаданных.Тип);
			СтрокаНабора.КлючРегистрацииОтбор = КлючРегистрацииОтборJSON;
			СтрокаНабора.КлючСтроки = Строка(Новый УникальныйИдентификатор);
			Если Индекс = Неопределено Тогда
				мКлючЗаписиРС.Добавить(Стр.Значение);      
			Иначе 
				соРазница.Вставить(мСтр[Индекс]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Рез = Новый Массив;
	Для Каждого Стр Из соРазница Цикл
		мСтр = Новый Массив;
		мСтр.Добавить(Стр.Ключ);
		Рез.Добавить(мСтр);
	КонецЦикла; 
	
	Если мКлючЗаписиРС.Количество()>0   Тогда
		 Возврат мКлючЗаписиРС;
	КонецЕсли;
	Если ДанныеБазы.Отладка Тогда
		Сообщить("Разниц: " + Рез.Количество());
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция СтрокаКлючаРегистрации(Знач мСтр, Знач соВнешнИсходные, Знач Ключ)
	Если соВнешнИсходные = Неопределено Тогда
		Возврат мСтр;
	КонецЕсли;
	мСтрИсходная = соВнешнИсходные.Получить(Ключ);
	Если мСтрИсходная = Неопределено Тогда
		Возврат мСтр;
	КонецЕсли;
	Возврат мСтрИсходная;
КонецФункции

Функция ПолучитьИсходныеСтрокиПоАдаптированнымКлючам(АдаптированныеСтроки, ИсходныеСтроки, ИнС = Неопределено)
	соИсходныеСтроки = Новый Соответствие;
	Если ИсходныеСтроки = Неопределено Тогда
		Возврат соИсходныеСтроки;
	КонецЕсли;
	Для ИндексСтроки = 0 По АдаптированныеСтроки.Количество() - 1 Цикл
		Если ИндексСтроки >= ИсходныеСтроки.Количество() Тогда
			Прервать;
		КонецЕсли;
		Ключ = КлючСтрокиСверки(АдаптированныеСтроки[ИндексСтроки], ИнС);
		соИсходныеСтроки.Вставить(Ключ, ИсходныеСтроки[ИндексСтроки]);
	КонецЦикла;
	Возврат соИсходныеСтроки;
КонецФункции

Функция СообщитьМассивСтрокуЗн(Знач мСтр, Пре, Отладка)
	Сооб = "";
	Сооб = Пре + "|";
	Для Каждого Стр Из мСтр Цикл
		Зн = ЗначениеИзСтрокиВнутр(Стр);
				
		Сооб = Сооб
			+ Зн  + ","
			+ "|"
		;
	КонецЦикла;  
	Если Отладка Тогда
		Сообщить(Сооб);
	КонецЕсли;
	Возврат Сооб;
КонецФункции

Функция ПолучитьКлючиСтр(Внешн, ИнС = Неопределено) 
	соВнешн = Новый Соответствие;
	Для Каждого Стр Из Внешн Цикл
		соВнешн.Вставить(КлючСтрокиСверки(Стр, ИнС), Стр);
	КонецЦикла;
	
	Возврат соВнешн;
КонецФункции

Функция КлючСтрокиСверки(Стр, ИнС = Неопределено)
	Ключ = "";   
	сч = 0;
	Для Каждого Зн Из Стр Цикл  
		Если  ИнС = сч Тогда
			Продолжить;	
		КонецЕсли;
		Ключ = Ключ + Зн + ","; 
		сч = сч +1;
	КонецЦикла;
	Возврат Ключ;
КонецФункции
#КонецОбласти    

#Область МетаданныеЗапросы
 
Функция ОбъектыВыборкаОтбор(ОбъектМетаданных) 
	
	Рез = Новый Структура("Тип, Вид", ОбъектМетаданных.Тип, ОбъектМетаданных.Вид);
	
	Если ОбъектМетаданных.Тип = "Справочники" Тогда
		ТипЗапрос = "Справочник";
	ИначеЕсли ОбъектМетаданных.Тип = "Документы" Тогда
		ТипЗапрос = "Документ";
	ИначеЕсли ОбъектМетаданных.Тип = "РегистрыСведений" Тогда
		ТипЗапрос = "РегистрСведений";
	ИначеЕсли ОбъектМетаданных.Тип = "РегистрыНакопления" Тогда
		ТипЗапрос = "РегистрНакопления";
	ИначеЕсли ОбъектМетаданных.Тип = "ПланыВидовХарактеристик" Тогда
		ТипЗапрос = "ПланВидовХарактеристик";
	ИначеЕсли ОбъектМетаданных.Тип = "Последовательности" Тогда
		ТипЗапрос = "Последовательность";
	КонецЕсли;
	
	мИзмерения = ПолучитьПоляДляСверки(ОбъектМетаданных);
	Рез.Вставить("Поля", мИзмерения);
	
	ЗапросТекст = 
		"ВЫБРАТЬ 
		|	" + СтрСоединить(мИзмерения, ", ") + "
		|ИЗ
		|	" + ТипЗапрос + "." + ОбъектМетаданных.Вид + "  
		|";
	
	//Если Не мИзмерения.Найти("УникальныйИдентификатор") = Неопределено Тогда
	//	ЗапросТекст = СтрЗаменить(ЗапросТекст, "УникальныйИдентификатор", "УникальныйИдентификатор(Ссылка) Как УникальныйИдентификатор");	
	//КонецЕсли;
	ЗапросПараметры = Новый Структура;
	ЗапросТекст = ЗапросТекст + ЗапросУсловие(ОбъектМетаданных);
	
	Рез.Вставить("мИзмерения", мИзмерения);
	Рез.Вставить("ЗапросТекст", ЗапросТекст);
	Возврат Рез;
КонецФункции    

Функция ПолучитьПоляДляСверки(ОбъектМетаданных)
	Если ЗначениеЗаполнено(ОбъектМетаданных.ОсновныеПоляДляСверки) Тогда
		Возврат ПоляДляСверкиИзСтроки(ОбъектМетаданных.ОсновныеПоляДляСверки);
	КонецЕсли;
	мИзмерения = МДИзмерения(ОбъектМетаданных.Тип, ОбъектМетаданных.Вид);
	Если Не ЗначениеЗаполнено(ОбъектМетаданных.ДополнительныеПоляДляСверки) Тогда
		Возврат мИзмерения;
	КонецЕсли;
	ДополнительныеПоля = ПоляДляСверкиИзСтроки(ОбъектМетаданных.ДополнительныеПоляДляСверки);
	Для Каждого ДополнительноеПоле Из ДополнительныеПоля Цикл
		Если мИзмерения.Найти(ДополнительноеПоле) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		мИзмерения.Добавить(ДополнительноеПоле);
	КонецЦикла;
	Возврат мИзмерения;
КонецФункции

Функция ПоляДляСверкиИзСтроки(СтрокаПолей)
	Поля = Новый Массив;
	СтрокаПолей = СтрЗаменить(СтрокаПолей, Символы.ПС, ",");
	СтрокаПолей = СтрЗаменить(СтрокаПолей, ";", ",");
	СтрокаПолей = СтрЗаменить(СтрокаПолей, Символы.Таб, "");
	ИсходныеПоля = СтрРазделить(СтрокаПолей, ",", Ложь);
	Для Каждого Поле Из ИсходныеПоля Цикл
		Поле = СокрЛП(Поле);
		Если ПустаяСтрока(Поле) Тогда
			Продолжить;
		КонецЕсли;
		Если Поля.Найти(Поле) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поля.Добавить(Поле);
	КонецЦикла;
	Возврат Поля;
КонецФункции

Функция МДИзмерения(Тип, Вид, ВыборкаПроведенные = Ложь, ПометкаУдаления = Истина)

	мИзмерения = Новый Массив;
	
	Если      Тип = "Константы" Тогда
	ИначеЕсли Тип = "Справочники" Или Тип = "Документы" Или Тип = "ПланыВидовХарактеристик" Тогда
		
		мИзмерения.Добавить("Ссылка"); 
		Если Тип = "Документы"  Тогда
			Если  ВыборкаПроведенные Тогда
			КонецЕсли;
		КонецЕсли;
		
		Если Тип = "Справочники" Тогда 
		КонецЕсли;
		
	ИначеЕсли Тип = "РегистрыСведений" Тогда
			МД = Метаданные[Тип][Вид];
			Независимый = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		
		Для Каждого ТекИзм Из МД.Измерения Цикл
			Если Тип = "РегистрыСведений" И Не ТекИзм.ОсновнойОтбор Тогда
				Продолжить;
			КонецЕсли;
			мИзмерения.Добавить(ТекИзм.Имя);
		КонецЦикла;
		
		Если Тип = "РегистрыСведений" Тогда
			Если Не МД.РежимЗаписи = Независимый Тогда
				мИзмерения.Добавить("Регистратор");
			КонецЕсли;
			Если МД.ПериодичностьРегистраСведений <> Непериодический Тогда
				мИзмерения.Добавить("Период");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		мИзмерения.Добавить("Регистратор");
		
	ИначеЕсли Тип = "Последовательности" Тогда
		мИзмерения.Добавить("Организация"); 
		мИзмерения.Добавить("Регистратор");
		мИзмерения.Добавить("Период");
		мИзмерения.Добавить("МоментВремени");
		мИзмерения.Добавить("СостояниеПроведения");
		
	КонецЕсли;

	Возврат мИзмерения;
КонецФункции

Функция ЗапросУсловие(ОбъектМетаданных)
	мУсловие = Новый Массив;	
	Если ЗначениеЗаполнено(ОбъектМетаданных.ПолеОрганизации) Тогда
		 мУсловие.Добавить(СтрШаблон("%1 = &Организация", ОбъектМетаданных.ПолеОрганизации));
	КонецЕсли;	
	Если мУсловие.Количество() = 0 Тогда 
		//Возврат ?(ОбъектМетаданных.Тип = "Справочники", "ГДЕ" + Символы.ПС + "Наименование = ""Сафонов Алексей Викторович""", "")		
		Возврат "";
	КонецЕсли;
	Возврат " "
			+ "ГДЕ" + Символы.ПС
			+ СтрСоединить(мУсловие, Символы.ПС + "И ") 
			//+ ?(ОбъектМетаданных.Тип = "Справочники", Символы.ПС + "И Наименование = ""Сафонов Алексей Викторович""", "")
			+ Символы.ПС;
КонецФункции

Функция ПолучитьШаблонЗапроса(СчетКод, ВариантаШаблона)
	
	Шаблон = "ВЫБРАТЬ
	|	Начисления.Регистратор КАК Регистратор,
	|	Начисления.Сотрудник КАК Сотрудник,
	|	Начисления.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Начисления.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	Начисления.СторноТекущегоПериода КАК СторноТекущегоПериода,
	|	Начисления.Результат КАК Результат
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|	&Условие";
	Возврат Шаблон; 
	
КонецФункции
#КонецОбласти

#Область ОбработкаВыборок
  Процедура МассивИзВыборки(Выб, ДанныеБазы, ИзВнутр = Истина)

	Кол = Выб.Поля.Количество();
	Тип = Выб.Тип; Вид = Выб.Вид;
	Измерения = Выб.Поля;
	сИзмерения = СтрСоединить(Измерения, ",");
	Отбор = Новый Структура(сИзмерения);
	
	Поля = Новый Соответствие; Сч = 0;
	Для Каждого Поле Из Поля Цикл
		Поля.Вставить(Поле, Сч);
		Сч = Сч + 1;
	КонецЦикла;
	
	Если      Тип = "РегистрыСведений" Тогда
		Рег = РегистрыСведений;
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		Рег = РегистрыНакопления;
	КонецЕсли;
	
	Рез = Новый Массив;
	
	Для Каждого ТекСтр Из Выб.Выборка Цикл
		Если Тип = "Последовательности" Тогда
			Отбор = Новый Структура(сИзмерения);
		КонецЕсли;
		
		Флаг = Ложь;
		
		Для Сч = 0 По Кол - 1 Цикл
			Поле = ТекСтр[Сч];
			Если ИзВнутр Тогда
				Поле = ЗначениеИзСтрокиВнутр(Поле);  
				ПроверкаНаБитуюСсылку(Поле,Флаг, ДанныеБазы);
			КонецЕсли;
			
			Если Тип = "РегистрыСведений"
			 Или Тип = "РегистрыНакопления"
			 Или Тип = "Последовательности"
			Тогда
				Отбор[Измерения[Сч]] = Поле;
			Иначе
				Значение = Поле; 
			КонецЕсли;
		КонецЦикла;
		
		Если Тип = "РегистрыСведений"
		 Или Тип = "РегистрыНакопления"
		Тогда
			Значение = Рег[Вид].СоздатьКлючЗаписи(Отбор);
			Если Тип = "РегистрыСведений" И Вид = "РасчетПоказателейОтложенногоНалога" Тогда
				Значение = Отбор.Регистратор;
			КонецЕсли;
		ИначеЕсли Тип = "Последовательности" Тогда
			Значение = Отбор;
		КонецЕсли;
		
		Если Флаг Тогда
		
			Продолжить;	
		
		КонецЕсли;
		
		Рез.Добавить(Значение);
	КонецЦикла;
	
	Выб.Вставить("Результат", Рез);
КонецПроцедуры

Процедура ПроверкаНаБитуюСсылку(Поле, Флаг, ДанныеБазы) 
	  
	  Попытка
		  Стр = Строка(Поле); 
		  Если СтрНайти(Стр,"<Объект не найден>")>0 Тогда
			  Флаг =  Истина	
		  КонецЕсли;   
	  Исключение       
		  Коммментарий = СтрШаблон("Поле: %1, Флаг: %2, %3", Поле, Флаг, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		  ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. ПроверкаНаБитуюСсылку'", ОбщегоНазначения.КодОсновногоЯзыка()),
		  УровеньЖурналаРегистрации.Ошибка, , ДанныеБазы.База.Ссылка, Коммментарий);   
	  КонецПопытки;   
	  
  КонецПроцедуры
  

Процедура ОбъединитьРез(соРазница, Рез, Тип)
	
	Для каждого эл Из соРазница Цикл
		Если Тип = "РегистрыСведений"  Тогда
			Рез.Добавить(эл);	
		Иначе
			Если эл.ПолучитьОбъект() <> Неопределено Тогда 
				Рез.Добавить(эл);	                               
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЛокальныеЗапросы
Функция ВыполнитьЗапрос(ЗапросТекст, Поля, ЗапросПараметры, ДанныеБазы)
	База = ДанныеБазы.База;
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;
	Для Каждого ТекПар Из ЗапросПараметры Цикл
		Ключ = ТекПар.Ключ;
		Зн = ТекПар.Значение;
		
		Если Ключ = "Организация" И ТипЗнч(Зн) = Тип("Строка") Тогда 
			Зн = Орг(Зн);
		КонецЕсли;
		
		Запрос.УстановитьПараметр(Ключ, Зн);
	КонецЦикла;
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();	
	Исключение           
		Коммментарий = СтрШаблон("Ошибка выполнения запроса. Текст: %1%2Причина: %3", ЗапросТекст, Символы.ПС, 
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. ВыполнитьЗапрос'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);
	КонецПопытки;
	
	мРезультат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Массив;
		Для Каждого Изм Из Поля Цикл
			Зн = Выборка[Изм];
				Если ТипЗнч(Выборка[Изм]) = Тип("УникальныйИдентификатор") Тогда
					Зн1 = Строка(Выборка[Изм]);   
					Зн = ЗначениеВСтрокуВнутр(Зн1);
				Иначе 	
					Зн = ЗначениеВСтрокуВнутр(Зн);
				КонецЕсли;
				
			Стр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(Стр);
	КонецЦикла;
	
	Возврат мРезультат;
КонецФункции

Функция Орг(Знач ИД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	EMS_КодСопоставленияОрганизации.ГУИД КАК ГУИД
		|ИЗ
		|	РегистрСведений.EMS_КодСопоставленияОрганизации КАК EMS_КодСопоставленияОрганизации
		|ГДЕ
		|	EMS_КодСопоставленияОрганизации.Code = &Code";
	
	Запрос.УстановитьПараметр("Code", ИД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат XMLЗначение(Тип("CatalogRef.Организации"),ВыборкаДетальныеЗаписи.ГУИД); 
	КонецЦикла;
	
 	Возврат Неопределено; 
КонецФункции  

