Функция БазыДляСинхронизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	EMS_ПараметрыБаз.Proxy КАК Proxy,
		|	EMS_ПараметрыБаз.SSL КАК SSL,
		|	EMS_ПараметрыБаз.WSИмяБазы КАК WSИмяБазы,
		|	EMS_ПараметрыБаз.WSИмяСервера КАК WSИмяСервера,
		|	EMS_ПараметрыБаз.КодОрганизации КАК КодОрганизации,
		|	EMS_ПараметрыБаз.НаименованиеУзлаИБ КАК НаименованиеУзлаИБ,
		|	EMS_ПараметрыБаз.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.EMS_ПараметрыБаз КАК EMS_ПараметрыБаз
		|ГДЕ
		|	EMS_ПараметрыБаз.КодОрганизации <> """"
		|	И EMS_ПараметрыБаз.НаименованиеУзлаИБ <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Логин = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Логин");
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Пароль");
	Базы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		БазаДляСинхронизации = КонструкторСтруктурыБазыДляСинхронизации();
		ЗаполнитьЗначенияСвойств(БазаДляСинхронизации, Выборка);  
		БазаДляСинхронизации.WSИмяПользователя = Логин;
		БазаДляСинхронизации.WSПароль = Пароль;
		Базы.Добавить(БазаДляСинхронизации);
	КонецЦикла;
	Возврат Базы;	
КонецФункции                  

Функция КонструкторСтруктурыБазыДляСинхронизации()
	Возврат Новый Структура("Proxy, SSL, WSИмяБазы, WSИмяПользователя, WSИмяСервера, WSПароль, КодОрганизации, НаименованиеУзлаИБ, Ссылка");	
КонецФункции 

Функция СоответствияОбъектовБазы(База)
	
	// Уникальный идентификатор приемника это данные из НЗ
	Запрос = Новый Запрос;
	Запрос.Текст =   "ВЫБРАТЬ
	|	СоответствияОбъектовИнформационныхБаз.ТипИсточника КАК ТипИсточника,
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника КАК УникальныйИдентификаторПриемника,  
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой КАК УникальныйИдентификаторИсточника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы.Наименование = &НаименованиеУзлаИБ
	|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника <> СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой";
	//|И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой = &УникальныйИдентификаторИсточникаСтрокой";
	
	
	Запрос.УстановитьПараметр("НаименованиеУзлаИБ", База.НаименованиеУзлаИБ); 
	//Запрос.УстановитьПараметр("УникальныйИдентификаторИсточникаСтрокой", "71d7db53-34c8-11ed-8d68-b89a2ab8c2cb");

	Выборка = Запрос.Выполнить().Выбрать();
	мИзмерения = СтрРазделить("ТипИсточника, УникальныйИдентификаторПриемника, УникальныйИдентификаторИсточника", ", ", Ложь); 
	мРезультат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Массив;
		Для Каждого Изм Из мИзмерения Цикл
			Если ТипЗнч(Выборка[Изм]) = Тип("УникальныйИдентификатор") Тогда
				Зн = Строка(Выборка[Изм]);
				Стр.Добавить(ЗначениеВСтрокуВнутр(Зн));	
			Иначе 	
				Стр.Добавить(ЗначениеВСтрокуВнутр(Выборка[Изм]));
				
			КонецЕсли;
		КонецЦикла;
		мРезультат.Добавить(Стр);
	КонецЦикла; 
	
	Результат = Новый Массив;
	Для Каждого эл Из мРезультат Цикл
		Стр = Новый Массив;
		ТипСтр  =    ЗначениеИзСтрокиВнутр(эл[0]);
		СтрокаПриемник =   ЗначениеИзСтрокиВнутр(эл[1]);
		СтрокаПриемникВнутр = СтрокаИзУИД(ТипСтр, СтрокаПриемник);    
		Стр.Добавить(СтрокаПриемникВнутр); 
		СтрокаИсточник =   ЗначениеИзСтрокиВнутр(эл[2]);  
		СтрокаИсточникВнутр = СтрокаИзУИД(ТипСтр, СтрокаИсточник);    
		Стр.Добавить(СтрокаИсточникВнутр);
		Результат.Добавить(Стр);
	КонецЦикла;  
	
	СоответствияОбъектовИнформационныхБаз = Новый Структура("ВнешняяВЛокальную, ЛокальнаяВоВнешнюю", Новый Соответствие, Новый Соответствие);
	Для каждого мСтр Из Результат  Цикл		
		Внешн = мСтр[1];
		Локал = мСтр[0]; 
		
		СоответствияОбъектовИнформационныхБаз.ВнешняяВЛокальную.Вставить(Внешн, Локал);
		СоответствияОбъектовИнформационныхБаз.ЛокальнаяВоВнешнюю.Вставить(Локал, Внешн);
	КонецЦикла; 
	
	Возврат СоответствияОбъектовИнформационныхБаз;
	
КонецФункции

Функция СтрокаИзУИД(ТипСтр, УИД)
    Тип = Тип(ТипСтр);
    
    СтрПустое = ЗначениеВСтрокуВнутр(XMLЗначение(Тип, "00000000-0000-0000-0000-000000000000"));
    
    Стр = УИД;
    // 123456789012345678901234567890123456
    // 1435823d-b0b3-11ec-9871-0050568d2260
    // 98710050568d226011ecb0b31435823d
    Стр = ""
        + Сред(Стр, 20,  4)
        + Сред(Стр, 25, 12)
        + Сред(Стр, 15,  4)
        + Сред(Стр, 10,  4)
        + Сред(Стр,  1,  8)
    ;
    Стр = СтрЗаменить(СтрПустое, "00000000000000000000000000000000", Стр);
    
    Возврат Стр;
КонецФункции

