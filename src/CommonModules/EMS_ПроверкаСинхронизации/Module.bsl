	СообщениеОтладки("Массив (" + Выб.Количество() + ")");
КонецПроцедуры

Процедура Обороты(ДанныеБазы, НаборЗаписейСообщений)

	Подготовленные = Новый Массив;
	Для Каждого ОбъектМетаданных Из ДанныеБазы.ОбъектыМетаданных Цикл
		Если ДанныеБазы.Отладка Тогда
			СообщениеОтладки("=== Метаданные " + ОбъектМетаданных.Вид + " ===");
		КонецЕсли;
		Попытка
			Подготовленные.Добавить(ПодготовитьОборотОбъекта(ДанныеБазы, ОбъектМетаданных));
		Исключение
			ЗаписатьОшибкуОборотов(ДанныеБазы, ОбъектМетаданных, ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	ПакетДоступен = Истина;
	РазмерПакета = 8;
	Индекс = 0;
	Пока Индекс < Подготовленные.Количество() Цикл
		Если ПакетДоступен Тогда
			КонецПорции = Мин(Индекс + РазмерПакета, Подготовленные.Количество());
			Порция = Новый Массив;
			Пока Индекс < КонецПорции Цикл
				Порция.Добавить(Подготовленные[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;
			Ответы = РезультатПакетаОборотов(ДанныеБазы, Порция);
			Если Ответы = Неопределено Тогда
				ПакетДоступен = Ложь;
				Индекс = Индекс - Порция.Количество();
			Иначе
				Номер = 0;
				Для Каждого Подготовка Из Порция Цикл
					ЗавершитьПодготовленныйОборот(ДанныеБазы, Подготовка, Ответы[Номер], НаборЗаписейСообщений);
					Номер = Номер + 1;
				КонецЦикла;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Подготовка = Подготовленные[Индекс];
		ЗавершитьПодготовленныйОборот(ДанныеБазы, Подготовка, Неопределено, НаборЗаписейСообщений);
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

Функция ОборотыОбъект(ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений)

	Подготовка = ПодготовитьОборотОбъекта(ДанныеБазы, ОбъектМетаданных);
	РезультатВнешний = ВыполнитьЗапросВнешний(
		Подготовка.Текст, Подготовка.Поля, Подготовка.ЗапросПараметры, Истина, ДанныеБазы);
	Возврат ЗавершитьСверкуОборота(Подготовка, РезультатВнешний, ДанныеБазы, НаборЗаписейСообщений);

КонецФункции

Функция ПодготовитьОборотОбъекта(ДанныеБазы, ОбъектМетаданных)

	Рез = ОбъектыВыборкаОтбор(ОбъектМетаданных);
	Поля = Рез.мИзмерения;
	Текст = Рез.ЗапросТекст;

	ЗапросПараметры = Новый Структура("Организация", ДанныеБазы.База.КодОрганизации);
	Если Рез.Тип = "РегистрБухгалтерии" Или Рез.Тип = "РегистрНакопления" Или Рез.Тип = "РегистрыРасчета" Тогда
		ИнРег = Поля.Найти("Регистратор");
	Иначе
		ИнРег = Неопределено;
	КонецЕсли;

	Подготовка = Новый Структура;
	Подготовка.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	Подготовка.Вставить("Текст", Текст);
	Подготовка.Вставить("Поля", Поля);
	Подготовка.Вставить("ЗапросПараметры", ЗапросПараметры);
	Подготовка.Вставить("ИнРег", ИнРег);
	Подготовка.Вставить("Рез", Рез);
	Подготовка.Вставить("Локал", ВыполнитьЗапрос(Текст, Поля, ЗапросПараметры, ДанныеБазы));
	Возврат Подготовка;

КонецФункции

Функция ЗавершитьСверкуОборота(Подготовка, РезультатВнешний, ДанныеБазы, НаборЗаписейСообщений)

	ОбъектМетаданных = Подготовка.ОбъектМетаданных;
	Поля = Подготовка.Поля;
	ИнРег = Подготовка.ИнРег;
	Рез = Подготовка.Рез;
	Внешн = РезультатВнешний.Строки;
	ИндексыКлюча = ИндексыКлючаСверки(Поля, Рез);
	соЛокал = ПолучитьКлючиСтр(Подготовка.Локал, ИндексыКлюча);
	соВнешн = ПолучитьКлючиСтр(Внешн, ИндексыКлюча);
	СырыеПоКлючу = СырыеСтрокиПоКлючу(Внешн, РезультатВнешний.Сырые, ИндексыКлюча);
	ПоляКонтроля = Неопределено;
	ПоляКлюча = Неопределено;
	Если Рез.Свойство("ПоляКонтроля") Тогда
		ПоляКонтроля = Рез.ПоляКонтроля;
	КонецЕсли;
	Если Рез.Свойство("ПоляКлюча") Тогда
		ПоляКлюча = Рез.ПоляКлюча;
	КонецЕсли;
	Выборка = ПолучитьРазницуПоКлючам(
		соЛокал, соВнешн, ИнРег, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений,
		Поля, СырыеПоКлючу, ПоляКонтроля, ПоляКлюча);
	Если ИнРег = Неопределено
		И Рез.Свойство("ПроецироватьРезультат")
		И Рез.ПроецироватьРезультат
		И Рез.Поля.Количество() > 0 Тогда
		Выборка = СтрокиПоИндексам(Выборка, ИндексыПолей(Поля, Рез.Поля));
	КонецЕсли;
	Если Рез.Тип = "Справочники" Или Рез.Тип = "Документы" Или ИнРег <> Неопределено Тогда
		соРазница = СтуктураВИзСтрокиВнутрНорм(Выборка);
	Иначе
		соРазница = Выборка;
	КонецЕсли;

	Если ИнРег = Неопределено И Рез.Тип = "РегистрыСведений" И ДанныеБазы.Отладка Тогда
		Рез.Вставить("Выборка", соРазница);
		МассивИзВыборки(Рез, ДанныеБазы);
		Возврат Рез.Результат;
	КонецЕсли;

	Возврат соРазница;

КонецФункции

Процедура ЗавершитьПодготовленныйОборот(ДанныеБазы, Подготовка, ОтветПакета, НаборЗаписейСообщений)

	ОбъектМетаданных = Подготовка.ОбъектМетаданных;
	Попытка
		Если ОтветПакета = Неопределено Тогда
			РезультатВнешний = ВыполнитьЗапросВнешний(
				Подготовка.Текст, Подготовка.Поля, Подготовка.ЗапросПараметры, Истина, ДанныеБазы);
		ИначеЕсли СвойствоОтвета(ОтветПакета, "Успех") <> Истина Тогда
			ВызватьИсключение Строка(СвойствоОтвета(ОтветПакета, "ТекстОшибки"));
		Иначе
			РезультатВнешний = РезультатВнешнийИзПакета(ОтветПакета, ДанныеБазы);
		КонецЕсли;
		соРазница = ЗавершитьСверкуОборота(Подготовка, РезультатВнешний, ДанныеБазы, НаборЗаписейСообщений);
		Если ДанныеБазы.Отладка Тогда
			РезОтладки = Новый Массив;
			ОбъединитьРез(соРазница, РезОтладки, ОбъектМетаданных.Тип);
			СообщитьМассив(РезОтладки);
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуОборотов(ДанныеБазы, ОбъектМетаданных, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Функция РезультатПакетаОборотов(ДанныеБазы, Порция)

	Запросы = Новый Массив;
	Для Каждого Подготовка Из Порция Цикл
		ЭлементЗапроса = Новый Структура;
		ЭлементЗапроса.Вставить("ЗапросТекст", Подготовка.Текст);
		ЭлементЗапроса.Вставить("ЗапросПараметры", ПараметрыЗапросаДляНижнейБазы(Подготовка.ЗапросПараметры));
		ЭлементЗапроса.Вставить("Поля", Подготовка.Поля);
		Запросы.Добавить(ЭлементЗапроса);
	КонецЦикла;

	Попытка
		Ответ = ЗапросКБазеПриемнику(
			ДанныеБазы,
			"",
			Новый Структура("Запросы", Запросы),
			ДанныеБазы.База.WSИмяБазы + "/hs/sverka/V1/ПакетОборотов");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Массив") Или Ответ.Количество() <> Порция.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Порция.Количество() > 0 И СвойствоОтвета(Ответ[0], "Успех") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция РезультатВнешнийИзПакета(ОтветПакета, ДанныеБазы)

	СтрокиОтвета = СвойствоОтвета(ОтветПакета, "Строки");
	ТипыОтвета = СвойствоОтвета(ОтветПакета, "Типы");
	Если ТипЗнч(СтрокиОтвета) <> Тип("Массив") Тогда
		СтрокиОтвета = Новый Массив;
	КонецЕсли;
	мТипы = Новый Соответствие;
	Если ТипЗнч(ТипыОтвета) = Тип("Массив") Тогда
		Для Каждого СтрокаТипа Из ТипыОтвета Цикл
			Если ТипЗнч(СтрокаТипа) = Тип("Массив") И СтрокаТипа.Количество() > 1 Тогда
				мТипы.Вставить(СтрокаТипа[0], СтрокаТипа[1]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Строки = АдаптироватьHTTP(СтрокиОтвета, Ложь, ДанныеБазы.СоответсвиеОбъектов.ЛокальнаяВоВнешнюю, ДанныеБазы.КэшТипы.Внутрь, мТипы);
	Возврат Новый Структура("Строки, Сырые", Строки, СтрокиОтвета);

КонецФункции

Функция ПараметрыЗапросаДляНижнейБазы(ЗапросПараметры)

	ПараметрыДляHTTP = Новый Структура;
	Для Каждого ТекПар Из ЗапросПараметры Цикл
		Зн = ТекПар.Значение;
		Если ТекПар.Ключ = "Организация" И ТипЗнч(Зн) = Тип("Строка") Тогда
			Зн = ОбменДаннымиПереопределяемый.ИдентификаторОрганизацииДляВнешнегоЗапроса(Зн);
		КонецЕсли;
		ПараметрыДляHTTP.Вставить(ТекПар.Ключ, Зн);
	КонецЦикла;
	Возврат ПараметрыДляHTTP;

КонецФункции

Процедура ЗаписатьОшибкуОборотов(ДанныеБазы, ОбъектМетаданных, Информация)

	Комментарий = СтрШаблон(
		"Объект: %1.%2%3%4",
		ОбъектМетаданных.Тип,
		ОбъектМетаданных.Вид,
		Символы.ПС,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Проверка синхронизации данных. Обороты'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,
		,
		ДанныеБазы.База.Ссылка,
		Комментарий);

КонецПроцедуры

Функция ПолучитьРезультат(Текст, Поля, ЗапросПараметры, Индекс, Рез, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений)
 
	Локал = ВыполнитьЗапрос(Текст, Поля, ЗапросПараметры, ДанныеБазы);
	РезультатВнешний = ВыполнитьЗапросВнешний(Текст, Поля, ЗапросПараметры, Истина, ДанныеБазы);
	Внешн = РезультатВнешний.Строки;
	
	ИндексыКлюча = ИндексыКлючаСверки(Поля, Рез);
	соЛокал = ПолучитьКлючиСтр(Локал, ИндексыКлюча);
	соВнешн = ПолучитьКлючиСтр(Внешн, ИндексыКлюча);
	СырыеПоКлючу = СырыеСтрокиПоКлючу(Внешн, РезультатВнешний.Сырые, ИндексыКлюча);
	ПоляКонтроля = Неопределено;
	ПоляКлюча = Неопределено;
	Если Рез.Свойство("ПоляКонтроля") Тогда
		ПоляКонтроля = Рез.ПоляКонтроля;
	КонецЕсли;
	Если Рез.Свойство("ПоляКлюча") Тогда
		ПоляКлюча = Рез.ПоляКлюча;
	КонецЕсли;
	Выборка = ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Индекс, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, Поля, СырыеПоКлючу, ПоляКонтроля, ПоляКлюча);
	Если Индекс = Неопределено
		И Рез.Свойство("ПроецироватьРезультат")
		И Рез.ПроецироватьРезультат
		И Рез.Поля.Количество() > 0 Тогда
		Выборка = СтрокиПоИндексам(Выборка, ИндексыПолей(Поля, Рез.Поля));
	КонецЕсли;
	Если Рез.Тип = "Справочники" или Рез.Тип = "Документы" или  Индекс <> Неопределено Тогда
		Возврат СтуктураВИзСтрокиВнутрНорм(Выборка);
	Иначе 
		Возврат Выборка;	
	КонецЕсли;
		
КонецФункции

Функция ВыполнитьЗапросВнешний(ЗапросТекст, Поля, ЗапросПараметры, АдаптироватьПоСоответствиям, ДанныеБазы)
	
	ЗапросПараметрыВнешний = СтуктураВИзСтрокиВнутр(ЗапросПараметры, Истина);
	
	ПараметрыДляHTTP = ПараметрыЗапросаДляНижнейБазы(ЗапросПараметры);

	ДанныеЗапроса = Новый Структура();
	ДанныеЗапроса.Вставить("ЗапросПараметры", ПараметрыДляHTTP);
	ДанныеЗапроса.Вставить("ЗапросТекст",ЗапросТекст); 
	ДанныеЗапроса.Вставить("Поля",Поля);
	
	Путь = "";
	Рез  = ЗапросКБазеПриемнику(ДанныеБазы, "V1/Список", ДанныеЗапроса, Путь);
	Выб  = Рез[0];
	мТипы = новый Соответствие;
	тВыб = Рез[1]; 
	Для каждого стр Из тВыб Цикл
		мТипы.Вставить( стр[0], стр[1]);
	КонецЦикла;
	
	Сырые = Выб;
	Строки = Сырые;
	Если АдаптироватьПоСоответствиям Тогда
		Строки = АдаптироватьHTTP(Сырые, Ложь, ДанныеБазы.СоответсвиеОбъектов.ЛокальнаяВоВнешнюю, ДанныеБазы.КэшТипы.Внутрь, мТипы);
	КонецЕсли;
	
	Возврат Новый Структура("Строки, Сырые", Строки, Сырые);
КонецФункции  

Функция КонструкторСтруктурыДанныеБазы()
	Возврат Новый Структура("Соединение, База, СоответсвиеОбъектов, ОбъектыМетаданных, КэшТипы, Отладка");	
КонецФункции

