КонецФункции 

Функция СоответствияОбъектовБазы(База)
	
	Запрос = Новый Запрос;
	Запрос.Текст =   "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоответствияОбъектовИнформационныхБаз.ТипИсточника КАК ТипИсточника,
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника КАК УникальныйИдентификаторПриемника,
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой КАК УникальныйИдентификаторИсточника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы.Наименование = &НаименованиеУзлаИБ
	|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника <> СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой";
	
	
	Запрос.УстановитьПараметр("НаименованиеУзлаИБ", База.НаименованиеУзлаИБ);
	Выборка = Запрос.Выполнить().Выбрать();
	мИзмерения = СтрРазделить("ТипИсточника, УникальныйИдентификаторПриемника, УникальныйИдентификаторИсточника", ", ", Ложь); 
	мРезультат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Массив;
		Для Каждого Изм Из мИзмерения Цикл
			Если ТипЗнч(Выборка[Изм]) = Тип("УникальныйИдентификатор") Тогда
				Зн = Строка(Выборка[Изм]);
				Стр.Добавить(ЗначениеВСтрокуВнутр(Зн));	
			Иначе 	
				Стр.Добавить(ЗначениеВСтрокуВнутр(Выборка[Изм]));
				
			КонецЕсли;
		КонецЦикла;
		мРезультат.Добавить(Стр);
	КонецЦикла; 
	
	Результат = Новый Массив;
	КэшПустыхСсылок = Новый Соответствие;
	Для Каждого эл Из мРезультат Цикл
		Стр = Новый Массив;
		ТипСтр  =    ЗначениеИзСтрокиВнутр(эл[0]);
		СтрокаПриемник =   ЗначениеИзСтрокиВнутр(эл[1]);
		СтрокаПриемникВнутр = СтрокаИзУИД(ТипСтр, СтрокаПриемник, КэшПустыхСсылок);
		Стр.Добавить(СтрокаПриемникВнутр); 
		СтрокаИсточник =   ЗначениеИзСтрокиВнутр(эл[2]);  
		СтрокаИсточникВнутр = СтрокаИзУИД(ТипСтр, СтрокаИсточник, КэшПустыхСсылок);    
		Стр.Добавить(СтрокаИсточникВнутр);
		Результат.Добавить(Стр);
	КонецЦикла;  
	
	СоответствияОбъектовИнформационныхБаз = Новый Структура("ВнешняяВЛокальную, ЛокальнаяВоВнешнюю", Новый Соответствие, Новый Соответствие);
	Для каждого мСтр Из Результат  Цикл		
		Внешн = мСтр[1];
		Локал = мСтр[0];
		
		СоответствияОбъектовИнформационныхБаз.ВнешняяВЛокальную.Вставить(Внешн, Локал);
		СоответствияОбъектовИнформационныхБаз.ЛокальнаяВоВнешнюю.Вставить(Локал, Внешн);
		УИДПриемника = "";
		СтрокаВнутрАнализ(Локал, , , , УИДПриемника);
		Если УИДПриемника <> "" Тогда
			СоответствияОбъектовИнформационныхБаз.ЛокальнаяВоВнешнюю.Вставить(УИДПриемника, Внешн);
		КонецЕсли;
	КонецЦикла; 
	
	Возврат СоответствияОбъектовИнформационныхБаз;
	
КонецФункции

Функция СтрокаИзУИД(ТипСтр, УИД, КэшПустыхСсылок = Неопределено)
    Тип = Тип(ТипСтр);

	Если КэшПустыхСсылок = Неопределено Тогда
		КэшПустыхСсылок = Новый Соответствие;
	КонецЕсли;
	СтрПустое = КэшПустыхСсылок.Получить(ТипСтр);
	Если СтрПустое = Неопределено Тогда
		СтрПустое = ЗначениеВСтрокуВнутр(XMLЗначение(Тип, "00000000-0000-0000-0000-000000000000"));
		КэшПустыхСсылок.Вставить(ТипСтр, СтрПустое);
	КонецЕсли;
    
    Стр = УИД;
    // 123456789012345678901234567890123456
    // 1435823d-b0b3-11ec-9871-0050568d2260
    // 98710050568d226011ecb0b31435823d
    Стр = ""
        + Сред(Стр, 20,  4)
        + Сред(Стр, 25, 12)
        + Сред(Стр, 15,  4)
        + Сред(Стр, 10,  4)
        + Сред(Стр,  1,  8)
    ;
    Стр = СтрЗаменить(СтрПустое, "00000000000000000000000000000000", Стр);
    
    Возврат Стр;
КонецФункции

Функция ОбъектыМетаданныхБазы(База)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	EMS_ОбъектыМетаданных.ОбъектМетаданных КАК Тип,
	|	EMS_ОбъектыМетаданных.Вид КАК Вид,
	|	EMS_ОбъектыМетаданных.ПолеОрганизации КАК ПолеОрганизации,
	|	EMS_ОбъектыМетаданных.ОсновныеПоляДляСверки КАК ОсновныеПоляДляСверки,
	|	EMS_ОбъектыМетаданных.ДополнительныеПоляДляСверки КАК ДополнительныеПоляДляСверки
	|ИЗ
	|	РегистрСведений.EMS_ОбъектыМетаданных КАК EMS_ОбъектыМетаданных
	|ГДЕ
	|	EMS_ОбъектыМетаданных.ПараметрыБазы = &ПараметрыБазы
	|	И EMS_ОбъектыМетаданных.Выбран";
	
	Запрос.УстановитьПараметр("ПараметрыБазы", База.Ссылка); 
	Выборка = Запрос.Выполнить().Выбрать();
	ОбъектыМетаданных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ОбъектМетаданных = КонструкторСтруктурыОбъектыМетаданныхДляБазы();
		ЗаполнитьЗначенияСвойств(ОбъектМетаданных, Выборка);
		ОбъектыМетаданных.Добавить(ОбъектМетаданных);
	КонецЦикла; 
	Возврат ОбъектыМетаданных;
КонецФункции 

Функция КонструкторСтруктурыОбъектыМетаданныхДляБазы()
	Возврат Новый Структура("Тип, Вид, ПолеОрганизации, ОсновныеПоляДляСверки, ДополнительныеПоляДляСверки");	
КонецФункции

// Возвращает ключ записи регистра EMS_ОбъектыМетаданных по объекту метаданных и его виду.
//
// Параметры:
//  ДанныеЗаписи - РегистрСведенийЗапись.EMS_ОбъектыМетаданных, Структура - запись регистра или описание объекта метаданных.
//
// Возвращаемое значение:
//  Строка - ключ вида "Справочники.ФизическиеЛица".
//
Функция КлючЗаписиРегистра(ДанныеЗаписи)
	Возврат ДанныеЗаписи.ОбъектМетаданных + "." + ДанныеЗаписи.Вид;
КонецФункции

// Возвращает описание объектов метаданных, входящих в состав указанного плана обмена.
//
// Возвращаемое значение:
//  Массив из Структура - описание объекта метаданных:
//    * ОбъектМетаданных - Строка - имя вида метаданных во множественном числе, например "Справочники";
//    * Вид              - Строка - имя объекта метаданных, например "ФизическиеЛица";
//    * Представление    - Строка - синоним объекта метаданных;
//    * Иерархический    - Булево - признак иерархического справочника;
//    * Владелец         - Булево - признак наличия владельца у справочника;
//    * Выбран           - Булево - признак участия объекта в сверке;
//    * ПолеОрганизации  - Строка - имя реквизита со ссылкой на организацию.
//
Функция ПланОбменаПоНаименованию(НаименованиеПланаОбмена) Экспорт

	ИмяПланаОбмена = СокрЛП(Строка(НаименованиеПланаОбмена));
	Если Не ЗначениеЗаполнено(ИмяПланаОбмена) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПланОбмена = Метаданные.ПланыОбмена.Найти(ИмяПланаОбмена);
	Если ПланОбмена <> Неопределено Тогда
		Возврат ПланОбмена;
	КонецЕсли;

	ИмяДляСравнения = НРег(ИмяПланаОбмена);
	Для Каждого ПланОбменаКонфигурации Из Метаданные.ПланыОбмена Цикл
		Если НРег(ПланОбменаКонфигурации.Имя) = ИмяДляСравнения
			Или НРег(ПланОбменаКонфигурации.Представление()) = ИмяДляСравнения Тогда
			Возврат ПланОбменаКонфигурации;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ОписаниеОбъектовПланаОбмена(ПланОбмена, ТолькоВыгрузкаЭтойБазы = Ложь)

	ВидыМетаданных = Новый Соответствие;
	ВидыМетаданных.Вставить("Справочник", "Справочники");
	ВидыМетаданных.Вставить("Документ", "Документы");
	ВидыМетаданных.Вставить("РегистрСведений", "РегистрыСведений");
	ВидыМетаданных.Вставить("РегистрНакопления", "РегистрыНакопления");
	ВидыМетаданных.Вставить("ПланВидовХарактеристик", "ПланыВидовХарактеристик");
	ВидыМетаданных.Вставить("Последовательность", "Последовательности");
	ВидыМетаданных.Вставить("РегистрРасчета", "РегистрыРасчета");

	ОписаниеОбъектов = Новый Массив;
	Пропущено = 0;

	Если ПланОбмена = Неопределено Тогда
		Возврат Новый Структура("Объекты, Пропущено", ОписаниеОбъектов, Пропущено);
	КонецЕсли;

	Если ТолькоВыгрузкаЭтойБазы Тогда
		ОбъектыСОтказом = ОбъектыСБезусловнымОтказомВыгрузки(ПланОбмена.Имя);
	Иначе
		ОбъектыСОтказом = ОбъектыСБезусловнымОтказомОбмена(ПланОбмена.Имя);
	КонецЕсли;

	Для Каждого ЭлементСостава Из ПланОбмена.Состав Цикл

		ОбъектМетаданных = ЭлементСостава.Метаданные;
		ЧастиИмени = СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".", Ложь);
		Если ЧастиИмени.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		ВидМетаданных = ВидыМетаданных.Получить(ЧастиИмени[0]);
		Если ВидМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ОбъектИсключенИзЗаполнения(ВидМетаданных, ОбъектМетаданных.Имя, ОбъектМетаданных.Представление()) Тогда
			Продолжить;
		КонецЕсли;
		Если ОбъектыСОтказом.Получить(ВидМетаданных + "." + ОбъектМетаданных.Имя) <> Неопределено Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		ОписаниеОбъекта = Новый Структура;
		ОписаниеОбъекта.Вставить("ОбъектМетаданных", ВидМетаданных);
		ОписаниеОбъекта.Вставить("Вид", ОбъектМетаданных.Имя);
		ОписаниеОбъекта.Вставить("Представление", ОбъектМетаданных.Представление());
		ОписаниеОбъекта.Вставить("Иерархический", Ложь);
		ОписаниеОбъекта.Вставить("Владелец", Ложь);
		ОписаниеОбъекта.Вставить("Выбран", Истина);
		ОписаниеОбъекта.Вставить("ПолеОрганизации", ПолеОрганизацииОбъектаМетаданных(ОбъектМетаданных, ВидМетаданных));

		Если ВидМетаданных = "Справочники" Тогда
			ОписаниеОбъекта.Иерархический = ОбъектМетаданных.Иерархический;
			ОписаниеОбъекта.Владелец = ОбъектМетаданных.Владельцы.Количество() > 0;
		КонецЕсли;

		ОписаниеОбъектов.Добавить(ОписаниеОбъекта);

	КонецЦикла;

	Возврат Новый Структура("Объекты, Пропущено", ОписаниеОбъектов, Пропущено);

КонецФункции

Функция ОбъектыСБезусловнымОтказомВыгрузки(ИмяПланаОбмена)

	Исключенные = Новый Соответствие;
	ТекстыПравил = ТекстыПравилПланаОбмена(ИмяПланаОбмена);
	ДополнитьИсключенныеПоXMLПравил(ТекстыПравил.Конвертация, Исключенные);
	ДополнитьИсключенныеПоXMLПравил(ТекстыПравил.Регистрация, Исключенные);
	Возврат Исключенные;

КонецФункции

Функция ОбъектыСБезусловнымОтказомОбмена(ИмяПланаОбмена)

	Исключенные = Новый Соответствие;
	ТекстыПравил = ТекстыПравилПланаОбмена(ИмяПланаОбмена);
	ДополнитьИсключенныеПоXMLПравил(ТекстыПравил.Конвертация, Исключенные);
	ДополнитьИсключенныеПоXMLПравил(ТекстыПравил.Корреспондент, Исключенные);
	ДополнитьИсключенныеПоXMLПравил(ТекстыПравил.Регистрация, Исключенные);
	Возврат Исключенные;

КонецФункции

Функция ТекстыПравилПланаОбмена(ИмяПланаОбмена)

	Тексты = Новый Структура("Конвертация, Корреспондент, Регистрация", "", "", "");
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Правила.ВидПравил КАК ВидПравил,
		|	Правила.ПравилаXML КАК ПравилаXML,
		|	Правила.ПравилаXMLКорреспондента КАК ПравилаXMLКорреспондента
		|ИЗ
		|	РегистрСведений.ПравилаДляОбменаДанными КАК Правила
		|ГДЕ
		|	Правила.ИмяПланаОбмена = &ИмяПланаОбмена
		|	И Правила.ПравилаЗагружены";
		Запрос.УстановитьПараметр("ИмяПланаОбмена", ИмяПланаОбмена);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ВидПравил = Перечисления.ВидыПравилДляОбменаДанными.ПравилаКонвертацииОбъектов Тогда
				Тексты.Конвертация = ТекстПравилИзХранилища(Выборка.ПравилаXML);
				Тексты.Корреспондент = ТекстПравилИзХранилища(Выборка.ПравилаXMLКорреспондента);
			ИначеЕсли Выборка.ВидПравил = Перечисления.ВидыПравилДляОбменаДанными.ПравилаРегистрацииОбъектов Тогда
				Тексты.Регистрация = ТекстПравилИзХранилища(Выборка.ПравилаXML);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Тексты.Конвертация = "";
		Тексты.Корреспондент = "";
		Тексты.Регистрация = "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Тексты.Конвертация) Тогда
		Тексты.Конвертация = ТекстМакетаПравил(ИмяПланаОбмена, "ПравилаОбмена");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Тексты.Корреспондент) Тогда
		Тексты.Корреспондент = ТекстМакетаПравил(ИмяПланаОбмена, "ПравилаОбменаКорреспондента");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Тексты.Регистрация) Тогда
		Тексты.Регистрация = ТекстМакетаПравил(ИмяПланаОбмена, "ПравилаРегистрации");
	КонецЕсли;

	Возврат Тексты;

КонецФункции

Функция ИспользуемыеОбъектыПравилКорреспондента(ИмяПланаОбмена)

	Результат = Новый Структура("ПравилаНайдены, Объекты", Ложь, Новый Соответствие);
	ТекстПравил = ТекстПравилКорреспондентаПлана(ИмяПланаОбмена);
	Если Не ЗначениеЗаполнено(ТекстПравил) Или СтрНайти(ТекстПравил, "<Правил") = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ДополнитьИсключенныеПоXMLПравилБезОшибок(ТекстПравил, Новый Соответствие, Результат.Объекты);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Результат.ПравилаНайдены = Результат.Объекты.Количество() > 0;
	Возврат Результат;

КонецФункции

Функция ТекстПравилКорреспондентаПлана(ИмяПланаОбмена)

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Правила.ПравилаXMLКорреспондента КАК ПравилаXMLКорреспондента
		|ИЗ
		|	РегистрСведений.ПравилаДляОбменаДанными КАК Правила
		|ГДЕ
		|	Правила.ИмяПланаОбмена = &ИмяПланаОбмена
		|	И Правила.ПравилаЗагружены
		|	И Правила.ВидПравил = ЗНАЧЕНИЕ(Перечисление.ВидыПравилДляОбменаДанными.ПравилаКонвертацииОбъектов)";
		Запрос.УстановитьПараметр("ИмяПланаОбмена", ИмяПланаОбмена);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Возврат "";
		КонецЕсли;
		Возврат ТекстПравилИзХранилища(Выборка.ПравилаXMLКорреспондента);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ОбъектОтсутствуетВПравилахКорреспондента(ПравилаКорреспондента, ВидМетаданных, ИмяОбъекта)

	Если Не ПравилаКорреспондента.ПравилаНайдены Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПравилаКорреспондента.Объекты.Получить(ВидМетаданных + "." + ИмяОбъекта) = Неопределено;

КонецФункции

Функция ТекстПравилИзХранилища(Хранилище)

	Данные = Хранилище;
	Если ТипЗнч(Данные) = Тип("ХранилищеЗначения") Тогда
		Данные = Данные.Получить();
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Строка") Тогда
		Возврат Данные;
	КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Или Данные.Размер() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Если СтрНайти(Текст, "<Правил") = 0 Тогда
		ТекстANSI = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.ANSI);
		Если СтрНайти(ТекстANSI, "<Правил") > 0 Тогда
			Текст = ТекстANSI;
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ТекстМакетаПравил(ИмяПланаОбмена, ИмяМакета)

	Попытка
		Если Метаданные.ПланыОбмена[ИмяПланаОбмена].Макеты.Найти(ИмяМакета) = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат ПланыОбмена[ИмяПланаОбмена].ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Процедура ДополнитьИсключенныеПоXMLПравил(ТекстXML, Исключенные)

	Если Не ЗначениеЗаполнено(ТекстXML) Или СтрНайти(ТекстXML, "<Правил") = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДополнитьИсключенныеПоXMLПравилБезОшибок(ТекстXML, Исключенные);
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

Процедура ДополнитьИсключенныеПоXMLПравилБезОшибок(ТекстXML, Исключенные, ИспользуемыеОбъекты = Неопределено)

	ОтказПКО = Новый Соответствие;
	ВыгрузкаПКО = Новый Соответствие;
	ОтказПВД = Новый Соответствие;
	ВыгрузкаПВД = Новый Соответствие;
	ОтказПРО = Новый Соответствие;
	РегистрацияПРО = Новый Соответствие;

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Глубина = 0;
	Раздел = "";
	ГлубинаРаздела = 0;
	ГлубиныОтключенныхГрупп = Новый Массив;
	ВПравиле = Ложь;
	ГлубинаПравила = 0;
	ПропуститьПравило = Ложь;
	ИсточникПравила = "";
	ПередВыгрузкой = "";
	ПередОбработкой = "";
	ПриОбработке = "";
	ВнутриВложенного = Ложь;
	ГлубинаВложенного = 0;

	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Глубина = Глубина + 1;
			ИмяУзла = Чтение.ЛокальноеИмя;
			Если ИмяУзла = "ПравилаКонвертацииОбъектов" Или ИмяУзла = "ПравилаВыгрузкиДанных" Или ИмяУзла = "ПравилаРегистрацииОбъектов" Тогда
				Раздел = ИмяУзла;
				ГлубинаРаздела = Глубина;
			ИначеЕсли ИмяУзла = "Группа" И ЗначениеЗаполнено(Раздел) И АтрибутXMLБулево(Чтение, "Отключить") Тогда
				ГлубиныОтключенныхГрупп.Добавить(Глубина);
			ИначеЕсли ИмяУзла = "Правило" И ЗначениеЗаполнено(Раздел) И Не ВПравиле И ГлубиныОтключенныхГрупп.Количество() = 0 Тогда
				ПравилоОтключено = АтрибутXMLБулево(Чтение, "Отключить");
				ПравилоНевалидно = Раздел = "ПравилаРегистрацииОбъектов" И Не АтрибутXMLБулево(Чтение, "Валидное");
				ВПравиле = Истина;
				ГлубинаПравила = Глубина;
				ПропуститьПравило = ПравилоОтключено Или ПравилоНевалидно;
				ИсточникПравила = "";
				ПередВыгрузкой = "";
				ПередЗагрузкой = "";
				ПередОбработкой = "";
				ПриОбработке = "";
			ИначеЕсли ВПравиле И Не ПропуститьПравило И Не ВнутриВложенного И Глубина = ГлубинаПравила + 1 Тогда
				Если ИмяУзла = "Свойства" Или ИмяУзла = "Значения" Или ИмяУзла = "ОтборПоСвойствамОбъекта" Или ИмяУзла = "ОтборПоСвойствамПланаОбмена" Тогда
					ВнутриВложенного = Истина;
					ГлубинаВложенного = Глубина;
				ИначеЕсли ИмяУзла = "Источник" Или ИмяУзла = "ОбъектВыборки" Или ИмяУзла = "ОбъектМетаданныхИмя" Тогда
					ИсточникПравила = ПрочитатьТекстТекущегоЭлементаXML(Чтение);
					Глубина = Глубина - 1;
				ИначеЕсли ИмяУзла = "ПередВыгрузкой" Или ИмяУзла = "ПередВыгрузкойОбъекта" Тогда
					ПередВыгрузкой = ПрочитатьТекстТекущегоЭлементаXML(Чтение);
					Глубина = Глубина - 1;
				ИначеЕсли ИмяУзла = "ПередЗагрузкой" Тогда
					ПередЗагрузкой = ПрочитатьТекстТекущегоЭлементаXML(Чтение);
					Глубина = Глубина - 1;
				ИначеЕсли ИмяУзла = "ПередОбработкой" Тогда
					ПередОбработкой = ПрочитатьТекстТекущегоЭлементаXML(Чтение);
					Глубина = Глубина - 1;
				ИначеЕсли ИмяУзла = "ПриОбработке" Тогда
					ПриОбработке = ПрочитатьТекстТекущегоЭлементаXML(Чтение);
					Глубина = Глубина - 1;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ИмяУзла = Чтение.ЛокальноеИмя;
			Если ВнутриВложенного И ИмяУзла = "Свойства" Или ВнутриВложенного И ИмяУзла = "Значения"
				Или ВнутриВложенного И ИмяУзла = "ОтборПоСвойствамОбъекта" Или ВнутриВложенного И ИмяУзла = "ОтборПоСвойствамПланаОбмена" Тогда
				Если Глубина = ГлубинаВложенного Тогда
					ВнутриВложенного = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если ВПравиле И ИмяУзла = "Правило" И Глубина = ГлубинаПравила Тогда
				Если Не ПропуститьПравило Тогда
					ЗафиксироватьОтказПравила(Раздел, ИсточникПравила, ПередВыгрузкой, ПередОбработкой, ПриОбработке,
						ОтказПКО, ВыгрузкаПКО, ОтказПВД, ВыгрузкаПВД, ОтказПРО, РегистрацияПРО);
					Если ИспользуемыеОбъекты <> Неопределено
						И Не (ОтказБезУсловия(ПередВыгрузкой) И ОтказБезУсловия(ПередЗагрузкой)) Тогда
						КлючИспользуемого = КлючМетаданныхИсточникаПравила(ИсточникПравила);
						Если КлючИспользуемого <> "" Тогда
							ИспользуемыеОбъекты.Вставить(КлючИспользуемого, Истина);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				ВПравиле = Ложь;
			КонецЕсли;
			Если ИмяУзла = "Группа" И ГлубиныОтключенныхГрупп.Количество() > 0
				И ГлубиныОтключенныхГрупп[ГлубиныОтключенныхГрупп.Количество() - 1] = Глубина Тогда
				ГлубиныОтключенныхГрупп.Удалить(ГлубиныОтключенныхГрупп.Количество() - 1);
			КонецЕсли;
			Если ЗначениеЗаполнено(Раздел) И ИмяУзла = Раздел И Глубина = ГлубинаРаздела Тогда
				Раздел = "";
			КонецЕсли;
			Глубина = Глубина - 1;
		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();
	ПеренестиБезусловныйОтказ(ОтказПКО, ВыгрузкаПКО, Исключенные);
	ПеренестиБезусловныйОтказ(ОтказПВД, ВыгрузкаПВД, Исключенные);
	ПеренестиБезусловныйОтказ(ОтказПРО, РегистрацияПРО, Исключенные);

КонецПроцедуры

Процедура ЗафиксироватьОтказПравила(Раздел, ИсточникПравила, ПередВыгрузкой, ПередОбработкой, ПриОбработке,
	ОтказПКО, ВыгрузкаПКО, ОтказПВД, ВыгрузкаПВД, ОтказПРО, РегистрацияПРО)

	Ключ = КлючМетаданныхИсточникаПравила(ИсточникПравила);
	Если Ключ = "" Тогда
		Возврат;
	КонецЕсли;

	Если Раздел = "ПравилаКонвертацииОбъектов" Тогда
		Если ОтказБезУсловия(ПередВыгрузкой) Тогда
			ОтказПКО.Вставить(Ключ, Истина);
		Иначе
			ВыгрузкаПКО.Вставить(Ключ, Истина);
		КонецЕсли;
	ИначеЕсли Раздел = "ПравилаВыгрузкиДанных" Тогда
		Если ОтказБезУсловия(ПередВыгрузкой) Тогда
			ОтказПВД.Вставить(Ключ, Истина);
		Иначе
			ВыгрузкаПВД.Вставить(Ключ, Истина);
		КонецЕсли;
	ИначеЕсли Раздел = "ПравилаРегистрацииОбъектов" Тогда
		Если ОтказБезУсловия(ПередОбработкой) Или ОтказБезУсловия(ПриОбработке) Тогда
			ОтказПРО.Вставить(Ключ, Истина);
		Иначе
			РегистрацияПРО.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьТекстТекущегоЭлементаXML(Чтение)

	Имя = Чтение.ЛокальноеИмя;
	Значение = "";
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			Значение = Значение + Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = Имя Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Значение;

КонецФункции

Функция АтрибутXMLБулево(Чтение, ИмяАтрибута)

	Значение = НРег(СокрЛП(Строка(Чтение.ПолучитьАтрибут(ИмяАтрибута))));
	Возврат Значение = "true" Или Значение = "истина" Или Значение = "1";

КонецФункции

Процедура ПеренестиБезусловныйОтказ(ОтказПоОбъекту, ЕстьРазрешенноеПравило, Исключенные)

	Для Каждого ОтказОбъекта Из ОтказПоОбъекту Цикл
		Если ЕстьРазрешенноеПравило.Получить(ОтказОбъекта.Ключ) = Неопределено Тогда
			Исключенные.Вставить(ОтказОбъекта.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КлючМетаданныхИсточникаПравила(ТипИсточника)

	Части = СтрРазделить(СокрЛП(ТипИсточника), ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	Виды = Новый Соответствие;
	Виды.Вставить("ДокументСсылка", "Документы");
	Виды.Вставить("Документ", "Документы");
	Виды.Вставить("СправочникСсылка", "Справочники");
	Виды.Вставить("Справочник", "Справочники");
	Виды.Вставить("РегистрСведенийЗапись", "РегистрыСведений");
	Виды.Вставить("РегистрСведений", "РегистрыСведений");
	Виды.Вставить("РегистрНакопленияЗапись", "РегистрыНакопления");
	Виды.Вставить("РегистрНакопления", "РегистрыНакопления");
	Виды.Вставить("РегистрБухгалтерииЗапись", "РегистрыБухгалтерии");
	Виды.Вставить("РегистрБухгалтерии", "РегистрыБухгалтерии");
	Виды.Вставить("РегистрРасчетаЗапись", "РегистрыРасчета");
	Виды.Вставить("РегистрРасчета", "РегистрыРасчета");
	Виды.Вставить("ПланВидовХарактеристикСсылка", "ПланыВидовХарактеристик");
	Виды.Вставить("ПланВидовХарактеристик", "ПланыВидовХарактеристик");

	Вид = Виды.Получить(Части[0]);
	Если Вид = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Вид + "." + Части[1];

КонецФункции

Функция ОтказБезУсловия(ТекстОбработчика)

	Если Не ЗначениеЗаполнено(ТекстОбработчика) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокиОбработчика = СтрРазделить(ТекстОбработчика, Символы.ПС, Ложь);
	Текст = "";
	Для Каждого СтрокаОбработчика Из СтрокиОбработчика Цикл
		ПозицияКомментария = СтрНайти(СтрокаОбработчика, "//");
		Если ПозицияКомментария > 0 Тогда
			СтрокаОбработчика = Лев(СтрокаОбработчика, ПозицияКомментария - 1);
		КонецЕсли;
		Текст = Текст + СокрЛП(СтрокаОбработчика);
	КонецЦикла;
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = ВРег(Текст);

	Возврат Текст = "ОТКАЗ=ИСТИНА;" Или Текст = "ОТКАЗ=ИСТИНА";

КонецФункции

Функция ОбъектИсключенИзЗаполнения(ВидМетаданных, ИмяОбъекта, Представление = "")

	Ключ = ВидМетаданных + "." + ИмяОбъекта;
	Если КлючиДополнительноИсключенныхОбъектов().Получить(Ключ) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНайти(ВРег(ИмяОбъекта), "УДАЛИТЬ") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(ВРег(Представление), "(НЕ ИСПОЛЬЗУЕТСЯ)") > 0;

КонецФункции

