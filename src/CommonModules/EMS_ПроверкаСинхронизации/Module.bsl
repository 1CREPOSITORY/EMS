Процедура ИсправитьТекущиеКадровыеДанные()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(, ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)) КАК КадроваяИсторияСотрудниковСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекДанные
	|		ПО (ТекДанные.Сотрудник = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник)
	|ГДЕ
	|	(ТекДанные.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ТекДанные.ДатаУвольнения ЕСТЬ NULL)
	|	И НЕ КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ВАрхиве
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(, ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Прием)) КАК КадроваяИсторияСотрудниковСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекДанные
	|		ПО (ТекДанные.Сотрудник = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник)
	|ГДЕ
	|	(ТекДанные.ДатаПриема = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ТекДанные.ДатаПриема ЕСТЬ NULL)
	|	И НЕ КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ВАрхиве";
	Выборка = Запрос.Выполнить().Выгрузить();
	МассивСотрудников = Выборка.ВыгрузитьКолонку("Сотрудник");  
	Если МассивСотрудников.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ОбновитьКадроваяИсторияСотрудниковИнтервальныйДляКадровыхДанных(МассивСотрудников);
		КадровыйУчет.ОбновитьТекущиеКадровыеДанныеСпискаСотрудников(
		МассивСотрудников, Новый Массив);
		УстановитьПривилегированныйРежим(Ложь);    
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Исправление данных после синхронизации. ИсправитьТекущиеКадровыеДанные'", 
		ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация, , , 
		"Сотрудники: " + СтрСоединить(МассивСотрудников, ", "));
	Исключение    
		Коммментарий = СтрШаблон("Причина: %1",	ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Исправление данных после синхронизации. ИсправитьТекущиеКадровыеДанные'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , Коммментарий);
	КонецПопытки;
КонецПроцедуры  

Процедура ОбновитьКадроваяИсторияСотрудниковИнтервальныйДляКадровыхДанных(МассивСотрудников)
	ТЗ = Новый ТаблицаЗначений;   
	ТЗ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники")); 
	Для Каждого Сотрудник Из МассивСотрудников Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Сотрудник = Сотрудник;	
	КонецЦикла;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ ВТОтборДляПереформирования
	|ИЗ
	|	&МассивСотрудников КАК Сотрудники";
	Запрос.УстановитьПараметр("МассивСотрудников", ТЗ);
	Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		РегистрыСведений.КадроваяИсторияСотрудников.ОбновитьДвиженияИнтервальногоРегистра(МенеджерВременныхТаблиц);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры    

Процедура ИсправитьФОТПлановыхНачислений()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПлановыйФОТИтоги.Сотрудник КАК Сотрудник,
	|	МАКСИМУМ(ПлановыйФОТИтоги.Период) КАК МаксПериод
	|ПОМЕСТИТЬ ВТМаксПериод
	|ИЗ
	|	РегистрСведений.ПлановыйФОТИтоги КАК ПлановыйФОТИтоги
	|
	|СГРУППИРОВАТЬ ПО
	|	ПлановыйФОТИтоги.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПлановыеНачисления.Сотрудник КАК Сотрудник,
	|	ПлановыеНачисления.Сотрудник.Наименование КАК НаименованиеСотрудника
	|ИЗ
	|	РегистрСведений.ПлановыеНачисления КАК ПлановыеНачисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТМаксПериод КАК ВТМаксПериод
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыйФОТИтоги КАК ПлановыйФОТИтоги
	|			ПО ВТМаксПериод.Сотрудник = ПлановыйФОТИтоги.Сотрудник
	|				И ВТМаксПериод.МаксПериод = ПлановыйФОТИтоги.Период
	|		ПО ПлановыеНачисления.Сотрудник = ВТМаксПериод.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
	|		ПО ПлановыеНачисления.Сотрудник = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
	|			И (КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))
	|ГДЕ
	|	ПлановыеНачисления.Используется
	|	И ЕСТЬNULL(ПлановыйФОТИтоги.ТарифнаяСтавка, 0) = 0
	|	И ЕСТЬNULL(ПлановыйФОТИтоги.ФОТ, 0) = 0
	|	И НЕ ПлановыеНачисления.Сотрудник.ВАрхиве
	|	И КадроваяИсторияСотрудниковСрезПоследних.Сотрудник ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ПлановыеНачисления.Сотрудник,
	|	ПлановыеНачисления.Сотрудник.Наименование,
	|	ЕСТЬNULL(ПлановыйФОТИтоги.ТарифнаяСтавка, 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлановыеНачисления.Сотрудник.Наименование";
	ПроблемныеСотрудники = Запрос.Выполнить().Выгрузить();  
	СотрудникиДляЖР = ПроблемныеСотрудники.ВыгрузитьКолонку("Сотрудник");   
	Если СотрудникиДляЖР.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Исправление данных после синхронизации. ИсправитьФОТПлановыхНачислений'", 
		ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация, , , 
		"Сотрудники: " + СтрСоединить(СотрудникиДляЖР, ", "));	
	КонецЕсли;
	Для Каждого Строка Из ПроблемныеСотрудники Цикл
		Попытка
			ПараметрыВыполнения = Новый Структура;
			ПараметрыВыполнения.Вставить("Сотрудник", Строка.Сотрудник);
			ПараметрыВыполнения.Вставить("ДатаВыполненияПересчета", '00010101');
			ПлановыеНачисленияСотрудников.ПересчитатьФОТПлановыхНачислений(ПараметрыВыполнения);
		Исключение   
			Коммментарий = СтрШаблон("Сотрудник: %1%2Причина: %3", Строка.НаименованиеСотрудника, Символы.ПС, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Исправление данных после синхронизации. ИсправитьФОТПлановыхНачислений'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , Строка.Сотрудник, Коммментарий);
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры  

Процедура ИсправитьКадроваяИсторияСотрудниковИнтервальный() 
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	МАКСИМУМ(СостоянияСотрудниковСрезПоследних.Период) КАК Период
		|ПОМЕСТИТЬ ВтСостояния
		|ИЗ
		|	РегистрСведений.СостоянияСотрудников.СрезПоследних КАК СостоянияСотрудниковСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	СостоянияСотрудниковСрезПоследних.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КадрИст.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ ВТБезИнтервала
		|ИЗ
		|	РегистрСведений.КадроваяИсторияСотрудников КАК КадрИст
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудниковИнтервальный КАК КадрИнт
		|		ПО КадрИст.Сотрудник = КадрИнт.Сотрудник
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтСостояния КАК ВтСостояния
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСотрудников.СрезПоследних КАК СостоянияСотрудниковСрезПоследних
		|			ПО ВтСостояния.Сотрудник = СостоянияСотрудниковСрезПоследних.Сотрудник
		|				И ВтСостояния.Период = СостоянияСотрудниковСрезПоследних.Период
		|				И (СостоянияСотрудниковСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.Увольнение))
		|		ПО КадрИст.Сотрудник = ВтСостояния.Сотрудник
		|ГДЕ
		|	КадрИнт.Сотрудник ЕСТЬ NULL
		|	И НЕ КадрИст.Сотрудник.ВАрхиве
		|	И СостоянияСотрудниковСрезПоследних.Сотрудник ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КадрСрез.Сотрудник КАК Сотрудник,
		|	КадрСрез.Должность КАК Должность,
		|	КадрСрез.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ ВТСрезПоследних
		|ИЗ
		|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&ТекущаяДата, ВидСобытия В (ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Прием), ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Перемещение))) КАК КадрСрез
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтСостояния КАК ВтСостояния
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСотрудников.СрезПоследних КАК СостоянияСотрудниковСрезПоследних
		|			ПО ВтСостояния.Сотрудник = СостоянияСотрудниковСрезПоследних.Сотрудник
		|				И ВтСостояния.Период = СостоянияСотрудниковСрезПоследних.Период
		|				И (СостоянияСотрудниковСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.Увольнение))
		|		ПО КадрСрез.Сотрудник = ВтСостояния.Сотрудник
		|ГДЕ
		|	НЕ КадрСрез.Сотрудник.ВАрхиве
		|	И СостоянияСотрудниковСрезПоследних.Сотрудник ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КадрИнт.Сотрудник КАК Сотрудник,
		|	КадрИнт.Должность КАК Должность,
		|	КадрИнт.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ ВТАктивныйИнтервал
		|ИЗ
		|	РегистрСведений.КадроваяИсторияСотрудниковИнтервальный КАК КадрИнт
		|ГДЕ
		|	КадрИнт.ДатаНачала <= &ТекущаяДата
		|	И КадрИнт.ДатаОкончания >= &ТекущаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Срез.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ ВТРасхождение
		|ИЗ
		|	ВТСрезПоследних КАК Срез
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТАктивныйИнтервал КАК Инт
		|		ПО Срез.Сотрудник = Инт.Сотрудник
		|ГДЕ
		|	(Срез.Должность <> Инт.Должность
		|			ИЛИ Срез.Подразделение <> Инт.Подразделение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТБезИнтервала.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ ВТОтборДляПереформирования
		|ИЗ
		|	ВТБезИнтервала КАК ВТБезИнтервала
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТРасхождение.Сотрудник
		|ИЗ
		|	ВТРасхождение КАК ВТРасхождение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОтборДляПереформирования.Сотрудник КАК Сотрудник
		|ИЗ
		|	ВТОтборДляПереформирования КАК ВТОтборДляПереформирования";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	РезультатПакета = Запрос.ВыполнитьПакет();
	ТаблицаПроблемных = РезультатПакета[6].Выгрузить();
	Если ТаблицаПроблемных.Количество() = 0 Тогда    
		Возврат;
	КонецЕсли;    
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		РегистрыСведений.КадроваяИсторияСотрудников
		.ОбновитьДвиженияИнтервальногоРегистра(МенеджерВременныхТаблиц);
		УстановитьПривилегированныйРежим(Ложь);   
		СотрудникиДляЖР = ТаблицаПроблемных.ВыгрузитьКолонку("Сотрудник");
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Исправление данных после синхронизации. ИсправитьКадроваяИсторияСотрудниковИнтервальный'", 
		ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация, , , 
		"Сотрудники: " + СтрСоединить(СотрудникиДляЖР, ", "));	
	Исключение    
		Коммментарий = СтрШаблон("Причина: %1",	ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Исправление данных после синхронизации. ИсправитьКадроваяИсторияСотрудниковИнтервальный'",
		ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , Коммментарий);
	КонецПопытки;
КонецПроцедуры

Процедура ИсправитьДанныеДляПодбораСотрудников()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МаксДата", Дата(3999, 12, 31));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КИС.Сотрудник КАК Сотрудник,
	|	МАКСИМУМ(КИС.Период) КАК МаксПериод
	|ПОМЕСТИТЬ ВТМаксПериодыКИС
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников КАК КИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
	|		ПО КИС.Сотрудник = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
	|			И (КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))
	|ГДЕ
	|	КИС.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
	|	И НЕ КИС.Сотрудник.ВАрхиве
	|	И КадроваяИсторияСотрудниковСрезПоследних.Сотрудник ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	КИС.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КИС.Сотрудник КАК Сотрудник,
	|	КИС.ДолжностьПоШтатномуРасписанию КАК ДолжностьВИстории
	|ПОМЕСТИТЬ ВТДолжностьКИС
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников КАК КИС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТМаксПериодыКИС КАК МаксПериоды
	|		ПО КИС.Сотрудник = МаксПериоды.Сотрудник
	|			И КИС.Период = МаксПериоды.МаксПериод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДДП.Сотрудник КАК Сотрудник,
	|	ДДП.ДолжностьПоШтатномуРасписанию КАК ДолжностьВПодборе
	|ПОМЕСТИТЬ ВТДолжностьДДП
	|ИЗ
	|	РегистрСведений.ДанныеДляПодбораСотрудников КАК ДДП
	|ГДЕ
	|	НЕ ДДП.ПоДоговоруГПХ
	|	И ДДП.Окончание = &МаксДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КИС.Сотрудник КАК Сотрудник,
	|	КИС.ДолжностьВИстории КАК ДолжностьВИстории,
	|	ДДП.ДолжностьВПодборе КАК ДолжностьВПодборе
	|ИЗ
	|	ВТДолжностьКИС КАК КИС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДолжностьДДП КАК ДДП
	|		ПО КИС.Сотрудник = ДДП.Сотрудник
	|			И КИС.ДолжностьВИстории <> ДДП.ДолжностьВПодборе
	|
	|УПОРЯДОЧИТЬ ПО
	|	КИС.Сотрудник";
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРасхождений = РезультатЗапроса.Выгрузить();
	// Уникальный список сотрудников для обновления регистра
	МассивСотрудников = Новый Массив;
	СотрудникиВМассиве = Новый Соответствие;
	Для Каждого Строка Из ТаблицаРасхождений Цикл
		Если СотрудникиВМассиве[Строка.Сотрудник] = Неопределено Тогда
			МассивСотрудников.Добавить(Строка.Сотрудник);
			СотрудникиВМассиве.Вставить(Строка.Сотрудник, Истина);
		КонецЕсли;
	КонецЦикла;
	// Точечное обновление — только изменившиеся сотрудники
	РегистрыСведений.ДанныеДляПодбораСотрудников.ОбновитьДанныеДляПодбораСотрудников(МассивСотрудников);
	// Запись в журнал регистрации — по одной строке на каждую
	// строку расхождения (сотрудник + пара было/стало)
	Для Каждого Строка Из ТаблицаРасхождений Цикл
		ЗаписьЖурналаРегистрации(
		"СинхронизацияДанныхДляПодбора.ДолжностьПоШтатномуРасписанию",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Справочники.Сотрудники,
		Строка.Сотрудник,
		СтрШаблон("Исправлено расхождение ДолжностьПоШтатномуРасписанию.
		|  ДДП (было): %1
		|  КИС (стало): %2",
		Строка.ДолжностьВПодборе,
		Строка.ДолжностьВИстории));
	КонецЦикла;
КонецПроцедуры     

Процедура ПровестиНепроведенныеДокументыПриемнаРаботуЗаПоследниеСутки()
	МоментЗапуска = ТекущаяДатаСеанса();
	Сутки = 24 * 60 * 60;
	НачалоПериода = МоментЗапуска - Сутки;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриемНаРаботу.Ссылка КАК Ссылка,
	|	ПриемНаРаботу.Номер КАК Номер,
	|	ПриемНаРаботу.Дата КАК Дата,
	|	ПриемНаРаботу.ДатаПриема КАК ДатаПриема,
	|	ПриемНаРаботу.Организация КАК Организация,
	|	ПриемНаРаботу.Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.ПриемНаРаботу КАК ПриемНаРаботу
	|ГДЕ
	|	Не ПриемНаРаботу.ПометкаУдаления
	|	И Не ПриемНаРаботу.Проведен
	|	И ПриемНаРаботу.Дата >= &НачалоПериода
	|УПОРЯДОЧИТЬ ПО
	|	ПриемНаРаботу.Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	ОшибкиПроведения = Новый Массив;
	КоличествоУспешно = 0;
	Пока Выборка.Следующий() Цикл
		Попытка
			ЗаписьЖурналаРегистрации("Автопроведение.ПриемНаРаботу", УровеньЖурналаРегистрации.Информация, Метаданные.Документы.ПриемНаРаботу,
			Выборка.Ссылка, "Проведение документа.");
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокументОбъект.ПроверитьЗаполнение() Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Если ДокументОбъект.Проведен Тогда
					КоличествоУспешно = КоличествоУспешно + 1;
				Иначе
					ТекстОшибки = СтрШаблон("Документ %1 не проведен без исключения.", Выборка.Ссылка);
					ОшибкиПроведения.Добавить(ТекстОшибки);
					ЗаписьЖурналаРегистрации("Автопроведение.ПриемНаРаботу", УровеньЖурналаРегистрации.Информация, Метаданные.Документы.ПриемНаРаботу,
					Выборка.Ссылка, ТекстОшибки);
				КонецЕсли;
			Иначе
				ТекстОшибки = СтрШаблон("Документ %1 не прошел ПроверитьЗаполнение().", Выборка.Ссылка);
				ОшибкиПроведения.Добавить(ТекстОшибки);
				ЗаписьЖурналаРегистрации("Автопроведение.ПриемНаРаботу", УровеньЖурналаРегистрации.Информация, Метаданные.Документы.ПриемНаРаботу,
				Выборка.Ссылка, ТекстОшибки);
			КонецЕсли;
		Исключение
			ТекстОшибки = СтрШаблон("Документ %1: %2", Выборка.Ссылка, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОшибкиПроведения.Добавить(ТекстОшибки);
			ЗаписьЖурналаРегистрации("Автопроведение ПриемНаРаботу", УровеньЖурналаРегистрации.Информация, Метаданные.Документы.ПриемНаРаботу,
			Выборка.Ссылка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Если ОшибкиПроведения.Количество() > 0 Тогда
		ОповеститьExpress(СформироватьТекстОповещенияПоОшибкамПроведения(ОшибкиПроведения, КоличествоУспешно));
	КонецЕсли;
КонецПроцедуры

Функция СформироватьТекстОповещенияПоОшибкамПроведения(ОшибкиПроведения, КоличествоУспешно) Экспорт
	ТекстОповещения = "Не удалось автоматически провести документы 'ПриемНаРаботу' за последние сутки.";
	ТекстОповещения = ТекстОповещения + Символы.ПС + "Успешно: " + Строка(КоличествоУспешно);
	ТекстОповещения = ТекстОповещения + Символы.ПС + "Ошибок: " + Строка(ОшибкиПроведения.Количество());
	Для Индекс = 0 По Мин(ОшибкиПроведения.Количество(), 10) - 1 Цикл
		ТекстОповещения = ТекстОповещения + Символы.ПС + "- " + ОшибкиПроведения[Индекс];
	КонецЦикла;
	Если ОшибкиПроведения.Количество() > 10 Тогда
		ТекстОповещения = ТекстОповещения + Символы.ПС + "Остальные ошибки см. в журнале регистрации.";
	КонецЕсли;
	Возврат ТекстОповещения;
КонецФункции  

Процедура ОповеститьExpress(ТекстОповещения) Экспорт
	Если ПустаяСтрока(ТекстОповещения) Тогда
		Возврат;
	КонецЕсли;
	КлючОповещения = "МониторингЗУП";
	Попытка
		НастройкиОповещения = RSN_eXpress.НастройкиОповещенияExpress(КлючОповещения);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Express.Notification",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка получения настроек eXpress: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Соединение = Новый HTTPСоединение(НастройкиОповещения.BaseURL, , , , , НастройкиОповещения.Timeout, Новый ЗащищенноеСоединениеOpenSSL());
	Попытка
		ТокенДоступа = RSN_eXpress.ТокенБота(Соединение, НастройкиОповещения);
		RSN_eXpress.ОтправитьСообщениеВExpress(Соединение, ТокенДоступа, НастройкиОповещения.IdЧата, ТекстОповещения, , НастройкиОповещения.BotID);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Express.Notification",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка отправки сообщения в eXpress: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
