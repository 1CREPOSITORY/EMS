КонецПроцедуры

// Отправляет пакет сообщений на регистрацию изменений во внешнюю базу.
// Все записи в МассивЗаписей должны относиться к одной базе (база берётся из первой записи).
// Параметры: МассивЗаписей - Массив из Структура (База, Тип, Вид, Сообщение, Дата, ПолноеИмяМетаданных, ВидДанныхДляРегистрации, КлючРегистрацииОтбор).
// Возврат: Структура (Успех, Результаты - Массив из Структура (Индекс, Success, ErrorText) по порядку записей, ТекстОшибкиОтправки, ИдентификаторПакета).
//
Функция ОтправитьПакетНаРегистрациюИзменений(МассивЗаписей) Экспорт
	Результат = Новый Структура("Успех, Результаты, ТекстОшибкиОтправки, ИдентификаторПакета", Ложь, Новый Массив, "", "");
	Если МассивЗаписей.Количество() = 0 Тогда
		Результат.ТекстОшибкиОтправки = "Нет записей для отправки";
		Возврат Результат;
	КонецЕсли;
	БазаСсылка = МассивЗаписей[0].База;
	ПараметрыБазы = ПолучитьПараметрыБазыПоСсылке(БазаСсылка);
	Если ПараметрыБазы = Неопределено Тогда
		Результат.ТекстОшибкиОтправки = "Не удалось получить параметры базы";
		Возврат Результат;
	КонецЕсли;
	ЭлементыПакета = Новый Массив;
	Для Каждого Запись Из МассивЗаписей Цикл
		ЭлементыПакета.Добавить(Новый Структура("ПолноеИмяМетаданных, ВидДанныхДляРегистрации, КлючРегистрацииОтбор",
			Запись.ПолноеИмяМетаданных, Запись.ВидДанныхДляРегистрации, Запись.КлючРегистрацииОтбор));
	КонецЦикла;
	ДанныеЗапроса = Новый Структура("Элементы", ЭлементыПакета);
	ПутьРегистрации = ПараметрыБазы.WSИмяБазы + "/hs/sverka/V1/register-changes";
	Соединение = ПолучитьПодключениеHTTPСервер(ПараметрыБазы);
	Если Соединение = Неопределено Тогда
		Результат.ТекстОшибкиОтправки = "Не удалось установить соединение с внешней базой";
		Возврат Результат;
	КонецЕсли;
	Результат.ИдентификаторПакета = Строка(Новый УникальныйИдентификатор);
	Попытка
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
		Запрос = Новый HTTPЗапрос(ПутьРегистрации, Заголовки);
		Запрос.УстановитьТелоИзСтроки(JSON(ДанныеЗапроса, Ложь), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Если Ответ.КодСостояния <> 200 Тогда
			Результат.ТекстОшибкиОтправки = "Код ответа: " + Ответ.КодСостояния;
			Возврат Результат;
		КонецЕсли;
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
		ДанныеОтвета = unJSON(ТекстОтвета);
		РезультатыОтвета = ДанныеОтвета.Результаты;
		Если ТипЗнч(РезультатыОтвета) = Тип("Массив") Тогда
			Результат.Результаты = РезультатыОтвета;
			Результат.Успех = Истина;
		КонецЕсли;
	Исключение
		Результат.ТекстОшибкиОтправки = ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Выполняет обмен данными с выбранной нижней базой.
// Сначала синхронно запускает обмен в нижней базе по HTTP, затем запускает обмен в текущей базе.
//
// Параметры:
//  ПараметрыБазыСсылка - СправочникСсылка.EMS_ПараметрыБаз - выбранная нижняя база.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - признак успешного выполнения обоих обменов.
//   * Сообщение - Строка - текст итогового сообщения пользователю.
//   * ТекстОшибки - Строка - описание ошибки, если обмен не выполнен.
//
Функция ВыполнитьОбменДаннымиZСВыбраннойБазой(Знач ПараметрыБазыСсылка) Экспорт
	Попытка
		ПараметрыБазы = ПолучитьПараметрыБазыПоСсылке(ПараметрыБазыСсылка);
		Если ПараметрыБазы = Неопределено Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(Ложь, "Ошибка запуска обмена: не удалось получить параметры базы.",
				"Не удалось получить параметры базы.");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПараметрыБазы.НаименованиеУзлаИБ) Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(Ложь, "Ошибка запуска обмена: не заполнено наименование узла ИБ.",
				"Не заполнено наименование узла ИБ.");
		КонецЕсли;
		РезультатНижнейБазы = ВыполнитьОбменДаннымиZВНижнейБазе(ПараметрыБазы);
		Если Не РезультатНижнейБазы.Успех Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(Ложь,
				СтрШаблон("Ошибка обмена в нижней базе: %1", РезультатНижнейБазы.ТекстОшибки),
				РезультатНижнейБазы.ТекстОшибки);
		КонецЕсли;
		УзелИнформационнойБазы = НайтиУзелОбменаДаннымиZ(ПараметрыБазы.НаименованиеУзлаИБ);
		Если Не ЗначениеЗаполнено(УзелИнформационнойБазы) Тогда
			ТекстОшибки = СтрШаблон(
				"Узел плана обмена ОбменДаннымиZ не найден: %1", ПараметрыБазы.НаименованиеУзлаИБ);
			Возврат РезультатЗапускаОбменаДаннымиZ(
				Ложь, СтрШаблон("Ошибка запуска обмена в верхней базе: %1", ТекстОшибки), ТекстОшибки);
		КонецЕсли;
		РезультатВерхнейБазы = ВыполнитьОбменДаннымиZПоУзлу(УзелИнформационнойБазы);
		Если Не РезультатВерхнейБазы.Успех Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(Ложь,
				СтрШаблон("Ошибка обмена в верхней базе: %1", РезультатВерхнейБазы.ТекстОшибки),
				РезультатВерхнейБазы.ТекстОшибки);
		КонецЕсли;
		Сообщение = СтрШаблон("Обмен с базой %1 завершен.", ПараметрыБазыСсылка);
		Возврат РезультатЗапускаОбменаДаннымиZ(Истина, Сообщение, "");
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат РезультатЗапускаОбменаДаннымиZ(
			Ложь, СтрШаблон("Ошибка выполнения обмена: %1", ТекстОшибки), ТекстОшибки);
	КонецПопытки;
КонецФункции

