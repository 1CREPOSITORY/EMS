Процедура ЗаписатьИтогРегистрации(База, ТаблицаРезультата)

	Ошибки = 0;
	Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
		Если СтрокаРезультата.Результат <> "Зарегистрирован" Тогда
			Ошибки = Ошибки + 1;
		КонецЕсли;
	КонецЦикла;

	Комментарий = СтрШаблон(
		"База: %1. Записей результата: %2, с ошибкой: %3.",
		База, ТаблицаРезультата.Количество(), Ошибки);
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Проверка синхронизации данных. Регистрация к обмену'", ОбщегоНазначения.КодОсновногоЯзыка()),
		?(Ошибки = 0, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение),
		,
		База,
		Комментарий);

