Функция НайтиУзелОбменаДаннымиZ(Знач НаименованиеУзлаИБ)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбменДаннымиZ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.ОбменДаннымиZ КАК ОбменДаннымиZ
		|ГДЕ
		|	НЕ ОбменДаннымиZ.ЭтотУзел
		|	И ОбменДаннымиZ.Наименование = &НаименованиеУзлаИБ";
	Запрос.УстановитьПараметр("НаименованиеУзлаИБ", НаименованиеУзлаИБ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ВыполнитьОбменДаннымиZПоУзлу(Знач УзелИнформационнойБазы)
	Попытка
		Отказ = Ложь;
		ОбменДаннымиСервер.ПроверитьВозможностьЗапускаОбмена(УзелИнформационнойБазы, Отказ);
		Если Отказ Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(
				Ложь, "", "Запуск обмена запрещен стандартным механизмом обмена данными.");
		КонецЕсли;
		ПараметрыОбмена = ОбменДаннымиСервер.ПараметрыОбмена();
		ПараметрыОбмена.ИдентификаторТранспорта =
			ТранспортСообщенийОбмена.ТранспортПоУмолчанию(УзелИнформационнойБазы);
		ПараметрыОбмена.ВыполнятьЗагрузку = Истина;
		ПараметрыОбмена.ВыполнятьВыгрузку = Истина;
		ПараметрыОбмена.ДлительнаяОперацияРазрешена = Ложь;
		ОбменДаннымиСервер.ВыполнитьОбменДаннымиДляУзлаИнформационнойБазы(
			УзелИнформационнойБазы, ПараметрыОбмена, Отказ);
		Если Отказ Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(
				Ложь, "", "В процессе обмена возникли ошибки. Подробности см. в журнале регистрации.");
		КонецЕсли;
		Возврат РезультатЗапускаОбменаДаннымиZ(Истина, "", "");
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат РезультатЗапускаОбменаДаннымиZ(Ложь, "", ТекстОшибки);
	КонецПопытки;
КонецФункции

Функция ПолучитьПараметрыБазыПоСсылке(БазаСсылка)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	EMS_ПараметрыБаз.Ссылка КАК Ссылка,
		|	EMS_ПараметрыБаз.WSИмяСервера КАК WSИмяСервера,
		|	EMS_ПараметрыБаз.WSИмяБазы КАК WSИмяБазы,
		|	EMS_ПараметрыБаз.НаименованиеУзлаИБ КАК НаименованиеУзлаИБ
		|ИЗ
		|	Справочник.EMS_ПараметрыБаз КАК EMS_ПараметрыБаз
		|ГДЕ
		|	EMS_ПараметрыБаз.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", БазаСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураБазы = КонструкторСтруктурыБазыДляСинхронизации();
		ЗаполнитьЗначенияСвойств(СтруктураБазы, Выборка);
		Логин = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Логин");
		Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Пароль");
		СтруктураБазы.WSИмяПользователя = Логин;
		СтруктураБазы.WSПароль = Пароль;
		Возврат СтруктураБазы;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

