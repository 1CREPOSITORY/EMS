Процедура СообщитьМассив(Выб)
		Сообщить("Массив (" + Выб.Количество() + ")");
КонецПроцедуры

Процедура Обороты(ДанныеБазы, НаборЗаписейСообщений)
	Для Каждого ОбъектМетаданных Из ДанныеБазы.ОбъектыМетаданных Цикл 
		Рез = Новый Массив;
		Если ДанныеБазы.Отладка Тогда
			Сообщить("=== Метаданные " + ОбъектМетаданных.Вид + " ==="); 
		КонецЕсли;
		Попытка
			соРазница =  ОборотыОбъект(ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений);
			ОбъединитьРез(соРазница, Рез, ОбъектМетаданных.Тип); 
		Исключение 
			 Коммментарий = СтрШаблон("Ошибка получения данных из баз. Причина: %1%2Тип:%3, Вид:%4", 
			 	ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), символы.ПС, ОбъектМетаданных.Тип, ОбъектМетаданных.Вид);
			 ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. Разбор получение данных из баз'", ОбщегоНазначения.КодОсновногоЯзыка()),
			 УровеньЖурналаРегистрации.Ошибка, , ДанныеБазы.База.Ссылка, Коммментарий);
		КонецПопытки;  
		Если ДанныеБазы.Отладка Тогда
			СообщитьМассив(Рез);
		КонецЕсли;
	КонецЦикла;  
КонецПроцедуры

Функция ОборотыОбъект(ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений)  
	База = ДанныеБазы.База;
	СчетКод="";
	Результат = "Выборка";
	Режим="Разница";  
	Рез = Новый Структура;
	Если  ОбъектМетаданных.Тип = "РегистрыРасчета" Тогда 
		Шаблон = ПолучитьШаблонЗапроса(СчетКод,"зуп");
		Текст = СтрЗаменить(Шаблон, "&Условие", " Где ГоловнаяОрганизация В ИЕРАРХИИ (&Организация)"); 
		Поля =  СтрРазделить("Регистратор,Сотрудник,ФизическоеЛицо,ГоловнаяОрганизация,СторноТекущегоПериода,Результат",",",Ложь);
		Рез.Вставить("мИзмерения", Поля);
		Рез.Вставить("ЗапросТекст", Текст);  
		Рез.Вставить("Тип", "РегистрыРасчета");
	Иначе 
		Рез   =   ОбъектыВыборкаОтбор(ОбъектМетаданных); 
		Поля  =   Рез.мИзмерения;
		Текст =   Рез.ЗапросТекст;
	КонецЕсли;
	
	ЗапросПараметры = Новый Структура;
	ЗапросПараметры.Вставить("Организация", База.КодОрганизации);  
	ЗапросПараметры.Вставить("НачалоПериода", '00010101');
	ЗапросПараметры.Вставить("КонецПериода" , '39990101');
	
	Если Рез.Тип = "РегистрБухгалтерии" Или Рез.Тип = "РегистрНакопления" или Рез.Тип = "РегистрыРасчета"  Тогда
		ИнРег = Поля.Найти("Регистратор");
	Иначе  
		ИнРег = Неопределено;  
	КонецЕсли;
	соРазница = ПолучитьРезультат(Текст, Поля, ЗапросПараметры, ИнРег, Рез, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений);
	
	Если ИнРег = Неопределено  Тогда
		Рез.Вставить("Выборка", соРазница);
		Если Рез.Тип = "РегистрыСведений" Тогда 	
			МассивИзВыборки(Рез, ДанныеБазы); 
			Возврат Рез.Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат соРазница

КонецФункции

Функция ПолучитьРезультат(Текст, Поля, ЗапросПараметры, Индекс, Рез, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений)
	Локал = ВыполнитьЗапрос(Текст, Поля, ЗапросПараметры, ДанныеБазы);
	ДанныеВнешнейБазы = ВыполнитьЗапросВнешний(Текст, Поля, ЗапросПараметры, Истина, ДанныеБазы);
	Внешн = ДанныеВнешнейБазы.Адаптированные;
	ВнешнИсходные = ДанныеВнешнейБазы.Исходные;
	
	ИнСбк1 = Поля.Найти("ИдентификаторЗаписи");
	соЛокал = ПолучитьКлючиСтр(Локал, ИнСбк1);
	соВнешн = ПолучитьКлючиСтр(Внешн, ИнСбк1);
	соВнешнИсходные = ПолучитьИсходныеСтрокиПоАдаптированнымКлючам(Внешн, ВнешнИсходные, ИнСбк1);
	Выборка = ПолучитьРазницуПоКлючам(
		соЛокал, соВнешн, Индекс, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, Поля, соВнешнИсходные);
	Если Рез.Тип = "Справочники" или Рез.Тип = "Документы" или  Индекс <> Неопределено Тогда
		Возврат СтуктураВИзСтрокиВнутрНорм(Выборка);
	Иначе 
		Возврат Выборка;	
	КонецЕсли;
КонецФункции

Функция ВыполнитьЗапросВнешний(ЗапросТекст, Поля, ЗапросПараметры, АдаптироватьПоСоответствиям, ДанныеБазы)
	ДанныеЗапроса = Новый Структура();   
	ДанныеЗапроса.Вставить("ЗапросПараметры",ЗапросПараметры);
	ДанныеЗапроса.Вставить("ЗапросТекст",ЗапросТекст); 
	ДанныеЗапроса.Вставить("Поля",Поля);
	
	Путь = "";
	Рез  = ЗапросКБазеПриемнику(ДанныеБазы, "V1/Список", ДанныеЗапроса, Путь);
	Выб  = Рез[0];
	мТипы = новый Соответствие;
	тВыб = Рез[1]; 
	Для каждого стр Из тВыб Цикл
		мТипы.Вставить( стр[0], стр[1]);
	КонецЦикла;
	
	мРезультат = Новый Массив;
	Для Каждого ТекСтр Из Выб Цикл
		мСтр = Новый Массив;
		Для Каждого Зн Из ТекСтр Цикл
			мСтр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(мСтр);
	КонецЦикла;     
	мРезультатИсходный = мРезультат;
	мРезультатАдаптированный = АдаптироватьHTTP(
		мРезультат, Истина, ДанныеБазы.СоответсвиеОбъектов.ЛокальнаяВоВнешнюю, ДанныеБазы.КэшТипы.Внутрь,мТипы);
	
	Возврат Новый Структура("Адаптированные, Исходные", мРезультатАдаптированный, мРезультатИсходный);
КонецФункции  

