	|Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров";

	Для Каждого Ключ Из СтрРазделить(Список, Символы.ПС, Ложь) Цикл
		КлючОбъекта = СокрЛП(Ключ);
		Если ЗначениеЗаполнено(КлючОбъекта) Тогда
			Ключи.Вставить(КлючОбъекта, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Ключи;

КонецФункции

// Возвращает имя реквизита объекта метаданных, содержащего ссылку на организацию.
// По этому реквизиту движок синхронизации ограничивает выборку данными организации базы.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных из состава плана обмена;
//  ВидМетаданных    - Строка - имя вида метаданных во множественном числе.
//
// Возвращаемое значение:
//  Строка - имя реквизита, например "Организация"; пустая строка, если реквизит не найден.
//
Функция ПолеОрганизацииОбъектаМетаданных(ОбъектМетаданных, ВидМетаданных)

	Если ВидМетаданных = "Справочники" Или ВидМетаданных = "Документы" Тогда
		Реквизиты = ОбъектМетаданных.Реквизиты;
	ИначеЕсли ВидМетаданных = "РегистрыСведений" Тогда
		Реквизиты = ОбъектМетаданных.Измерения;
	Иначе
		Возврат "";
	КонецЕсли;

	Реквизит = Реквизиты.Найти("Организация");
	Если Реквизит <> Неопределено Тогда
		Возврат "Организация";
	КонецЕсли;

	Возврат "";

КонецФункции
#КонецОбласти 

#Область HTTPИнтеграция
// Отправляет POST-запрос в базу-приемник и возвращает разобранное тело ответа.
//
// Параметры:
//  ДанныеБазы - Структура - данные базы, см. КонструкторСтруктурыДанныеБазы;
//  ИмяКоманды - Строка - имя метода, зарезервировано для совместимости;
//  ДанныеЗапроса - Структура - тело запроса, сериализуется в JSON;
//  ПутьНаСервере - Строка - путь запроса. Если не заполнен, используется метод Обороты.
//
// Возвращаемое значение:
//  Произвольный - разобранное тело ответа базы-приемника.
//
 Функция ЗапросКБазеПриемнику(ДанныеБазы, ИмяКоманды, ДанныеЗапроса, ПутьНаСервере)
	 База = ДанныеБазы.База;
	 Если Не ЗначениеЗаполнено(ПутьНаСервере) Тогда
		 ПутьНаСервере = База.WSИмяБазы + "/hs/sverka/V1/Обороты";
	 КонецЕсли;
	 //Соединение = ПолучитьПодключениеHTTPСервер(База);
	 
	 Заголовки = Новый Соответствие;
	 Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	 
	 Запрос = Новый HTTPЗапрос(ПутьНаСервере, Заголовки);
	 Запрос.УстановитьТелоИзСтроки(JSON(ДанныеЗапроса, Ложь), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);   
	 
	 Ответ = ДанныеБазы.Соединение.ОтправитьДляОбработки(Запрос);	
	 Если Ответ.КодСостояния = 200 Тогда
		 
		 ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
		 
		 Попытка
			 ДанныеОтвета = unJSON(ТекстОтвета);
		 Исключение        
			 Коммментарий = СтрШаблон("Ошибка получения структуры из json. Причина: %1%2Данные ответа: %3", 
			 	ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, ДанныеОтвета);
			 ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. Разбор JSON'", ОбщегоНазначения.КодОсновногоЯзыка()),
			 УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий); 
			 ВызватьИсключение;
		 КонецПопытки;
		 
		 Возврат ДанныеОтвета;
		 
	 ИначеЕсли Ответ.КодСостояния = 302 или Ответ.КодСостояния = 301 Тогда 
		 НовыйАдрес = Ответ.Заголовки.Получить("Location"); 
	 Иначе
		 ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		 Если СтрДлина(ТелоОтвета) > 500 Тогда
			 ТелоОтвета = Лев(ТелоОтвета, 500);
		 КонецЕсли;
		 Коммментарий = СтрШаблон("Не удалось выполнить запрос веб-сервиса. Код ответа: %1%2%3",
			 Ответ.КодСостояния, Символы.ПС, ТелоОтвета);
		 ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. Код состояния'", ОбщегоНазначения.КодОсновногоЯзыка()),
		 УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);
		 ВызватьИсключение(Коммментарий);
	 КонецЕсли;
	 
КонецФункции

// Создает таблицу результатов регистрации объектов к обмену.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ПолноеИмяМетаданных, УникальныйИдентификатор, Результат.
//
Функция ТаблицаРезультатаРегистрации()

	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("ПолноеИмяМетаданных", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультата.Колонки.Добавить("УникальныйИдентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультата.Колонки.Добавить("Результат", Новый ОписаниеТипов("Строка"));

	Возврат ТаблицаРезультата;

КонецФункции

// Добавляет строку в таблицу результатов регистрации.
//
// Параметры:
//  ТаблицаРезультата - ТаблицаЗначений - таблица результатов;
//  ПолноеИмяМетаданных - Строка - полное имя объекта метаданных;
//  УникальныйИдентификатор - Строка - ГУИД объекта;
//  Результат - Строка - текст результата.
//
Процедура ДобавитьРезультатРегистрации(ТаблицаРезультата, ПолноеИмяМетаданных, УникальныйИдентификатор, Результат)

	СтрокаРезультата = ТаблицаРезультата.Добавить();
	СтрокаРезультата.ПолноеИмяМетаданных = ПолноеИмяМетаданных;
	СтрокаРезультата.УникальныйИдентификатор = УникальныйИдентификатор;
	СтрокаРезультата.Результат = Результат;

КонецПроцедуры

// Возвращает параметры базы из списка актуальных баз.
//
// Параметры:
//  База - СправочникСсылка.EMS_ПараметрыБаз - ссылка на параметры базы.
//
// Возвращаемое значение:
//  Структура, Неопределено - параметры базы или Неопределено, если база не найдена.
//
Функция ПараметрыБазыПоСсылке(База)

	Для Каждого ПараметрыБазы Из БазыДляСинхронизации() Цикл
		Если ПараметрыБазы.Ссылка = База Тогда
			Возврат ПараметрыБазы;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Заполняет пакет регистрации по сообщениям синхронизации выбранной базы.
//
// Параметры:
//  База - СправочникСсылка.EMS_ПараметрыБаз - база, по которой берутся расхождения;
//  ЭлементыПакета - Массив из Структура - заполняемый массив элементов пакета для HTTP-запроса;
//  ОписанияЭлементов - Массив из Структура - заполняемый массив описаний элементов, позиция совпадает с ЭлементыПакета;
//  ТаблицаРезультата - ТаблицаЗначений - таблица результатов, в которую пишутся ошибки разбора.
//
Процедура ЗаполнитьПакетРегистрации(База, ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата)

	КодыТипов = Неопределено;
	УжеВПакете = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сообщения.Тип КАК Тип,
		|	Сообщения.Вид КАК Вид,
		|	Сообщения.Сообщение КАК Сообщение
		|ИЗ
		|	РегистрСведений.EMS_СообщенияСинхронизации КАК Сообщения
		|ГДЕ
		|	Сообщения.База = &База
		|	И Сообщения.Сообщение ПОДОБНО ""%<Объект не найден>%""";
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"И Сообщения.Сообщение ПОДОБНО ""%<Объект не найден>%""",
		"И (Сообщения.Сообщение ПОДОБНО ""%<Объект не найден>%"" ИЛИ Сообщения.Сообщение ПОДОБНО ""%#ОТБОР#%"" ИЛИ Сообщения.Тип = ""РегистрыСведений"")");
	Запрос.УстановитьПараметр("База", База);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.Тип = "РегистрыСведений" Тогда
			ДобавитьРегистрСведенийВПакет(Выборка.Вид, Выборка.Сообщение, УжеВПакете,
				ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата);
			Если СтрНайти(Выборка.Сообщение, "<Объект не найден>") = 0 Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли ДобавитьРегистрациюПоОтборуСообщения(Выборка.Тип, Выборка.Вид, Выборка.Сообщение,
			УжеВПакете, ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата) Тогда
			Если СтрНайти(Выборка.Сообщение, "<Объект не найден>") = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ВидДанных = ВидДанныхДляРегистрации(Выборка.Тип);
		Если ВидДанных = "" Тогда
			Если ЭтоТипРегистра(Выборка.Тип) Тогда
				Если КодыТипов = Неопределено Тогда
					КодыТипов = КодыТиповСсылок();
				КонецЕсли;
				ДобавитьСсылкиИзСообщенияРегистра(Выборка.Сообщение, Выборка.Тип, Выборка.Вид,
					КодыТипов, УжеВПакете, ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата);
			Иначе
				ДобавитьРезультатРегистрации(ТаблицаРезультата, ИмяОбъектаМетаданных(Выборка.Тип, Выборка.Вид), "",
					"Неподдерживаемый тип метаданных для регистрации");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		ГУИДы = ГУИДыИзСообщения(Выборка.Сообщение);
		Если ГУИДы.Количество() = 0 Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, ИмяОбъектаМетаданных(Выборка.Тип, Выборка.Вид), "",
				"В сообщении не найден ГУИД объекта");
			Продолжить;
		КонецЕсли;

		ПолноеИмяМетаданных = ИмяОбъектаМетаданных(Выборка.Тип, Выборка.Вид);
		Для Каждого ГУИД Из ГУИДы Цикл

			ЭлементПакета = Новый Структура;
			ЭлементПакета.Вставить("ПолноеИмяМетаданных", ПолноеИмяМетаданных);
			ЭлементПакета.Вставить("ВидДанныхДляРегистрации", ВидДанных);
			ЭлементПакета.Вставить("КлючРегистрацииОтбор", КлючРегистрацииОтбор(ГУИД));
			ЭлементыПакета.Добавить(ЭлементПакета);

			ОписанияЭлементов.Добавить(Новый Структура(
				"ПолноеИмяМетаданных, УникальныйИдентификатор", ПолноеИмяМетаданных, ГУИД));

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Возвращает вид данных для регистрации по типу объекта метаданных.
//
// Параметры:
//  Тип - Строка - имя коллекции метаданных, например "Справочники".
//
// Возвращаемое значение:
//  Строка - вид данных для регистрации или пустая строка, если тип не поддержан.
//
Функция ВидДанныхДляРегистрации(Тип)

	Если Тип = "Справочники" Тогда
		Возврат "Catalog";
	ИначеЕсли Тип = "Документы" Тогда
		Возврат "Document";
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		Возврат "ChartOfCharacteristicTypes";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ЭтоТипРегистра(Тип)

	Возврат Тип = "РегистрыСведений"
		Или Тип = "РегистрыНакопления"
		Или Тип = "РегистрыРасчета"
		Или Тип = "РегистрыБухгалтерии";

КонецФункции

Функция ТипРегистрируетсяПоОтбору(Тип)

	Возврат ЭтоТипРегистра(Тип)
		Или Тип = "Справочники"
		Или Тип = "Документы"
		Или Тип = "ПланыВидовХарактеристик";

КонецФункции

Функция ВидДанныхРегистраДляПакета(Тип)

	Если Тип = "РегистрыНакопления" Тогда
		Возврат "AccumulationRegister";
	ИначеЕсли Тип = "РегистрыРасчета" Тогда
		Возврат "CalculationRegister";
	ИначеЕсли Тип = "РегистрыБухгалтерии" Тогда
		Возврат "AccountingRegister";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПолноеИмяРегистраДляПакета(Тип, Вид)

	Если Тип = "РегистрыНакопления" Тогда
		Возврат "РегистрНакопления." + Вид;
	ИначеЕсли Тип = "РегистрыРасчета" Тогда
		Возврат "РегистрРасчета." + Вид;
	ИначеЕсли Тип = "РегистрыБухгалтерии" Тогда
		Возврат "РегистрБухгалтерии." + Вид;
	КонецЕсли;

	Возврат Тип + "." + Вид;

КонецФункции

Функция ВидДанныхПоПолномуИмени(ПолноеИмя)

	ЧастиИмени = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Вид = ЧастиИмени[0];
	Если Вид = "Справочник" Тогда
		Возврат "Catalog";
	ИначеЕсли Вид = "Документ" Тогда
		Возврат "Document";
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат "ChartOfCharacteristicTypes";
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат "ChartOfAccounts";
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат "ChartOfCalculationTypes";
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат "ExchangePlan";
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат "BusinessProcess";
	ИначеЕсли Вид = "Задача" Тогда
		Возврат "Task";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПолноеИмяПоКодуТипа(КодыТипов, КодТипа)

	ПолноеИмя = КодыТипов.Получить(КодТипа);
	Если ПолноеИмя <> Неопределено Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Попытка
		Возврат КодыТипов.Получить(Формат(Число(КодТипа), "ЧГ=0"));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// В сообщении регистра "<Объект не найден>" относится к ссылке внутри ключа, а не к записи.
// В пакет попадают эти ссылки, чтобы нижняя база зарегистрировала их к обмену.
//
Процедура ДобавитьСсылкиИзСообщенияРегистра(ТекстСообщения, Тип, Вид, КодыТипов, УжеВПакете,
	ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата)

	ИмяРегистра = ИмяОбъектаМетаданных(Тип, Вид);
	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(ТекстСообщения, "<Объект не найден> \([^)]*\)");
	Если Совпадения = Неопределено Или Совпадения.Количество() = 0 Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, ИмяРегистра, "",
			"В сообщении не найден ГУИД объекта");
		Возврат;
	КонецЕсли;

	Для Каждого Совпадение Из Совпадения Цикл

		Фрагмент = Сред(ТекстСообщения, Совпадение.НачальнаяПозиция, Совпадение.Длина);
		Разбор = РазобратьФрагментОбъектНеНайден(Фрагмент);
		Если Разбор = Неопределено Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, ИмяРегистра, "",
				"В сообщении не найден ГУИД объекта");
			Продолжить;
		КонецЕсли;

		ПолноеИмя = ПолноеИмяПоКодуТипа(КодыТипов, Разбор.КодТипа);
		ВидДанных = "";
		Если ПолноеИмя <> Неопределено Тогда
			ВидДанных = ВидДанныхПоПолномуИмени(ПолноеИмя);
		КонецЕсли;
		Если ВидДанных = "" Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, ИмяРегистра, Разбор.ГУИД,
				"Не удалось определить тип ссылки для регистрации");
			Продолжить;
		КонецЕсли;

		КлючПакета = ПолноеИмя + "|" + Разбор.ГУИД;
		Если УжеВПакете.Получить(КлючПакета) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеВПакете.Вставить(КлючПакета, Истина);

		ЭлементПакета = Новый Структура;
		ЭлементПакета.Вставить("ПолноеИмяМетаданных", ПолноеИмя);
		ЭлементПакета.Вставить("ВидДанныхДляРегистрации", ВидДанных);
		ЭлементПакета.Вставить("КлючРегистрацииОтбор", КлючРегистрацииОтбор(Разбор.ГУИД));
		ЭлементыПакета.Добавить(ЭлементПакета);
		ОписанияЭлементов.Добавить(Новый Структура(
			"ПолноеИмяМетаданных, УникальныйИдентификатор", ПолноеИмя, Разбор.ГУИД));

	КонецЦикла;

КонецПроцедуры

// Возвращает полное имя объекта метаданных по типу и виду.
//
// Параметры:
//  Тип - Строка - имя коллекции метаданных, например "Справочники";
//  Вид - Строка - имя объекта метаданных, например "ФизическиеЛица".
//
// Возвращаемое значение:
//  Строка - полное имя объекта метаданных, например "Справочник.ФизическиеЛица".
//
Функция ИмяОбъектаМетаданных(Тип, Вид)

	Если Тип = "Справочники" Тогда
		Возврат "Справочник." + Вид;
	ИначеЕсли Тип = "Документы" Тогда
		Возврат "Документ." + Вид;
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		Возврат "ПланВидовХарактеристик." + Вид;
	КонецЕсли;

	Возврат Тип + "." + Вид;

КонецФункции

// Извлекает ГУИДы объектов из текста сообщения вида "<Объект не найден> (702:8049...)".
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения регистра EMS_СообщенияСинхронизации.
//
// Возвращаемое значение:
//  Массив из Строка - найденные ГУИД в формате xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.
//
Функция ГУИДыИзСообщения(ТекстСообщения)

	Результат = Новый Массив;
	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(ТекстСообщения, "<Объект не найден> \([^)]*\)");
	Если Совпадения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Совпадение Из Совпадения Цикл
		Фрагмент = Сред(ТекстСообщения, Совпадение.НачальнаяПозиция, Совпадение.Длина);
		ГУИД = ГУИДИзФрагмента(Фрагмент);
		Если ЗначениеЗаполнено(ГУИД) Тогда
			Результат.Добавить(ГУИД);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует фрагмент "<Объект не найден> (702:8049...)" в строку ГУИД.
//
// Параметры:
//  Фрагмент - Строка - найденный фрагмент сообщения.
//
// Возвращаемое значение:
//  Строка - ГУИД или пустая строка, если преобразовать не удалось.
//
Функция ГУИДИзФрагмента(Фрагмент)

	Внутреннее = СтрЗаменить(Фрагмент, "<Объект не найден> (", "");
	Внутреннее = СтрЗаменить(Внутреннее, ")", "");
	Внутреннее = СтрЗаменить(Внутреннее, "0x", "");

	Части = СтрРазделить(Внутреннее, ":", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	Представление = СокрЛП(Части[1]);
	Если СтрДлина(Представление) <> 32 Тогда
		Возврат "";
	КонецЕсли;

	ГУИД = Сред(Представление, 25, 8) + "-" + Сред(Представление, 21, 4) + "-"
		+ Сред(Представление, 17, 4) + "-" + Сред(Представление, 1, 4) + "-"
		+ Сред(Представление, 5, 12);

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(ГУИД);
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат Строка(Идентификатор);

КонецФункции

Функция РазобратьФрагментОбъектНеНайден(Фрагмент)

	Внутреннее = СтрЗаменить(Фрагмент, "<Объект не найден> (", "");
	Если Прав(Внутреннее, 1) = ")" Тогда
		Внутреннее = Лев(Внутреннее, СтрДлина(Внутреннее) - 1);
	КонецЕсли;

	Позиция = СтрНайти(Внутреннее, ":");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодТипа = СтрЗаменить(СокрЛП(Лев(Внутреннее, Позиция - 1)), "0x", "");
	ГУИД = ГУИДИзФрагмента(Фрагмент);
	Если Не ЗначениеЗаполнено(ГУИД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("КодТипа, ГУИД", КодТипа, ГУИД);

КонецФункции

Функция КодыТиповСсылок()

	КодыТипов = Новый Соответствие;
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Справочники, "Справочник");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Документы, "Документ");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыСчетов, "ПланСчетов");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыВидовРасчета, "ПланВидовРасчета");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыОбмена, "ПланОбмена");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.БизнесПроцессы, "БизнесПроцесс");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Задачи, "Задача");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Перечисления, "Перечисление");
	Возврат КодыТипов;

КонецФункции

Процедура ДобавитьКодыТиповКоллекции(КодыТипов, Коллекция, Вид)

	Для Каждого ОбъектМетаданных Из Коллекция Цикл

		ПустаяСсылка = ПустаяСсылкаМенеджера(Вид, ОбъектМетаданных.Имя);
		Если ПустаяСсылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Смв = "";
		Тип = "";
		Код = "";
		УИД = "";
		СтрокаВнутрАнализ(ЗначениеВСтрокуВнутр(ПустаяСсылка), Смв, Тип, Код, УИД);
		Если Не ЗначениеЗаполнено(Код) Тогда
			Продолжить;
		КонецЕсли;

		КодыТипов.Вставить(Код, ОбъектМетаданных.ПолноеИмя());
		Попытка
			КодыТипов.Вставить(Формат(Число(Код), "ЧГ=0"), ОбъектМетаданных.ПолноеИмя());
		Исключение
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Функция ПустаяСсылкаМенеджера(Вид, Имя)

	Если Вид = "Справочник" Тогда
		Возврат Справочники[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Перечисления[Имя].ПустаяСсылка();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ВидМетаданныхДляОтчета(ПолноеИмя)

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Синоним = ОбъектМетаданных.Представление();
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Возврат Синоним + " (" + ПолноеИмя + ")";

КонецФункции

Процедура ЗаполнитьПредставленияИзНижнейБазы(База, ЭлементыЗапроса, ФрагментыЗапроса, Описания)

	Если ЭлементыЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПараметрыБазы = ПараметрыБазыПоСсылке(База);
	Если ПараметрыБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеБазы = КонструкторСтруктурыДанныеБазы();
	ДанныеБазы.База = ПараметрыБазы;
	ДанныеБазы.Соединение = ПолучитьПодключениеHTTPСервер(ПараметрыБазы);
	Если ДанныеБазы.Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Ответ = ЗапросКБазеПриемнику(
			ДанныеБазы,
			"Представления",
			Новый Структура("Элементы", ЭлементыЗапроса),
			ПараметрыБазы.WSИмяБазы + "/hs/sverka/V1/Представления");
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаОтвета Из Ответ Цикл

		Индекс = Неопределено;
		Представление = "";
		Если ТипЗнч(СтрокаОтвета) = Тип("Структура") Тогда
			СтрокаОтвета.Свойство("Индекс", Индекс);
			СтрокаОтвета.Свойство("Представление", Представление);
		ИначеЕсли ТипЗнч(СтрокаОтвета) = Тип("Соответствие") Тогда
			Индекс = СтрокаОтвета.Получить("Индекс");
			Представление = СтрокаОтвета.Получить("Представление");
		Иначе
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Индекс) <> Тип("Число")
			Или Индекс < 0
			Или Индекс >= ФрагментыЗапроса.Количество() Тогда
			Продолжить;
		КонецЕсли;

		Описания[ФрагментыЗапроса[Индекс]].Представление = Строка(Представление);

	КонецЦикла;

КонецПроцедуры

// Формирует JSON-строку отбора для регистрации объекта по ГУИД.
//
// Параметры:
//  ГУИД - Строка - идентификатор объекта в формате xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.
//
// Возвращаемое значение:
//  Строка - JSON вида {"УникальныйИдентификатор":"..."}.
//
Функция КлючРегистрацииОтбор(ГУИД)

	Возврат JSON(Новый Структура("УникальныйИдентификатор", ГУИД), Ложь);

КонецФункции

// Переносит результаты регистрации из ответа базы-источника в таблицу результатов.
//
// Параметры:
//  Ответ - Произвольный - разобранное тело ответа базы-источника;
//  ОписанияЭлементов - Массив из Структура - описания отправленных элементов пакета;
//  ТаблицаРезультата - ТаблицаЗначений - заполняемая таблица результатов.
//
Процедура РазобратьРезультатРегистрации(Ответ, ОписанияЭлементов, ТаблицаРезультата)

	Если ТипЗнч(Ответ) <> Тип("Массив") Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			"База-источник вернула неожиданный ответ регистрации.");
		Возврат;
	КонецЕсли;

	БылоСтрок = ТаблицаРезультата.Количество();
	Для Каждого СтрокаОтвета Из Ответ Цикл

		Индекс = СвойствоОтвета(СтрокаОтвета, "Индекс");
		Если ТипЗнч(Индекс) = Тип("Строка") Тогда
			Попытка
				Индекс = Число(Индекс);
			Исключение
				Индекс = Неопределено;
			КонецПопытки;
		КонецЕсли;
		Описание = Неопределено;
		Если ТипЗнч(Индекс) = Тип("Число")
			И Индекс >= 0
			И Индекс < ОписанияЭлементов.Количество() Тогда
			Описание = ОписанияЭлементов[Индекс];
		КонецЕсли;

		РезультатРегистрации = "Зарегистрирован";
		Если СвойствоОтвета(СтрокаОтвета, "Success") <> Истина Тогда
			РезультатРегистрации = Строка(СвойствоОтвета(СтрокаОтвета, "ErrorText"));
			Если Не ЗначениеЗаполнено(РезультатРегистрации) Тогда
				РезультатРегистрации = "Нижняя база вернула ошибку без текста";
			КонецЕсли;
		КонецЕсли;

		Если Описание = Неопределено Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "", РезультатРегистрации);
			Продолжить;
		КонецЕсли;

		ДобавитьРезультатРегистрации(ТаблицаРезультата, Описание.ПолноеИмяМетаданных,
			Описание.УникальныйИдентификатор, РезультатРегистрации);

	КонецЦикла;

	Если ТаблицаРезультата.Количество() = БылоСтрок Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			СтрШаблон("Нижняя база вернула пустой результат регистрации. Элементов ответа: %1.", Ответ.Количество()));
	КонецЕсли;

КонецПроцедуры

Функция JSON(Данные, СОтступами = Истина)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	Если СОтступами Тогда
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(, "	");
	Иначе
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	КонецЕсли;
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Результат = ЗаписьJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция unJSON(JSONСтрока)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONСтрока);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

// Создает HTTP-соединение с базой-приемником.
//
// Параметры:
//  База - Структура - параметры базы (см. КонструкторСтруктурыБазыДляСинхронизации).
//
// Возвращаемое значение:
//  HTTPСоединение, Неопределено - соединение с базой или Неопределено, если создать соединение не удалось.
//
Функция ПолучитьПодключениеHTTPСервер(База)  

	Попытка
		ЗащищенноеСоединение = Неопределено;
		Если ИспользоватьПараметрПодключения(База.SSL) Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
		КонецЕсли;

		Прокси = Неопределено;
		Если ИспользоватьПараметрПодключения(База.Proxy) Тогда
			Протокол = ?(ЗащищенноеСоединение = Неопределено, "http", "https");
			Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(Протокол);
		КонецЕсли;

		Соединение = Новый HTTPСоединение(
			База.WSИмяСервера, , База.WSИмяПользователя, База.WSПароль, Прокси, , ЗащищенноеСоединение);	
	Исключение 
		Коммментарий = СтрШаблон("Ошибка получения http соединения с базой. Причина: %1", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. ПолучитьПодключениеHTTPСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);  
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции

Функция ИспользоватьПараметрПодключения(Знач Значение)

	Возврат ЗначениеЗаполнено(Значение);

КонецФункции
#КонецОбласти  

#Область ПреобразованияСтрок
 	
Функция СтрокаПустогоЗначения(Знач Тип) 
	Возврат ЗначениеВСтрокуВнутр(ПустоеЗначение(Тип));
КонецФункции

Функция ПустоеЗначение(Знач Тип) 
	
	Если ТипЗнч(Тип) = Тип("Строка") Тогда
		ТипСтр = Тип;
		Тип = Тип(Тип);
	Иначе 
		ТипСтр = XMLТип(Тип).ИмяТипа;
	КонецЕсли;
	
	ТипСтр = СтрРазделить(ТипСтр, ".")[0];
	
	Если ТипСтр = "EnumRef" Тогда
		Возврат XMLЗначение(Тип, "");
	КонецЕсли;
	
	Возврат XMLЗначение(Тип, "00000000-0000-0000-0000-000000000000");
	
КонецФункции

Процедура СтрокаВнутрАнализ(СтрВн, Смв = "", Тип = "", Код = "", УИД = "")
	Смв = ""; Тип = ""; Код = ""; УИД = "";
	
	мСтр = СтрРазделить(Сред(СтрВн, 2, СтрДлина(СтрВн) - 2), ",", Истина);
	КолВо = мСтр.Количество();
	
	Смв = Сред(мСтр[0], 2, 1);
	
	Если КолВо < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Тип = мСтр[1];
	
	Если КолВо < 3 Тогда
		Возврат;
	КонецЕсли;
	
	мКодУИД = СтрРазделить(мСтр[2], ":", Истина);
	Код = мКодУИД[0];
	УИД = мКодУИД[1];
КонецПроцедуры

Функция СтрокаВнутрСинтез(Смв, Тип, Код, УИД)
	Возврат "{"
		+ """" + Смв + """" + ","
		+ Тип + ","
		+ Код + ":"
		+ УИД
		+ "}"
	;
КонецФункции

Функция СтрТипЗнч(ЗнчСтр) 
	Знч = ЗначениеИзСтрокиВнутр(ЗнчСтр);
	Тип = ТипЗнч(Знч);
	Возврат XMLТип(Тип).ИмяТипа;
КонецФункции
#КонецОбласти 

#Область АдаптацияДанных
Функция АдаптироватьHTTP(Знач Зн, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, АдаптироватьHTTP(Стр.Значение, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;
		
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(АдаптироватьHTTP(Стр, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;
		
	Иначе
		Если Тип <> Тип("Строка") Или Лев(Зн, 3) <> "{""#" Тогда
			Возврат Зн;
		КонецЕсли;
		Рез = Зн;
		
		СоответствиеНайдено = Ложь;
		Если НаружуИстинаВнутрьЛожь = Ложь И СоответствияОбъектов <> Неопределено Тогда
			Соо = СоответствияОбъектов.Получить(Рез);
			Если Соо = Неопределено Тогда
				УИДПоиска = "";
				СтрокаВнутрАнализ(Рез, , , , УИДПоиска);
				Если УИДПоиска <> "" Тогда
					Соо = СоответствияОбъектов.Получить(УИДПоиска);
				КонецЕсли;
			КонецЕсли;
			Если Соо <> Неопределено Тогда
				Рез = Соо;
				СоответствиеНайдено = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если СоответствиеНайдено Тогда
			Возврат Рез;
		КонецЕсли;
		
		Смв = ""; ТипУИД = ""; КодУИД = ""; УИД = "";
		СтрокаВнутрАнализ(Рез, Смв, ТипУИД, КодУИД, УИД);
		
		Если Смв = "#" И УИД <> "" Тогда 
			Пустое = Типы.Получить(ТипУИД);
			Если Пустое = Неопределено Тогда
				Если НаружуИстинаВнутрьЛожь = Истина Тогда 
					ТипСтр = СтрТипЗнч(Рез);
				Иначе
					тТипСтр = мТипы.Получить(ТипУИД); 
					Пустое = СтрокаПустогоЗначения(тТипСтр);
				КонецЕсли;
				Типы.Вставить(ТипУИД, Пустое);
			КонецЕсли;
			
			СтрокаВнутрАнализ(Пустое,, ТипУИД, КодУИД, );
			
			Рез = СтрокаВнутрСинтез(Смв, ТипУИД, КодУИД, УИД);
		КонецЕсли;
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция СтуктураВИзСтрокиВнутр(Зн, ВИстинаИзЛожь)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, СтуктураВИзСтрокиВнутр(Стр.Значение, ВИстинаИзЛожь));
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(СтуктураВИзСтрокиВнутр(Стр, ВИстинаИзЛожь));
		КонецЦикла;
	Иначе
		Рез = ?(ВИстинаИзЛожь, ЗначениеВСтрокуВнутр(Зн), ЗначениеИзСтрокиВнутр(Зн));
	КонецЕсли;
	Возврат Рез;
КонецФункции  

Функция СтуктураВИзСтрокиВнутрНорм(Зн)
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Для Каждого мСтр Из Стр Цикл
				Если мСтр = "{""B"",0}" Тогда
					Продолжить;	
				КонецЕсли;
				Рез.Добавить(ЗначениеИзСтрокиВнутр(мСтр));	
			КонецЦикла;
			
		КонецЦикла;
	Возврат Рез;
КонецФункции

#КонецОбласти

#Область СравнениеКлючей
 
Функция ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Индекс, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, Поля = Неопределено, СырыеПоКлючу = Неопределено, ПоляКонтроля = Неопределено, ПоляКлюча = Неопределено)
	Если ДанныеБазы.Отладка Тогда
		СообщениеОтладки("Л " + соЛокал.Количество() + ", В " + соВнешн.Количество()); 
	КонецЕсли;
	соРазница = Новый Соответствие;
	мРазница = Новый Соответствие;  
	мКлючЗаписиРС = Новый Массив;
	ДатаСообщения = ТекущаяДатаСеанса();
		Для Каждого Стр Из соВнешн Цикл
			ГруппаНижняя = Стр.Значение;
			ГруппаВерхняя = соЛокал.Получить(Стр.Ключ);
			СтрокаНижняя = ГруппаНижняя[0];
			Если ГруппаВерхняя = Неопределено Тогда
				мСтр = СтрокаСверкиБезПолейКонтроля(СтрокаНижняя, Поля, ПоляКонтроля, ПоляКлюча);
				СтрокаНабора = НаборЗаписейСообщений.Добавить();
				СтрокаНабора.НомерЗаписи = НаборЗаписейСообщений.Количество();
				СтрокаНабора.Дата = ДатаСообщения;
				СтрокаНабора.База = ДанныеБазы.База.Ссылка;
				СтрокаНабора.Вид = ОбъектМетаданных.Вид;
				СтрокаНабора.Тип = ОбъектМетаданных.Тип;
				СтрокаНабора.Сообщение = СообщитьМассивСтрокуЗн(мСтр, "В<Л", ДанныеБазы.Отладка);
				Если ТипРегистрируетсяПоОтбору(ОбъектМетаданных.Тип) Тогда
					СтрокаНабора.Сообщение = ДобавитьОтборРегистраВСообщение(
						СтрокаНабора.Сообщение, Стр.Ключ, Поля, СырыеПоКлючу, ПоляКлюча);
				КонецЕсли;
				Если Индекс = Неопределено Тогда
				  мКлючЗаписиРС.Добавить(СтрокаНижняя);
				Иначе
				соРазница.Вставить(СтрокаНижняя[Индекс]);
				КонецЕсли;
			ИначеЕсли ПоляКонтроля <> Неопределено И ПоляКонтроля.Количество() > 0 Тогда
				Если ГруппаВерхняя.Количество() = 1 И ГруппаНижняя.Количество() = 1 Тогда
					ДобавитьРасхожденияПолейКонтроля(ГруппаВерхняя[0], СтрокаНижняя, Поля, ПоляКонтроля, ПоляКлюча,
						ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, ДатаСообщения,
						Стр.Ключ, СырыеПоКлючу);
				Иначе
					ДобавитьРасхожденияГруппыПолейКонтроля(ГруппаВерхняя, ГруппаНижняя, Поля, ПоляКонтроля, ПоляКлюча,
						ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, ДатаСообщения,
						Стр.Ключ, СырыеПоКлючу);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	Рез = Новый Массив;
	Для Каждого Стр Из соРазница Цикл
		мСтр = Новый Массив;
		мСтр.Добавить(Стр.Ключ);
		Рез.Добавить(мСтр);
	КонецЦикла; 
	
	Если мКлючЗаписиРС.Количество()>0   Тогда
		 Возврат мКлючЗаписиРС;
	КонецЕсли;
	Если ДанныеБазы.Отладка Тогда
		СообщениеОтладки("Разниц: " + Рез.Количество());
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция ПоляКонтроляСверки(Тип, Вид = "", ПоляКлюча = Неопределено)

	Поля = Новый Массив;
	МетаданныеОбъекта = МетаданныеОбъектаСверки(Тип, Вид);
	Если Тип = "Документы" Тогда
		ДобавитьПолеСверки(Поля, "Проведен");
		ДобавитьПолеСверки(Поля, "Дата");
		ДобавитьПолеСверки(Поля, "ПометкаУдаления");
		Если МетаданныеОбъекта = Неопределено Или МетаданныеОбъекта.ДлинаНомера > 0 Тогда
			ДобавитьПолеСверки(Поля, "Номер");
		КонецЕсли;
		Если МетаданныеОбъекта <> Неопределено И МетаданныеОбъекта.Реквизиты.Найти("Организация") <> Неопределено Тогда
			ДобавитьПолеСверки(Поля, "Организация");
		КонецЕсли;
	ИначеЕсли Тип = "Справочники" Или Тип = "ПланыВидовХарактеристик" Тогда
		ДобавитьПолеСверки(Поля, "ПометкаУдаления");
		Если МетаданныеОбъекта <> Неопределено Тогда
			Если МетаданныеОбъекта.ДлинаНаименования > 0 Тогда
				ДобавитьПолеСверки(Поля, "Наименование");
			КонецЕсли;
			Если МетаданныеОбъекта.ДлинаКода > 0 Тогда
				ДобавитьПолеСверки(Поля, "Код");
			КонецЕсли;
			Если МетаданныеОбъекта.Иерархический Тогда
				ДобавитьПолеСверки(Поля, "Родитель");
			КонецЕсли;
			Если Тип = "Справочники" И МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
				ДобавитьПолеСверки(Поля, "Владелец");
			КонецЕсли;
			Если Тип = "ПланыВидовХарактеристик" Тогда
				ДобавитьПолеСверки(Поля, "ТипЗначения");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Тип = "РегистрыСведений" И МетаданныеОбъекта <> Неопределено Тогда
		Для Каждого Измерение Из МетаданныеОбъекта.Измерения Цикл
			ДобавитьПолеСверки(Поля, Измерение.Имя);
		КонецЦикла;
		ДобавитьРеквизитыРегистраВКонтроль(Поля, МетаданныеОбъекта.Ресурсы);
		ДобавитьРеквизитыРегистраВКонтроль(Поля, МетаданныеОбъекта.Реквизиты);
	ИначеЕсли Тип = "РегистрыНакопления" И МетаданныеОбъекта <> Неопределено Тогда
		ДобавитьПолеСверки(Поля, "Активность");
		ДобавитьПолеСверки(Поля, "Период");
		Для Каждого Измерение Из МетаданныеОбъекта.Измерения Цикл
			ДобавитьПолеСверки(Поля, Измерение.Имя);
		КонецЦикла;
		ДобавитьРеквизитыРегистраВКонтроль(Поля, МетаданныеОбъекта.Ресурсы);
		ДобавитьРеквизитыРегистраВКонтроль(Поля, МетаданныеОбъекта.Реквизиты);
	ИначеЕсли Тип = "РегистрыРасчета" И МетаданныеОбъекта <> Неопределено Тогда
		ДобавитьПоляКонтроляРегистраРасчета(Поля, МетаданныеОбъекта);
	ИначеЕсли Тип = "Последовательности" И МетаданныеОбъекта <> Неопределено Тогда
		ДобавитьПоляКонтроляПоследовательности(Поля, МетаданныеОбъекта);
	КонецЕсли;

	ИсключитьПоляКлючаСверки(Поля, ПоляКлюча);
	Возврат Поля;

КонецФункции

Функция СтрокаСверкиБезПолейКонтроля(СтрокаЗначений, Поля, ПоляКонтроля, ПоляКлюча = Неопределено)

	Если ПоляКонтроля = Неопределено Или Поля = Неопределено Или ПоляКонтроля.Количество() = 0 Тогда
		Возврат СтрокаЗначений;
	КонецЕсли;

	Результат = Новый Массив;
	Индекс = 0;
	Для Каждого ЗначениеПоля Из СтрокаЗначений Цикл
		ИмяПоля = "";
		Если Индекс < Поля.Количество() Тогда
			ИмяПоля = Поля[Индекс];
		КонецЕсли;
		ПолеВКлюче = ПоляКлюча <> Неопределено И ПоляКлюча.Найти(ИмяПоля) <> Неопределено;
		Если ПоляКонтроля.Найти(ИмяПоля) = Неопределено Или ПолеВКлюче Тогда
			Результат.Добавить(ЗначениеПоля);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьРасхожденияПолейКонтроля(СтрокаВерхняя, СтрокаНижняя, Поля, ПоляКонтроля, ПоляКлюча, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, ДатаСообщения, Ключ = Неопределено, СырыеПоКлючу = Неопределено)

	Если ПоляКонтроля = Неопределено Или Поля = Неопределено Или ПоляКонтроля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Отличия = Новый Массив;
	Для Каждого ИмяПоля Из ПоляКонтроля Цикл
		ИндексПоля = Поля.Найти(ИмяПоля);
		Если ИндексПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеВерхнее = ЗначениеСтрокиСверки(СтрокаВерхняя, ИндексПоля);
		ЗначениеНижнее = ЗначениеСтрокиСверки(СтрокаНижняя, ИндексПоля);
		Если ЗначенияСверкиРавны(ЗначениеВерхнее, ЗначениеНижнее) Тогда
			Продолжить;
		КонецЕсли;
		Отличия.Добавить(ТекстОтличияПоляСверки(ИмяПоля, ЗначениеВерхнее, ЗначениеНижнее));
	КонецЦикла;

	Если Отличия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Представление = ПредставлениеСтрокиСверки(СтрокаСверкиБезПолейКонтроля(СтрокаНижняя, Поля, ПоляКонтроля, ПоляКлюча));
	ЗаписатьСообщениеРасхожденияСверки(Отличия, Представление, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, ДатаСообщения,
		Ключ, Поля, СырыеПоКлючу, ПоляКлюча);

КонецПроцедуры

Процедура ДобавитьРасхожденияГруппыПолейКонтроля(ГруппаВерхняя, ГруппаНижняя, Поля, ПоляКонтроля, ПоляКлюча, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, ДатаСообщения, Ключ = Неопределено, СырыеПоКлючу = Неопределено)

	Отличия = Новый Массив;
	Если ГруппаВерхняя.Количество() <> ГруппаНижняя.Количество() Тогда
		Отличия.Добавить(СтрШаблон("КоличествоЗаписей: верх %1, низ %2",
			ГруппаВерхняя.Количество(), ГруппаНижняя.Количество()));
	КонецЕсли;

	Для Каждого ИмяПоля Из ПоляКонтроля Цикл
		ИндексПоля = Поля.Найти(ИмяПоля);
		Если ИндексПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если МультимножестваСверкиРавны(ГруппаВерхняя, ГруппаНижняя, ИндексПоля) Тогда
			Продолжить;
		КонецЕсли;
		Отличия.Добавить(СтрШаблон("%1: верх %2, низ %3", ИмяПоля,
			ПредставлениеМультимножестваСверки(ГруппаВерхняя, ИндексПоля),
			ПредставлениеМультимножестваСверки(ГруппаНижняя, ИндексПоля)));
	КонецЦикла;

	Если Отличия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Представление = ПредставлениеСтрокиСверки(СтрокаСверкиБезПолейКонтроля(ГруппаНижняя[0], Поля, ПоляКонтроля, ПоляКлюча));
	ЗаписатьСообщениеРасхожденияСверки(Отличия, Представление, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, ДатаСообщения,
		Ключ, Поля, СырыеПоКлючу, ПоляКлюча);

КонецПроцедуры

Процедура ЗаписатьСообщениеРасхожденияСверки(Отличия, Представление, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений, ДатаСообщения, Ключ = Неопределено, Поля = Неопределено, СырыеПоКлючу = Неопределено, ПоляКлюча = Неопределено)

	ОграничитьСписокОтличий(Отличия, 12);
	Заголовок = "В<>Л|" + СтрСоединить(Отличия, "; ") + "|";
	ТекстСообщения = Заголовок + Представление;
	Если СтрДлина(ТекстСообщения) > 1000 Тогда
		Доступно = 1000 - СтрДлина(Заголовок);
		Если Доступно < 1 Тогда
			ТекстСообщения = Лев(Заголовок, 1000);
		Иначе
			ТекстСообщения = Заголовок + Лев(Представление, Доступно);
		КонецЕсли;
	КонецЕсли;

	СтрокаНабора = НаборЗаписейСообщений.Добавить();
	СтрокаНабора.НомерЗаписи = НаборЗаписейСообщений.Количество();
	СтрокаНабора.Дата = ДатаСообщения;
	СтрокаНабора.База = ДанныеБазы.База.Ссылка;
	СтрокаНабора.Вид = ОбъектМетаданных.Вид;
	СтрокаНабора.Тип = ОбъектМетаданных.Тип;
	Если ТипРегистрируетсяПоОтбору(ОбъектМетаданных.Тип) Тогда
		ТекстСообщения = ДобавитьОтборРегистраВСообщение(ТекстСообщения, Ключ, Поля, СырыеПоКлючу, ПоляКлюча);
	КонецЕсли;
	СтрокаНабора.Сообщение = ТекстСообщения;
	Если ДанныеБазы.Отладка Тогда
		СообщениеОтладки(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

Процедура ОграничитьСписокОтличий(Отличия, Предел)

	Если Отличия.Количество() <= Предел Тогда
		Возврат;
	КонецЕсли;

	Пока Отличия.Количество() > Предел Цикл
		Отличия.Удалить(Отличия.Количество() - 1);
	КонецЦикла;
	Отличия.Добавить("...");

КонецПроцедуры

Функция ТекстОтличияПоляСверки(ИмяПоля, ЗначениеВерхнее, ЗначениеНижнее)

	Возврат СтрШаблон("%1: верх %2, низ %3", ИмяПоля,
		ПредставлениеОтличияСверки(ЗначениеВерхнее), ПредставлениеОтличияСверки(ЗначениеНижнее));

КонецФункции

Функция ЗначенияСверкиРавны(ЗначениеВерхнее, ЗначениеНижнее)

	Если ЗначениеВерхнее = ЗначениеНижнее Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат КлючСравненияЗначенияСверки(ЗначениеВерхнее) = КлючСравненияЗначенияСверки(ЗначениеНижнее);

КонецФункции

Функция КлючСравненияЗначенияСверки(ВнутренняяСтрока)

	Значение = ЗначениеСверкиИзСтроки(ВнутренняяСтрока);
	Если ЭтоПустоеЗначениеСверки(Значение) Тогда
		Возврат "#пусто";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "E|" + Строка(ТипЗначения) + "|" + Строка(Значение);
	КонецЕсли;
	Если ЭтоСсылкаСверки(ТипЗначения) Тогда
		Возврат "R|" + Строка(ТипЗначения) + "|" + Строка(Значение.УникальныйИдентификатор());
	КонецЕсли;
	Если ТипЗначения = Тип("Число") Тогда
		Возврат "N|" + Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
	КонецЕсли;
	Если ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "B|1", "B|0");
	КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат "D|" + Формат(Значение, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "S|" + Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат "U|" + Строка(Значение);
	КонецЕсли;

	Возврат "X|" + Строка(ВнутренняяСтрока);

КонецФункции

Функция ЗначениеСверкиИзСтроки(ВнутренняяСтрока)

	Если ВнутренняяСтрока = Неопределено Или ВнутренняяСтрока = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ВнутренняяСтрока) <> Тип("Строка") Тогда
		Возврат ВнутренняяСтрока;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВнутренняяСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ЗначениеИзСтрокиВнутр(ВнутренняяСтрока);
	Исключение
		Возврат ВнутренняяСтрока;
	КонецПопытки;

КонецФункции

Функция ЭтоПустоеЗначениеСверки(Значение)

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И ПустаяСтрока(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЭтоСсылкаСверки(ТипЗнч(Значение)) И Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ЭтоСсылкаСверки(ТипЗначения)

	Попытка
		Возврат ОбщегоНазначения.ЭтоСсылка(ТипЗначения);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ПредставлениеОтличияСверки(ВнутренняяСтрока)

	Значение = ЗначениеСверкиИзСтроки(ВнутренняяСтрока);
	Если ЭтоПустоеЗначениеСверки(Значение) Тогда
		Возврат "пусто";
	КонецЕсли;

	Представление = ПредставлениеЗначенияСверки(ВнутренняяСтрока);
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Возврат "пусто";
	КонецЕсли;

	Возврат Представление;

КонецФункции

Функция МультимножестваСверкиРавны(ГруппаЛевая, ГруппаПравая, ИндексПоля)

	Левые = КлючиМультимножестваСверки(ГруппаЛевая, ИндексПоля);
	Правые = КлючиМультимножестваСверки(ГруппаПравая, ИндексПоля);
	Если Левые.Количество() <> Правые.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 0 По Левые.Количество() - 1 Цикл
		Если Левые[Индекс] <> Правые[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция КлючиМультимножестваСверки(Группа, ИндексПоля)

	Список = Новый СписокЗначений;
	Для Каждого СтрокаГруппы Из Группа Цикл
		Список.Добавить(КлючСравненияЗначенияСверки(ЗначениеСтрокиСверки(СтрокаГруппы, ИндексПоля)));
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Ключи = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Ключи.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Ключи;

КонецФункции

Функция ПредставлениеМультимножестваСверки(Группа, ИндексПоля)

	Список = Новый СписокЗначений;
	Для Каждого СтрокаГруппы Из Группа Цикл
		ЗначениеПоля = ЗначениеСтрокиСверки(СтрокаГруппы, ИндексПоля);
		Список.Добавить(КлючСравненияЗначенияСверки(ЗначениеПоля), ПредставлениеОтличияСверки(ЗначениеПоля));
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Предел = Мин(8, Список.Количество());
	Части = Новый Массив;
	Для Индекс = 0 По Предел - 1 Цикл
		Части.Добавить(Список[Индекс].Представление);
	КонецЦикла;
	Текст = СтрСоединить(Части, "; ");
	Если Список.Количество() > Предел Тогда
		Текст = Текст + " …";
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ЗначениеСтрокиСверки(СтрокаЗначений, ИндексПоля)

	Если СтрокаЗначений = Неопределено Или ИндексПоля >= СтрокаЗначений.Количество() Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрокаЗначений[ИндексПоля];

КонецФункции

Функция ПредставлениеСтрокиСверки(СтрокаЗначений)

	Части = Новый Массив;
	Для Каждого ЗначениеПоля Из СтрокаЗначений Цикл
		Представление = ПредставлениеЗначенияСверки(ЗначениеПоля);
		Если ЗначениеЗаполнено(Представление) Тогда
			Части.Добавить(Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

Функция ПредставлениеЗначенияСверки(ВнутренняяСтрока)

	Если Не ЗначениеЗаполнено(ВнутренняяСтрока) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Значение = ЗначениеИзСтрокиВнутр(ВнутренняяСтрока);
	Исключение
		Возврат Строка(ВнутренняяСтрока);
	КонецПопытки;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция СообщитьМассивСтрокуЗн(Знач мСтр, Пре, Отладка)
	Сооб = "";
	Сооб = Пре + "|";
	Для Каждого Стр Из мСтр Цикл
		Зн = ЗначениеИзСтрокиВнутр(Стр);
				
		Сооб = Сооб
			+ Зн  + ","
			+ "|"
		;
	КонецЦикла;  
	Если Отладка Тогда
		СообщениеОтладки(Сооб);
	КонецЕсли;
	Возврат Сооб;
КонецФункции

Функция ПолучитьКлючиСтр(Внешн, ИндексыКлюча)
	соВнешн = Новый Соответствие;
	Для Каждого Стр Из Внешн Цикл
		Ключ = КлючСтрокиСверки(Стр, ИндексыКлюча);
		Группа = соВнешн.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			соВнешн.Вставить(Ключ, Группа);
		КонецЕсли;
		Группа.Добавить(Стр);
	КонецЦикла;

	Возврат соВнешн;
КонецФункции

Функция КлючСтрокиСверки(Стр, ИндексыКлюча)
	Ключ = "";
	Если ИндексыКлюча = Неопределено Тогда
		Для Каждого Зн Из Стр Цикл
			Ключ = Ключ + Зн + ",";
		КонецЦикла;
		Возврат Ключ;
	КонецЕсли;
	Для Каждого Индекс Из ИндексыКлюча Цикл
		Если Индекс < Стр.Количество() Тогда
			Ключ = Ключ + Стр[Индекс] + ",";
		КонецЕсли;
	КонецЦикла;
	Возврат Ключ;
КонецФункции

Функция СырыеСтрокиПоКлючу(Адаптированные, Сырые, ИндексыКлюча)
	Результат = Новый Соответствие;
	ИндексСтроки = 0;
	Для Каждого Стр Из Адаптированные Цикл
		Если ИндексСтроки < Сырые.Количество() Тогда
			Ключ = КлючСтрокиСверки(Стр, ИндексыКлюча);
			Группа = Результат.Получить(Ключ);
			Если Группа = Неопределено Тогда
				Группа = Новый Массив;
				Результат.Вставить(Ключ, Группа);
			КонецЕсли;
			Группа.Добавить(Сырые[ИндексСтроки]);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДобавитьОтборРегистраВСообщение(ТекстСообщения, Ключ, Поля, СырыеПоКлючу, ПоляКлюча = Неопределено)
	Если СырыеПоКлючу = Неопределено Или Поля = Неопределено Тогда
		Возврат ТекстСообщения;
	КонецЕсли;
	Группа = СырыеПоКлючу.Получить(Ключ);
	Если Группа = Неопределено Тогда
		Возврат ТекстСообщения;
	КонецЕсли;
	ИменаОтбора = Поля;
	Если ПоляКлюча <> Неопределено И ПоляКлюча.Количество() > 0 Тогда
		ИменаОтбора = ПоляКлюча;
	КонецЕсли;
	Отборы = Новый Массив;
	УжеДобавлены = Новый Соответствие;
	Для Каждого СыраяСтрока Из СтрокиСырогоКлюча(Группа) Цикл
		Отбор = ОтборКлючаИзСыройСтроки(СыраяСтрока, Поля, ИменаОтбора);
		Если Отбор.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ТекстОтбора = JSON(Отбор, Ложь);
		Если УжеДобавлены.Получить(ТекстОтбора) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавлены.Вставить(ТекстОтбора, Истина);
		Отборы.Добавить(Отбор);
	КонецЦикла;
	Если Отборы.Количество() = 0 Тогда
		Возврат ТекстСообщения;
	КонецЕсли;
	ТелоОтбора = ?(Отборы.Количество() = 1, JSON(Отборы[0], Ложь), JSON(Отборы, Ложь));
	Суффикс = Символы.ПС + "#ОТБОР#" + ТелоОтбора;
	Если СтрДлина(ТекстСообщения) + СтрДлина(Суффикс) > 1000 Тогда
		Доступно = 1000 - СтрДлина(Суффикс);
		Если Доступно < 1 Тогда
			Возврат Лев(Суффикс, 1000);
		КонецЕсли;
		Возврат Лев(ТекстСообщения, Доступно) + Суффикс;
	КонецЕсли;
	Возврат ТекстСообщения + Суффикс;
КонецФункции

Функция ОтборРегистраИзСообщения(ТекстСообщения)
	Маркер = "#ОТБОР#";
	Позиция = СтрНайти(ТекстСообщения, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(ТекстСообщения, Позиция + СтрДлина(Маркер));
КонецФункции

Функция СтрокиСырогоКлюча(Значение)

	Результат = Новый Массив;
	Если ТипЗнч(Значение) <> Тип("Массив") Или Значение.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение[0]) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

Функция ОтборКлючаИзСыройСтроки(СыраяСтрока, Поля, ИменаОтбора)

	Отбор = Новый Структура;
	Если ТипЗнч(СыраяСтрока) <> Тип("Массив") Тогда
		Возврат Отбор;
	КонецЕсли;
	Для Каждого ИмяПоля Из ИменаОтбора Цикл
		ИндексПоля = Поля.Найти(ИмяПоля);
		Если ИндексПоля = Неопределено Или ИндексПоля >= СыраяСтрока.Количество() Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Отбор.Вставить(ИмяПоля, СыраяСтрока[ИндексПоля]);
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Отбор;

КонецФункции

Функция ОтборыРегистрацииИзСообщения(ТекстСообщения)

	Результат = Новый Массив;
	ТекстОтбора = ОтборРегистраИзСообщения(ТекстСообщения);
	Если Не ЗначениеЗаполнено(ТекстОтбора) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = unJSON(ТекстОтбора);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Для Каждого Элемент Из Данные Цикл
			Если ТипЗнч(Элемент) = Тип("Структура") Или ТипЗнч(Элемент) = Тип("Соответствие") Тогда
				Результат.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Или ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Результат.Добавить(Данные);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЗначениеОтбораРегистрации(Отбор, ИмяПоля)

	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Отбор.Свойство(ИмяПоля, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Отбор) = Тип("Соответствие") Тогда
		Возврат Отбор.Получить(ИмяПоля);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьЭлементПакетаРегистрации(ПолноеИмя, ВидДанных, ТекстОтбора, УжеВПакете, ЭлементыПакета, ОписанияЭлементов)

	КлючПакета = ПолноеИмя + "|" + ТекстОтбора;
	Если УжеВПакете.Получить(КлючПакета) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	УжеВПакете.Вставить(КлючПакета, Истина);
	ЭлементПакета = Новый Структура;
	ЭлементПакета.Вставить("ПолноеИмяМетаданных", ПолноеИмя);
	ЭлементПакета.Вставить("ВидДанныхДляРегистрации", ВидДанных);
	ЭлементПакета.Вставить("КлючРегистрацииОтбор", ТекстОтбора);
	ЭлементыПакета.Добавить(ЭлементПакета);
	ОписанияЭлементов.Добавить(Новый Структура(
		"ПолноеИмяМетаданных, УникальныйИдентификатор", ПолноеИмя, ПолноеИмя));

КонецПроцедуры

Функция ДобавитьРегистрациюПоОтборуСообщения(Тип, Вид, ТекстСообщения, УжеВПакете, ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата)

	Отборы = ОтборыРегистрацииИзСообщения(ТекстСообщения);
	Если Отборы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидДанныхСсылки = ВидДанныхДляРегистрации(Тип);
	ВидДанныхРегистра = ВидДанныхРегистраДляПакета(Тип);
	Если ВидДанныхСсылки = "" И ВидДанныхРегистра = "" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВидДанныхСсылки <> "" Тогда
		ПолноеИмя = ИмяОбъектаМетаданных(Тип, Вид);
		ВидДанных = ВидДанныхСсылки;
	Иначе
		ПолноеИмя = ПолноеИмяРегистраДляПакета(Тип, Вид);
		ВидДанных = ВидДанныхРегистра;
	КонецЕсли;

	Для Каждого Отбор Из Отборы Цикл
		Если ВидДанныхСсылки <> "" И Не ЗначениеЗаполнено(ЗначениеОтбораРегистрации(Отбор, "Ссылка"))
			И Не ЗначениеЗаполнено(ЗначениеОтбораРегистрации(Отбор, "УникальныйИдентификатор")) Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, ПолноеИмя, "",
				"В сообщении нет ссылки объекта. Повторите проверку синхронизации.");
			Продолжить;
		КонецЕсли;
		Если ВидДанныхРегистра <> "" И Не ЗначениеЗаполнено(ЗначениеОтбораРегистрации(Отбор, "Регистратор")) Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, ПолноеИмя, "",
				"В сообщении нет регистратора. Повторите проверку синхронизации.");
			Продолжить;
		КонецЕсли;
		ДобавитьЭлементПакетаРегистрации(ПолноеИмя, ВидДанных, JSON(Отбор, Ложь),
			УжеВПакете, ЭлементыПакета, ОписанияЭлементов);
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ДобавитьРегистрСведенийВПакет(Вид, ТекстСообщения, УжеВПакете, ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата)
	ПолноеИмя = "РегистрСведений." + Вид;
	Отборы = ОтборыРегистрацииИзСообщения(ТекстСообщения);
	Если Отборы.Количество() = 0 Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, ПолноеИмя, "",
			"В сообщении нет ключа записи регистра. Повторите проверку синхронизации.");
		Возврат;
	КонецЕсли;
	Для Каждого Отбор Из Отборы Цикл
		ДобавитьЭлементПакетаРегистрации(ПолноеИмя, "InformationRegister", JSON(Отбор, Ложь),
			УжеВПакете, ЭлементыПакета, ОписанияЭлементов);
	КонецЦикла;
КонецПроцедуры
#КонецОбласти    

#Область МетаданныеЗапросы
 
Функция ОбъектыВыборкаОтбор(ОбъектМетаданных) 
	
	Рез = Новый Структура("Тип, Вид", ОбъектМетаданных.Тип, ОбъектМетаданных.Вид);
	
	Если ОбъектМетаданных.Тип = "Справочники" Тогда
		ТипЗапрос = "Справочник";
	ИначеЕсли ОбъектМетаданных.Тип = "Документы" Тогда
		ТипЗапрос = "Документ";
	ИначеЕсли ОбъектМетаданных.Тип = "РегистрыСведений" Тогда
		ТипЗапрос = "РегистрСведений";
	ИначеЕсли ОбъектМетаданных.Тип = "РегистрыНакопления" Тогда
		ТипЗапрос = "РегистрНакопления";
	ИначеЕсли ОбъектМетаданных.Тип = "ПланыВидовХарактеристик" Тогда
		ТипЗапрос = "ПланВидовХарактеристик";
	ИначеЕсли ОбъектМетаданных.Тип = "Последовательности" Тогда
		ТипЗапрос = "Последовательность";
	ИначеЕсли ОбъектМетаданных.Тип = "РегистрыРасчета" Тогда
		ТипЗапрос = "РегистрРасчета";
	КонецЕсли;
	
	СтандартныеПоля = МДИзмерения(ОбъектМетаданных.Тип, ОбъектМетаданных.Вид);
	ПоляКлюча = ПоляКлючаСверки(ОбъектМетаданных, СтандартныеПоля);
	мИзмерения = ПоляЗапросаСверки(СтандартныеПоля, ПоляКлюча);
	Рез.Вставить("Поля", СтандартныеПоля);
	Рез.Вставить("ПоляКлюча", ПоляКлюча);
	Рез.Вставить("ПроецироватьРезультат", мИзмерения.Количество() <> СтандартныеПоля.Количество());
	ПоляКонтроля = ПоляКонтроляСверки(ОбъектМетаданных.Тип, ОбъектМетаданных.Вид, ПоляКлюча);
	Для Каждого ИмяПоля Из ПоляКонтроля Цикл
		Если мИзмерения.Найти(ИмяПоля) = Неопределено Тогда
			мИзмерения.Добавить(ИмяПоля);
			Рез.ПроецироватьРезультат = Истина;
		КонецЕсли;
	КонецЦикла;
	Рез.Вставить("ПоляКонтроля", ПоляКонтроля);
	
	ЗапросТекст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	" + ?(мИзмерения.Количество() = 0, "1 КАК ПолеВыборки", СтрСоединить(мИзмерения, ", ")) + "
		|ИЗ
		|	" + ТипЗапрос + "." + ОбъектМетаданных.Вид + "
		|";
	
	ЗапросПараметры = Новый Структура;
	ЗапросТекст = ЗапросТекст + ЗапросУсловие(ОбъектМетаданных);
	
	Рез.Вставить("мИзмерения", мИзмерения);
	Рез.Вставить("ЗапросТекст", ЗапросТекст);
	Возврат Рез;
КонецФункции

Функция ПоляКлючаСверки(ОбъектМетаданных, СтандартныеПоля)

	ОсновныеПоля = ПоляИзСпискаСверки(ЗначениеСпискаПолейСверки(ОбъектМетаданных, "ОсновныеПоляДляСверки"));
	Если ОсновныеПоля.Количество() > 0 Тогда
		Возврат ОсновныеПоля;
	КонецЕсли;

	ПоляКлюча = СкопироватьИменаПолей(СтандартныеПоля);
	Для Каждого ИмяПоля Из ПоляИзСпискаСверки(ЗначениеСпискаПолейСверки(ОбъектМетаданных, "ДополнительныеПоляДляСверки")) Цикл
		Если ПоляКлюча.Найти(ИмяПоля) = Неопределено Тогда
			ПоляКлюча.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоляКлюча;

КонецФункции

Функция ПоляЗапросаСверки(СтандартныеПоля, ПоляКлюча)

	ПоляЗапроса = СкопироватьИменаПолей(СтандартныеПоля);
	Для Каждого ИмяПоля Из ПоляКлюча Цикл
		Если ПоляЗапроса.Найти(ИмяПоля) = Неопределено Тогда
			ПоляЗапроса.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоляЗапроса;

КонецФункции

Функция ЗначениеСпискаПолейСверки(ОбъектМетаданных, ИмяПоля)

	Если ТипЗнч(ОбъектМетаданных) <> Тип("Структура") Или Не ОбъектМетаданных.Свойство(ИмяПоля) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ОбъектМетаданных[ИмяПоля];

КонецФункции

Функция ПоляИзСпискаСверки(ТекстПолей)

	Поля = Новый Массив;
	Если Не ЗначениеЗаполнено(ТекстПолей) Тогда
		Возврат Поля;
	КонецЕсли;

	Текст = СтрЗаменить(Строка(ТекстПолей), ";", ",");
	Текст = СтрЗаменить(Текст, Символы.ПС, ",");
	Текст = СтрЗаменить(Текст, Символы.ВК, ",");
	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(Часть);
		Если Не ИмяПоляЗапросаДопустимо(ИмяПоля) Или Поля.Найти(ИмяПоля) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поля.Добавить(ИмяПоля);
	КонецЦикла;

	Возврат Поля;

КонецФункции

Функция ИмяПоляЗапросаДопустимо(ИмяПоля)

	Части = СтрРазделить(ИмяПоля, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Часть Из Части Цикл
		Если Не ИдентификаторПоляЗапроса(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ИдентификаторПоляЗапроса(Имя)

	Длина = СтрДлина(Имя);
	Если Длина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Номер = 1 По Длина Цикл
		Символ = Сред(Имя, Номер, 1);
		Код = КодСимвола(Символ);
		Буква = (Код >= 65 И Код <= 90)
			Или (Код >= 97 И Код <= 122)
			Или (Код >= 1040 И Код <= 1103)
			Или Код = 1025
			Или Код = 1105
			Или Символ = "_";
		Цифра = Код >= 48 И Код <= 57;
		Если Номер = 1 И Не Буква Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Не Буква И Не Цифра Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СкопироватьИменаПолей(Поля)

	Копия = Новый Массив;
	Для Каждого ИмяПоля Из Поля Цикл
		Копия.Добавить(ИмяПоля);
	КонецЦикла;

	Возврат Копия;

КонецФункции

Функция ИндексыКлючаСверки(ПоляЗапроса, Рез)

	ПоляКлюча = ПоляЗапроса;
	Если Рез.Свойство("ПоляКлюча") И ТипЗнч(Рез.ПоляКлюча) = Тип("Массив") И Рез.ПоляКлюча.Количество() > 0 Тогда
		ПоляКлюча = Рез.ПоляКлюча;
	КонецЕсли;

	Индексы = ИндексыПолей(ПоляЗапроса, ПоляКлюча, Истина);
	Если Индексы.Количество() = 0 Тогда
		Возврат ИндексыПолей(ПоляЗапроса, ПоляЗапроса, Истина);
	КонецЕсли;

	Возврат Индексы;

КонецФункции

Функция ИндексыПолей(ПоляЗапроса, ИменаПолей, ПропуститьИдентификаторЗаписи = Ложь)

	Индексы = Новый Массив;
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если ПропуститьИдентификаторЗаписи И ИмяПоля = "ИдентификаторЗаписи" Тогда
			Продолжить;
		КонецЕсли;
		Индекс = ПоляЗапроса.Найти(ИмяПоля);
		Если Индекс <> Неопределено Тогда
			Индексы.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Возврат Индексы;

КонецФункции

Функция СтрокиПоИндексам(Строки, Индексы)

	Результат = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		НоваяСтрока = Новый Массив;
		Для Каждого Индекс Из Индексы Цикл
			Если Индекс < Стр.Количество() Тогда
				НоваяСтрока.Добавить(Стр[Индекс]);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(НоваяСтрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МетаданныеОбъектаСверки(Тип, Вид)

	Если Не ЗначениеЗаполнено(Тип) Или Не ЗначениеЗаполнено(Вид) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Метаданные[Тип][Вид];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ДобавитьПолеСверки(Поля, ИмяПоля)

	Если Не ЗначениеЗаполнено(ИмяПоля) Или Поля.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ИмяПоляЗапросаДопустимо(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	Поля.Добавить(ИмяПоля);

КонецПроцедуры

Процедура ИсключитьПоляКлючаСверки(Поля, ПоляКлюча)

	Если ПоляКлюча = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Индекс = Поля.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ПоляКлюча.Найти(Поля[Индекс]) <> Неопределено Тогда
			Поля.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьСтандартныйРеквизитСверки(МетаданныеОбъекта, Имя)

	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПолеСлужебноеДляСверки(ИмяПоля)

	Возврат ИмяПоля = "ИдентификаторСтроки" Или ИмяПоля = "НомерСтроки";

КонецФункции

Процедура ДобавитьРеквизитыРегистраВКонтроль(Поля, Коллекция)

	Для Каждого Реквизит Из Коллекция Цикл
		Если ПолеСлужебноеДляСверки(Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПолеСверки(Поля, Реквизит.Имя);
	КонецЦикла;

КонецПроцедуры

Функция ПоляКлючаРегистраРасчета(МетаданныеРегистра)

	Поля = Новый Массив;
	ДобавитьПолеСверки(Поля, "Регистратор");
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		ДобавитьПолеСверки(Поля, Измерение.Имя);
	КонецЦикла;
	ДобавитьПолеСверки(Поля, "ВидРасчета");

	Возврат Поля;

КонецФункции

Функция ПоляКлючаПоследовательности(Вид)

	Поля = Новый Массив;
	МетаданныеПоследовательности = МетаданныеОбъектаСверки("Последовательности", Вид);
	Если МетаданныеПоследовательности = Неопределено Тогда
		ДобавитьПолеСверки(Поля, "Регистратор");
		ДобавитьПолеСверки(Поля, "Период");
		Возврат Поля;
	КонецЕсли;

	Для Каждого Измерение Из МетаданныеПоследовательности.Измерения Цикл
		ДобавитьПолеСверки(Поля, Измерение.Имя);
	КонецЦикла;
	Если ЕстьСтандартныйРеквизитСверки(МетаданныеПоследовательности, "Регистратор") Тогда
		ДобавитьПолеСверки(Поля, "Регистратор");
	КонецЕсли;
	Если ЕстьСтандартныйРеквизитСверки(МетаданныеПоследовательности, "Период") Тогда
		ДобавитьПолеСверки(Поля, "Период");
	КонецЕсли;
	Если ЕстьСтандартныйРеквизитСверки(МетаданныеПоследовательности, "МоментВремени") Тогда
		ДобавитьПолеСверки(Поля, "МоментВремени");
	КонецЕсли;
	Если Поля.Количество() = 0 Тогда
		ДобавитьПолеСверки(Поля, "Регистратор");
	КонецЕсли;

	Возврат Поля;

КонецФункции

Процедура ДобавитьПоляКонтроляРегистраРасчета(Поля, МетаданныеРегистра)

	ДобавитьРеквизитыРегистраВКонтроль(Поля, МетаданныеРегистра.Ресурсы);
	ДобавитьРеквизитыРегистраВКонтроль(Поля, МетаданныеРегистра.Реквизиты);
	ДобавитьПолеСверки(Поля, "ПериодРегистрации");
	Если РегистрРасчетаИспользуетСвойство(МетаданныеРегистра, "ПериодДействия") Тогда
		ДобавитьПолеСверки(Поля, "ПериодДействия");
		ДобавитьПолеСверки(Поля, "ПериодДействияНачало");
		ДобавитьПолеСверки(Поля, "ПериодДействияКонец");
	КонецЕсли;
	Если РегистрРасчетаИспользуетСвойство(МетаданныеРегистра, "БазовыйПериод") Тогда
		ДобавитьПолеСверки(Поля, "БазовыйПериодНачало");
		ДобавитьПолеСверки(Поля, "БазовыйПериодКонец");
	КонецЕсли;
	Если ЕстьСтандартныйРеквизитСверки(МетаданныеРегистра, "Сторно") Тогда
		ДобавитьПолеСверки(Поля, "Сторно");
	КонецЕсли;

КонецПроцедуры

Функция РегистрРасчетаИспользуетСвойство(МетаданныеРегистра, ИмяСвойства)

	Попытка
		Возврат МетаданныеРегистра[ИмяСвойства] = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ДобавитьПоляКонтроляПоследовательности(Поля, МетаданныеПоследовательности)

	Если МетаданныеПоследовательности.Измерения.Найти("СостояниеПроведения") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьСтандартныйРеквизитСверки(МетаданныеПоследовательности, "СостояниеПроведения") Тогда
		ДобавитьПолеСверки(Поля, "СостояниеПроведения");
	КонецЕсли;

КонецПроцедуры

Функция МДИзмерения(Тип, Вид)

	мИзмерения = Новый Массив;
	
	Если Тип = "Константы" Тогда
	ИначеЕсли Тип = "Справочники" Или Тип = "Документы" Или Тип = "ПланыВидовХарактеристик" Тогда
		
		мИзмерения.Добавить("Ссылка");
		
	ИначеЕсли Тип = "РегистрыСведений" Тогда
			МД = Метаданные[Тип][Вид];
			Независимый = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		
		Для Каждого ТекИзм Из МД.Измерения Цикл
			Если Тип = "РегистрыСведений" И Не ТекИзм.ОсновнойОтбор Тогда
				Продолжить;
			КонецЕсли;
			мИзмерения.Добавить(ТекИзм.Имя);
		КонецЦикла;
		
		Если Не МД.РежимЗаписи = Независимый Тогда
			мИзмерения.Добавить("Регистратор");
		КонецЕсли;
		Если МД.ПериодичностьРегистраСведений <> Непериодический Тогда
			мИзмерения.Добавить("Период");
		КонецЕсли;

		Если мИзмерения.Количество() = 0 Тогда
			Для Каждого ТекИзм Из МД.Измерения Цикл
				мИзмерения.Добавить(ТекИзм.Имя);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		// НомерСтроки при загрузке движений не переносится и присваивается платформой заново.
		мИзмерения.Добавить("Регистратор");
		
	ИначеЕсли Тип = "РегистрыРасчета" Тогда
		МД = МетаданныеОбъектаСверки(Тип, Вид);
		Если МД = Неопределено Тогда
			мИзмерения.Добавить("Регистратор");
		Иначе
			мИзмерения = ПоляКлючаРегистраРасчета(МД);
		КонецЕсли;
		
	ИначеЕсли Тип = "Последовательности" Тогда
		мИзмерения = ПоляКлючаПоследовательности(Вид);
		
	КонецЕсли;

	Возврат мИзмерения;
КонецФункции

Функция ЗапросУсловие(ОбъектМетаданных)
	Поле = "";
	Если ЗначениеЗаполнено(ОбъектМетаданных.ПолеОрганизации) Тогда
		Поле = СокрЛП(Строка(ОбъектМетаданных.ПолеОрганизации));
	ИначеЕсли ОбъектМетаданных.Тип = "РегистрыРасчета" И ОбъектМетаданных.Вид = "Начисления" Тогда
		Поле = "ГоловнаяОрганизация";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Поле) Или Не ИмяПоляЗапросаДопустимо(Поле) Тогда
		Возврат "";
	КонецЕсли;
	Если ОбъектМетаданных.Тип = "РегистрыРасчета" И Поле = "ГоловнаяОрганизация" Тогда
		Возврат " ГДЕ ГоловнаяОрганизация В ИЕРАРХИИ (&Организация)" + Символы.ПС;
	КонецЕсли;
	Возврат " "
			+ "ГДЕ" + Символы.ПС
			+ СтрШаблон("%1 = &Организация", Поле)
			+ Символы.ПС;
КонецФункции
#КонецОбласти

#Область ОбработкаВыборок
  Процедура МассивИзВыборки(Выб, ДанныеБазы, ИзВнутр = Истина)

	Кол = Выб.Поля.Количество();
	Тип = Выб.Тип; Вид = Выб.Вид;
	Измерения = Выб.Поля;
	сИзмерения = СтрСоединить(Измерения, ",");
	Отбор = Новый Структура(сИзмерения);
	
	Если Тип = "РегистрыСведений" Тогда
		Рег = РегистрыСведений;
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		Рег = РегистрыНакопления;
	КонецЕсли;
	
	Рез = Новый Массив;
	
	Для Каждого ТекСтр Из Выб.Выборка Цикл
		Если Тип = "Последовательности" Тогда
			Отбор = Новый Структура(сИзмерения);
		КонецЕсли;
		
		Флаг = Ложь;
		
		Для Сч = 0 По Кол - 1 Цикл
			Поле = ТекСтр[Сч];
			Если ИзВнутр Тогда
				Поле = ЗначениеИзСтрокиВнутр(Поле);  
				ПроверкаНаБитуюСсылку(Поле,Флаг, ДанныеБазы);
			КонецЕсли;
			
			Если Тип = "РегистрыСведений"
			 Или Тип = "РегистрыНакопления"
			 Или Тип = "Последовательности"
			Тогда
				Отбор[Измерения[Сч]] = Поле;
			Иначе
				Значение = Поле; 
			КонецЕсли;
		КонецЦикла;
		
		Если Тип = "РегистрыСведений"
		 Или Тип = "РегистрыНакопления"
		Тогда
			Значение = Рег[Вид].СоздатьКлючЗаписи(Отбор);
			Если Тип = "РегистрыСведений" И Вид = "РасчетПоказателейОтложенногоНалога" Тогда
				Значение = Отбор.Регистратор;
			КонецЕсли;
		ИначеЕсли Тип = "Последовательности" Тогда
			Значение = Отбор;
		КонецЕсли;
		
		Если Флаг Тогда
		
			Продолжить;	
		
		КонецЕсли;
		
		Рез.Добавить(Значение);
	КонецЦикла;
	
	Выб.Вставить("Результат", Рез);
КонецПроцедуры

Процедура ПроверкаНаБитуюСсылку(Поле, Флаг, ДанныеБазы) 
	  
	  Попытка
		  Стр = Строка(Поле); 
		  Если СтрНайти(Стр,"<Объект не найден>")>0 Тогда
			  Флаг =  Истина	
		  КонецЕсли;   
	  Исключение       
		  Коммментарий = СтрШаблон("Поле: %1, Флаг: %2, %3", Поле, Флаг, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		  ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. ПроверкаНаБитуюСсылку'", ОбщегоНазначения.КодОсновногоЯзыка()),
		  УровеньЖурналаРегистрации.Ошибка, , ДанныеБазы.База.Ссылка, Коммментарий);   
	  КонецПопытки;   
	  
  КонецПроцедуры
  

Процедура ОбъединитьРез(соРазница, Рез, Тип)
	
	Для каждого эл Из соРазница Цикл
		Если Тип = "РегистрыСведений"  Тогда
			Рез.Добавить(эл);	
		Иначе
			Попытка
				Если эл.ПолучитьОбъект() <> Неопределено Тогда
					Рез.Добавить(эл);
				КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЛокальныеЗапросы
Функция ВыполнитьЗапрос(ЗапросТекст, Поля, ЗапросПараметры, ДанныеБазы)
	База = ДанныеБазы.База;
	Запрос = Новый Запрос;
	Запрос.Текст = ОбменДаннымиПереопределяемый.АдаптироватьТекстЗапросаОборотов(ЗапросТекст);
	Для Каждого ТекПар Из ЗапросПараметры Цикл
		Ключ = ТекПар.Ключ;
		Зн = ТекПар.Значение;
		
		Если Ключ = "Организация" И ТипЗнч(Зн) = Тип("Строка") Тогда
			Зн = ОбменДаннымиПереопределяемый.Орг(Зн);
		КонецЕсли;
		
		Запрос.УстановитьПараметр(Ключ, Зн);
	КонецЦикла;
	
	мРезультат = Новый Массив;
	Попытка
		РезультатЗапроса = ОбменДаннымиПереопределяемый.ВыполнитьЗапросОборотов(Запрос);
	Исключение           
		Коммментарий = СтрШаблон("Ошибка выполнения запроса. Текст: %1%2Причина: %3", Запрос.Текст, Символы.ПС, 
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. ВыполнитьЗапрос'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);
		Возврат мРезультат;
	КонецПопытки;
	
	КолонкиРезультата = РезультатЗапроса.Колонки;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Новый Массив;
		Для Каждого Изм Из Поля Цикл
			Зн = ОбменДаннымиПереопределяемый.ЗначениеПоляВыборки(Выборка, Изм, КолонкиРезультата);
			Если ТипЗнч(Зн) = Тип("УникальныйИдентификатор") Тогда
				Зн = ЗначениеВСтрокуВнутр(Строка(Зн));
			Иначе
				Зн = ЗначениеВСтрокуВнутр(Зн);
			КонецЕсли;
			Стр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(Стр);
	КонецЦикла;
	
	Возврат мРезультат;
КонецФункции

