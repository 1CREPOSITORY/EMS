// Сверяет данные текущей базы с нижними базами EMS.
// Для каждой актуальной базы читает узел, соответствия объектов и выбранные объекты метаданных,
// сравнивает ключи выборок и пишет расхождения в регистр EMS_СообщенияСинхронизации.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
Процедура ВыполнитьСинхронизацию(Отладка = Ложь) Экспорт
	Базы = БазыДляСинхронизации(); 
	НаборЗаписейСообщений = РегистрыСведений.EMS_СообщенияСинхронизации.СоздатьНаборЗаписей();
	Для Каждого База Из Базы Цикл
		Если Отладка Тогда
			СообщениеОтладки("=== Начало выборки " + База.Ссылка + " ===");     
		КонецЕсли;
		ДанныеБазы = КонструкторСтруктурыДанныеБазы();
		ДанныеБазы.База = База;
		ДанныеБазы.Отладка = Отладка;
		ДанныеБазы.Соединение = ПолучитьПодключениеHTTPСервер(ДанныеБазы.База);
		ДанныеБазы.КэшТипы = Новый Структура("Наружу, Внутрь", Новый Соответствие, Новый Соответствие);
		Если ДанныеБазы.Соединение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеБазы.СоответсвиеОбъектов = СоответствияОбъектовБазы(ДанныеБазы.База); 
		ДанныеБазы.ОбъектыМетаданных = ОбъектыМетаданныхБазы(ДанныеБазы.База);
		Обороты(ДанныеБазы, НаборЗаписейСообщений);  
	КонецЦикла; 
	НаборЗаписейСообщений.Записать();
КонецПроцедуры

// Сверяет верхнюю и нижние базы и регистрирует найденные расхождения к обмену.
// Если в справочнике EMS_ПараметрыБаз нет элементов, задание завершается.
// После сверки при пустом регистре EMS_СообщенияСинхронизации регистрация не выполняется.
//
Процедура ВыполнитьСравнениеИРегистрацию() Экспорт

	Если Не ЕстьЗаписиПараметровБаз() Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьСинхронизацию(Ложь);

	БазыСообщений = БазыИзСообщенийСинхронизации();
	Если БазыСообщений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого База Из БазыСообщений Цикл
		ТаблицаРезультата = ЗарегистрироватьОбъектыКОбмену(База);
		ЗаписатьИтогРегистрации(База, ТаблицаРезультата);
	КонецЦикла;

КонецПроцедуры

// Регистрирует к обмену объекты, которые есть в базе-источнике, но не найдены в текущей базе.
// Данные об объектах берутся из регистра EMS_СообщенияСинхронизации - строки с текстом
// "<Объект не найден>". Регистрация выполняется на стороне базы-источника по HTTP,
// чтобы объекты попали в текущую базу при очередном обмене.
//
// Параметры:
//  База - СправочникСсылка.EMS_ПараметрыБаз - база, по которой берутся расхождения.
//         Если не заполнена, возвращается результат с подсказкой выбрать базу.
//
// Возвращаемое значение:
//  ТаблицаЗначений - результат регистрации:
//    * ПолноеИмяМетаданных - Строка - полное имя объекта метаданных;
//    * УникальныйИдентификатор - Строка - ГУИД объекта;
//    * Результат - Строка - результат регистрации.
//
Функция ЗарегистрироватьОбъектыКОбмену(База) Экспорт

	ТаблицаРезультата = ТаблицаРезультатаРегистрации();
	Если Не ЗначениеЗаполнено(База) Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			"Не выбрана база. Выделите строку в сообщениях синхронизации.");
		Возврат ТаблицаРезультата;
	КонецЕсли;

	ЭлементыПакета = Новый Массив;
	ОписанияЭлементов = Новый Массив;
	ЗаполнитьПакетРегистрации(База, ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата);

	Если ЭлементыПакета.Количество() = 0 Тогда
		Если ТаблицаРезультата.Количество() = 0 Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
				"Нет сообщений для регистрации: по этой базе нет строк с «<Объект не найден>» и нет строк регистров сведений.");
		КонецЕсли;
		Возврат ТаблицаРезультата;
	КонецЕсли;

	ДанныеБазы = КонструкторСтруктурыДанныеБазы();
	ДанныеБазы.База = ПараметрыБазыПоСсылке(База);
	Если ДанныеБазы.База = Неопределено Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			"База не найдена среди актуальных параметров баз.");
		Возврат ТаблицаРезультата;
	КонецЕсли;

	ДанныеБазы.Отладка = Ложь;
	ДанныеБазы.Соединение = ПолучитьПодключениеHTTPСервер(ДанныеБазы.База);
	Если ДанныеБазы.Соединение = Неопределено Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			"Не удалось установить HTTP-соединение с базой.");
		Возврат ТаблицаРезультата;
	КонецЕсли;

	Узел = УзелПланаПоНаименованию(ДанныеБазы.База.НаименованиеУзлаИБ);
	Если Узел = Неопределено Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			СтрШаблон("Узел информационной базы ""%1"" не найден в этой базе.",
				СокрЛП(ДанныеБазы.База.НаименованиеУзлаИБ)));
		Возврат ТаблицаРезультата;
	КонецЕсли;

	ДанныеЗапроса = Новый Структура("ЭлементыПакета, ИмяПланаОбмена", ЭлементыПакета, Узел.Метаданные().Имя);
	ПутьРегистрации = ДанныеБазы.База.WSИмяБазы + "/hs/sverka/V1/register-changes";

	Попытка
		Ответ = ЗапросКБазеПриемнику(ДанныеБазы, "", ДанныеЗапроса, ПутьРегистрации);
	Исключение
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			"Ошибка регистрации: " + ОписаниеОшибки());
		Возврат ТаблицаРезультата;
	КонецПопытки;

	РазобратьРезультатРегистрации(Ответ, ОписанияЭлементов, ТаблицаРезультата);

	Возврат ТаблицаРезультата;

КонецФункции

// Заполняет регистр сведений EMS_ОбъектыМетаданных строками по объектам метаданных,
// входящим в состав плана обмена с указанным именем или синонимом, в разрезе актуальных параметров баз.
// Существующие записи регистра не изменяются - добавляются только недостающие.
//
// Параметры:
//  НаименованиеПланаОбмена - Строка - имя или синоним плана обмена.
//
// Возвращаемое значение:
//  Структура - результат заполнения:
//    * ДобавленоСтрок - Число - количество добавленных записей регистра;
//    * ВсегоОбъектов  - Число - количество объектов метаданных в составе плана обмена;
//    * Баз            - Число - количество обработанных параметров баз;
//    * ПланНайден     - Булево - план обмена найден в метаданных текущей конфигурации.
//
Функция ЗаполнитьОбъектыМетаданныхПоПлануОбмена(НаименованиеПланаОбмена) Экспорт

	ПланОбмена = ПланОбменаПоНаименованию(НаименованиеПланаОбмена);
	ОписаниеЗаполнения = ОписаниеОбъектовПланаОбмена(ПланОбмена);
	ОписаниеОбъектов = ОписаниеЗаполнения.Объекты;
	Базы = Справочники.EMS_ПараметрыБаз.СписокАктуальныхБаз();

	Результат = Новый Структура;
	Результат.Вставить("ДобавленоСтрок", 0);
	Результат.Вставить("ВсегоОбъектов", ОписаниеОбъектов.Количество());
	Результат.Вставить("ПропущеноОбъектов", ОписаниеЗаполнения.Пропущено);
	Результат.Вставить("Баз", Базы.Количество());
	Результат.Вставить("ПланНайден", ПланОбмена <> Неопределено);

	Если ПланОбмена = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ПараметрыБазы Из Базы Цикл

		НаборЗаписей = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПараметрыБазы.Установить(ПараметрыБазы);
		НаборЗаписей.Прочитать();

		СуществующиеЗаписи = Новый Соответствие;
		Для Каждого ЗаписьРегистра Из НаборЗаписей Цикл
			СуществующиеЗаписи.Вставить(КлючЗаписиРегистра(ЗаписьРегистра), Истина);
		КонецЦикла;

		ДобавленоПоБазе = 0;
		Для Каждого ОписаниеОбъекта Из ОписаниеОбъектов Цикл

			Если СуществующиеЗаписи.Получить(КлючЗаписиРегистра(ОписаниеОбъекта)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			НоваяЗапись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ОписаниеОбъекта);
			НоваяЗапись.ПараметрыБазы = ПараметрыБазы;
			ДобавленоПоБазе = ДобавленоПоБазе + 1;

		КонецЦикла;

		Если ДобавленоПоБазе > 0 Тогда
			НаборЗаписей.Записать();
			Результат.ДобавленоСтрок = Результат.ДобавленоСтрок + ДобавленоПоБазе;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запрашивает у выбранной базы состав её выгрузки и добавляет недостающие строки регистра.
// Тип плана определяется в этой базе по наименованию узла. Нижняя база берёт план этого типа
// и исключает объекты с безусловным отказом в своих правилах конвертации и регистрации.
// В этой базе список дополнительно ограничивается включёнными правилами корреспондента.
// Строки выбранной базы, которые не проходят отбор, удаляются.
//
// Параметры:
//  ПараметрыБазыСсылка - СправочникСсылка.EMS_ПараметрыБаз - база, у которой запрашивается состав.
//
// Возвращаемое значение:
//  Структура - ДобавленоСтрок, ВсегоОбъектов, ПропущеноОбъектов, НетВЭтойБазе, ИмяПланаОбмена, База, ОписаниеОшибки.
//
Функция ЗаполнитьОбъектыМетаданныхПоБазе(ПараметрыБазыСсылка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ДобавленоСтрок", 0);
	Результат.Вставить("УдаленоСтрок", 0);
	Результат.Вставить("ВсегоОбъектов", 0);
	Результат.Вставить("ПропущеноОбъектов", 0);
	Результат.Вставить("НетВЭтойБазе", 0);
	Результат.Вставить("ИмяПланаОбмена", "");
	Результат.Вставить("База", "");
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ПравилаКорреспондентаНайдены", Ложь);

	ПараметрыБазы = ПараметрыПодключенияБазы(ПараметрыБазыСсылка);
	Если ПараметрыБазы = Неопределено Тогда
		Результат.ОписаниеОшибки = "Выбранная база не найдена.";
		Возврат Результат;
	КонецЕсли;

	Результат.База = Строка(ПараметрыБазы.Ссылка);
	Если Не ЗначениеЗаполнено(ПараметрыБазы.WSИмяСервера)
		Или Не ЗначениеЗаполнено(ПараметрыБазы.WSИмяБазы)
		Или Не ЗначениеЗаполнено(ПараметрыБазы.НаименованиеУзлаИБ) Тогда
		Результат.ОписаниеОшибки = "У выбранной базы заполните сервер, имя публикации и наименование узла информационной базы.";
		Возврат Результат;
	КонецЕсли;

	ДанныеБазы = КонструкторСтруктурыДанныеБазы();
	ДанныеБазы.База = ПараметрыБазы;
	ДанныеБазы.Соединение = ПолучитьПодключениеHTTPСервер(ПараметрыБазы);
	Если ДанныеБазы.Соединение = Неопределено Тогда
		Результат.ОписаниеОшибки = "Не удалось открыть HTTP-соединение с выбранной базой.";
		Возврат Результат;
	КонецЕсли;

	Узел = УзелПланаПоНаименованию(ПараметрыБазы.НаименованиеУзлаИБ);
	Если Узел = Неопределено Тогда
		Результат.ОписаниеОшибки = СтрШаблон(
			"Узел информационной базы ""%1"" не найден в этой базе.",
			СокрЛП(ПараметрыБазы.НаименованиеУзлаИБ));
		Возврат Результат;
	КонецЕсли;
	ИмяПланаОбмена = Узел.Метаданные().Имя;

	Попытка
		Ответ = ЗапросКБазеПриемнику(ДанныеБазы, "СоставДляСверки",
			Новый Структура("ИмяПланаОбмена", ИмяПланаОбмена),
			ПараметрыБазы.WSИмяБазы + "/hs/sverka/V1/СоставДляСверки");
	Исключение
		Результат.ОписаниеОшибки = "Нижняя база не вернула состав для сверки. "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ " На нижней базе нужен метод СоставДляСверки сервиса sverka.";
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Структура") И ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Результат.ОписаниеОшибки = "Нижняя база не вернула состав для сверки. Обновите на ней расширение: нужен метод СоставДляСверки.";
		Возврат Результат;
	КонецЕсли;

	ОписаниеОшибки = СвойствоОтвета(Ответ, "ОписаниеОшибки");
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Результат.ОписаниеОшибки = Строка(ОписаниеОшибки);
		Возврат Результат;
	КонецЕсли;

	Объекты = СвойствоОтвета(Ответ, "Объекты");
	Если ТипЗнч(Объекты) <> Тип("Массив") Тогда
		Результат.ОписаниеОшибки = "Нижняя база не вернула список объектов.";
		Возврат Результат;
	КонецЕсли;

	ИмяПлана = СвойствоОтвета(Ответ, "ИмяПланаОбмена");
	Если ЗначениеЗаполнено(ИмяПлана) Тогда
		Результат.ИмяПланаОбмена = Строка(ИмяПлана);
	КонецЕсли;
	Пропущено = СвойствоОтвета(Ответ, "ПропущеноОбъектов");
	Если ТипЗнч(Пропущено) = Тип("Число") Тогда
		Результат.ПропущеноОбъектов = Пропущено;
	КонецЕсли;
	Результат.ВсегоОбъектов = Объекты.Количество();
	ПравилаКорреспондента = ИспользуемыеОбъектыПравилКорреспондента(ИмяПланаОбмена);
	Результат.ПравилаКорреспондентаНайдены = ПравилаКорреспондента.ПравилаНайдены;

	НаборЗаписей = РегистрыСведений.EMS_ОбъектыМетаданных.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПараметрыБазы.Установить(ПараметрыБазы.Ссылка);
	НаборЗаписей.Прочитать();

	СуществующиеЗаписи = Новый Соответствие;
	ИндексЗаписи = НаборЗаписей.Количество() - 1;
	Пока ИндексЗаписи >= 0 Цикл
		ЗаписьРегистра = НаборЗаписей[ИндексЗаписи];
		Если ОбъектИсключенИзЗаполнения(ЗаписьРегистра.ОбъектМетаданных, ЗаписьРегистра.Вид, ЗаписьРегистра.Представление)
			Или ОбъектОтсутствуетВПравилахКорреспондента(ПравилаКорреспондента, ЗаписьРегистра.ОбъектМетаданных, ЗаписьРегистра.Вид) Тогда
			НаборЗаписей.Удалить(ИндексЗаписи);
			Результат.УдаленоСтрок = Результат.УдаленоСтрок + 1;
		Иначе
			СуществующиеЗаписи.Вставить(КлючЗаписиРегистра(ЗаписьРегистра), Истина);
		КонецЕсли;
		ИндексЗаписи = ИндексЗаписи - 1;
	КонецЦикла;

	Для Каждого ЭлементОтвета Из Объекты Цикл

		ОписаниеОбъекта = ОписаниеОбъектаМетаданныхИзОтвета(ЭлементОтвета);
		Если Не ЗначениеЗаполнено(ОписаниеОбъекта.ОбъектМетаданных) Или Не ЗначениеЗаполнено(ОписаниеОбъекта.Вид) Тогда
			Продолжить;
		КонецЕсли;
		Если ОбъектИсключенИзЗаполнения(ОписаниеОбъекта.ОбъектМетаданных, ОписаниеОбъекта.Вид, ОписаниеОбъекта.Представление)
			Или ОбъектОтсутствуетВПравилахКорреспондента(ПравилаКорреспондента, ОписаниеОбъекта.ОбъектМетаданных, ОписаниеОбъекта.Вид) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ОписаниеОбъекта.ЕстьВЭтойБазе Тогда
			Результат.НетВЭтойБазе = Результат.НетВЭтойБазе + 1;
		КонецЕсли;
		Если СуществующиеЗаписи.Получить(КлючЗаписиРегистра(ОписаниеОбъекта)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ОписаниеОбъекта);
		НоваяЗапись.ПараметрыБазы = ПараметрыБазы.Ссылка;
		Результат.ДобавленоСтрок = Результат.ДобавленоСтрок + 1;

	КонецЦикла;

	Если Результат.ДобавленоСтрок > 0 Или Результат.УдаленоСтрок > 0 Тогда
		НаборЗаписей.Записать();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Состав выгрузки этой базы для сверки. Метод рассчитан на запуск в нижней базе.
// План берётся по имени типа, состав и правила читаются в базе, которая выполняет метод.
//
// Параметры:
//  ИмяПланаОбмена - Строка - имя типа плана обмена, например ОбменДаннымиZ.
//
// Возвращаемое значение:
//  Структура - Объекты, ПропущеноОбъектов, ИмяПланаОбмена, ОписаниеОшибки.
//
Функция СоставОбъектовДляСверки(ИмяПланаОбмена) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Объекты", Новый Массив);
	Результат.Вставить("ПропущеноОбъектов", 0);
	Результат.Вставить("ИмяПланаОбмена", "");
	Результат.Вставить("ОписаниеОшибки", "");

	ИмяПлана = СокрЛП(Строка(ИмяПланаОбмена));
	ПланОбмена = Неопределено;
	Если ЗначениеЗаполнено(ИмяПлана) Тогда
		ПланОбмена = Метаданные.ПланыОбмена.Найти(ИмяПлана);
	КонецЕсли;
	Если ПланОбмена = Неопределено Тогда
		Результат.ОписаниеОшибки = СтрШаблон("План обмена ""%1"" не найден.", ИмяПлана);
		Возврат Результат;
	КонецЕсли;

	Результат.ИмяПланаОбмена = ПланОбмена.Имя;
	ОписаниеЗаполнения = ОписаниеОбъектовПланаОбмена(ПланОбмена, Истина);
	Результат.Объекты = ОписаниеЗаполнения.Объекты;
	Результат.ПропущеноОбъектов = ОписаниеЗаполнения.Пропущено;
	Возврат Результат;

КонецФункции

Функция ПараметрыПодключенияБазы(ПараметрыБазыСсылка)

	Если Не ЗначениеЗаполнено(ПараметрыБазыСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	EMS_ПараметрыБаз.Proxy КАК Proxy,
	|	EMS_ПараметрыБаз.SSL КАК SSL,
	|	EMS_ПараметрыБаз.WSИмяБазы КАК WSИмяБазы,
	|	EMS_ПараметрыБаз.WSИмяСервера КАК WSИмяСервера,
	|	EMS_ПараметрыБаз.КодОрганизации КАК КодОрганизации,
	|	EMS_ПараметрыБаз.НаименованиеУзлаИБ КАК НаименованиеУзлаИБ,
	|	EMS_ПараметрыБаз.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.EMS_ПараметрыБаз КАК EMS_ПараметрыБаз
	|ГДЕ
	|	EMS_ПараметрыБаз.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПараметрыБазыСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыБазы = КонструкторСтруктурыБазыДляСинхронизации();
	ЗаполнитьЗначенияСвойств(ПараметрыБазы, Выборка);
	ПараметрыБазы.WSИмяПользователя = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Логин");
	ПараметрыБазы.WSПароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Пароль");
	Возврат ПараметрыБазы;

КонецФункции

Функция УзелПланаПоНаименованию(НаименованиеУзлаИБ)

	ИмяУзла = СокрЛП(Строка(НаименованиеУзлаИБ));
	Если Не ЗначениеЗаполнено(ИмяУзла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиЗапроса = Новый Массив;
	НомерПлана = 0;
	Для Каждого ПланОбмена Из Метаданные.ПланыОбмена Цикл

		Если Не ИмяПоляЗапросаДопустимо(ПланОбмена.Имя) Тогда
			Продолжить;
		КонецЕсли;

		ЧастиЗапроса.Добавить(
		"ВЫБРАТЬ
		|	План.Ссылка КАК Ссылка,
		|	" + XMLСтрока(НомерПлана) + " КАК Порядок
		|ИЗ
		|	ПланОбмена." + ПланОбмена.Имя + " КАК План
		|ГДЕ
		|	План.Наименование = &Наименование");
		НомерПлана = НомерПлана + 1;

	КонецЦикла;

	Если ЧастиЗапроса.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Узлы.Ссылка КАК Ссылка
	|ИЗ
	|	(" + СтрСоединить(ЧастиЗапроса, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС) + ") КАК Узлы
	|УПОРЯДОЧИТЬ ПО
	|	Узлы.Порядок";
	Запрос.УстановитьПараметр("Наименование", ИмяУзла);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ОписаниеОбъектаМетаданныхИзОтвета(ЭлементОтвета)

	Описание = Новый Структура;
	Описание.Вставить("ОбъектМетаданных", СокрЛП(Строка(СвойствоОтвета(ЭлементОтвета, "ОбъектМетаданных"))));
	Описание.Вставить("Вид", СокрЛП(Строка(СвойствоОтвета(ЭлементОтвета, "Вид"))));
	Описание.Вставить("Представление", Строка(СвойствоОтвета(ЭлементОтвета, "Представление")));
	Описание.Вставить("Иерархический", СвойствоОтвета(ЭлементОтвета, "Иерархический") = Истина);
	Описание.Вставить("Владелец", СвойствоОтвета(ЭлементОтвета, "Владелец") = Истина);
	Описание.Вставить("Выбран", Истина);
	Описание.Вставить("ПолеОрганизации", Строка(СвойствоОтвета(ЭлементОтвета, "ПолеОрганизации")));
	Описание.Вставить("ЕстьВЭтойБазе", Ложь);

	ПолноеИмя = ПолноеИмяМетаданныхПоКлючу(Описание.ОбъектМетаданных, Описание.Вид);
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Описание.ПолеОрганизации = "";
		Возврат Описание;
	КонецЕсли;

	Описание.ЕстьВЭтойБазе = Истина;
	Описание.Представление = ОбъектМетаданных.Представление();
	Описание.ПолеОрганизации = ПолеОрганизацииОбъектаМетаданных(ОбъектМетаданных, Описание.ОбъектМетаданных);
	Описание.Иерархический = Ложь;
	Описание.Владелец = Ложь;
	Если Описание.ОбъектМетаданных = "Справочники" Тогда
		Описание.Иерархический = ОбъектМетаданных.Иерархический;
		Описание.Владелец = ОбъектМетаданных.Владельцы.Количество() > 0;
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция ПолноеИмяМетаданныхПоКлючу(ВидМетаданных, ИмяОбъекта)

	Виды = Новый Соответствие;
	Виды.Вставить("Справочники", "Справочник");
	Виды.Вставить("Документы", "Документ");
	Виды.Вставить("РегистрыСведений", "РегистрСведений");
	Виды.Вставить("РегистрыНакопления", "РегистрНакопления");
	Виды.Вставить("ПланыВидовХарактеристик", "ПланВидовХарактеристик");
	Виды.Вставить("Последовательности", "Последовательность");
	Виды.Вставить("РегистрыРасчета", "РегистрРасчета");

	ЕдинственноеЧисло = Виды.Получить(ВидМетаданных);
	Если ЕдинственноеЧисло = Неопределено Или Не ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЕдинственноеЧисло + "." + ИмяОбъекта;

КонецФункции

Функция СвойствоОтвета(Данные, ИмяСвойства)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Данные.Свойство(ИмяСвойства, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные.Получить(ИмяСвойства);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// По фрагментам "<Объект не найден>" определяет вид метаданных верхней базы
// и запрашивает представление объекта в нижней базе.
//
// Параметры:
//  База - СправочникСсылка.EMS_ПараметрыБаз - нижняя база;
//  Фрагменты - Массив из Строка - уникальные фрагменты сообщений.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: фрагмент, значение: структура ВидМетаданных, Представление.
//
Функция ОписанияОбъектовНеНайден(База, Фрагменты) Экспорт

	Описания = Новый Соответствие;
	КодыТипов = КодыТиповСсылок();
	ЭлементыЗапроса = Новый Массив;
	ФрагментыЗапроса = Новый Массив;

	Для Каждого Фрагмент Из Фрагменты Цикл

		Описание = Новый Структура("ВидМетаданных, Представление", "", "");
		Разбор = РазобратьФрагментОбъектНеНайден(Фрагмент);
		Если Разбор <> Неопределено Тогда
			ПолноеИмя = ПолноеИмяПоКодуТипа(КодыТипов, Разбор.КодТипа);
			Если ПолноеИмя <> Неопределено Тогда
				Описание.ВидМетаданных = ВидМетаданныхДляОтчета(ПолноеИмя);
				ЭлементыЗапроса.Добавить(Новый Структура(
					"Индекс, ПолноеИмя, ГУИД", ФрагментыЗапроса.Количество(), ПолноеИмя, Разбор.ГУИД));
				ФрагментыЗапроса.Добавить(Фрагмент);
			КонецЕсли;
		КонецЕсли;
		Описания.Вставить(Фрагмент, Описание);

	КонецЦикла;

	ЗаполнитьПредставленияИзНижнейБазы(База, ЭлементыЗапроса, ФрагментыЗапроса, Описания);

	Возврат Описания;

КонецФункции

