КонецФункции

// Возвращает описание объектов метаданных, входящих в состав указанного плана обмена.
//
// Возвращаемое значение:
//  Массив из Структура - описание объекта метаданных:
//    * ОбъектМетаданных - Строка - имя вида метаданных во множественном числе, например "Справочники";
//    * Вид              - Строка - имя объекта метаданных, например "ФизическиеЛица";
//    * Представление    - Строка - синоним объекта метаданных;
//    * Иерархический    - Булево - признак иерархического справочника;
//    * Владелец         - Булево - признак наличия владельца у справочника;
//    * Выбран           - Булево - признак участия объекта в сверке;
//    * ПолеОрганизации  - Строка - имя реквизита со ссылкой на организацию.
//
Функция ПланОбменаПоНаименованию(НаименованиеПланаОбмена) Экспорт

	ИмяПланаОбмена = СокрЛП(Строка(НаименованиеПланаОбмена));
	Если Не ЗначениеЗаполнено(ИмяПланаОбмена) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПланОбмена = Метаданные.ПланыОбмена.Найти(ИмяПланаОбмена);
	Если ПланОбмена <> Неопределено Тогда
		Возврат ПланОбмена;
	КонецЕсли;

	ИмяДляСравнения = НРег(ИмяПланаОбмена);
	Для Каждого ПланОбменаКонфигурации Из Метаданные.ПланыОбмена Цикл
		Если НРег(ПланОбменаКонфигурации.Имя) = ИмяДляСравнения
			Или НРег(ПланОбменаКонфигурации.Представление()) = ИмяДляСравнения Тогда
			Возврат ПланОбменаКонфигурации;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ОписаниеОбъектовПланаОбмена(ПланОбмена)

	ВидыМетаданных = Новый Соответствие;
	ВидыМетаданных.Вставить("Справочник", "Справочники");
	ВидыМетаданных.Вставить("Документ", "Документы");
	ВидыМетаданных.Вставить("РегистрСведений", "РегистрыСведений");
	ВидыМетаданных.Вставить("РегистрНакопления", "РегистрыНакопления");
	ВидыМетаданных.Вставить("ПланВидовХарактеристик", "ПланыВидовХарактеристик");
	ВидыМетаданных.Вставить("Последовательность", "Последовательности");
	ВидыМетаданных.Вставить("РегистрРасчета", "РегистрыРасчета");

	ОписаниеОбъектов = Новый Массив;

	Если ПланОбмена = Неопределено Тогда
		Возврат ОписаниеОбъектов;
	КонецЕсли;

	Для Каждого ЭлементСостава Из ПланОбмена.Состав Цикл

		ОбъектМетаданных = ЭлементСостава.Метаданные;
		ЧастиИмени = СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".", Ложь);
		Если ЧастиИмени.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		ВидМетаданных = ВидыМетаданных.Получить(ЧастиИмени[0]);
		Если ВидМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ОбъектИсключенИзЗаполнения(ВидМетаданных, ОбъектМетаданных.Имя) Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеОбъекта = Новый Структура;
		ОписаниеОбъекта.Вставить("ОбъектМетаданных", ВидМетаданных);
		ОписаниеОбъекта.Вставить("Вид", ОбъектМетаданных.Имя);
		ОписаниеОбъекта.Вставить("Представление", ОбъектМетаданных.Представление());
		ОписаниеОбъекта.Вставить("Иерархический", Ложь);
		ОписаниеОбъекта.Вставить("Владелец", Ложь);
		ОписаниеОбъекта.Вставить("Выбран", Истина);
		ОписаниеОбъекта.Вставить("ПолеОрганизации", ПолеОрганизацииОбъектаМетаданных(ОбъектМетаданных, ВидМетаданных));

		Если ВидМетаданных = "Справочники" Тогда
			ОписаниеОбъекта.Иерархический = ОбъектМетаданных.Иерархический;
			ОписаниеОбъекта.Владелец = ОбъектМетаданных.Владельцы.Количество() > 0;
		КонецЕсли;

		ОписаниеОбъектов.Добавить(ОписаниеОбъекта);

	КонецЦикла;

	Возврат ОписаниеОбъектов;

КонецФункции

Функция ОбъектИсключенИзЗаполнения(ВидМетаданных, ИмяОбъекта)

	Ключ = ВидМетаданных + "." + ИмяОбъекта;
	Возврат Ключ = "РегистрыСведений.СоответствияОбъектовИнформационныхБаз"
		Или Ключ = "Справочники.Пользователи";

КонецФункции

// Возвращает имя реквизита объекта метаданных, содержащего ссылку на организацию.
// По этому реквизиту движок синхронизации ограничивает выборку данными организации базы.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных из состава плана обмена;
//  ВидМетаданных    - Строка - имя вида метаданных во множественном числе.
//
// Возвращаемое значение:
//  Строка - имя реквизита, например "Организация"; пустая строка, если реквизит не найден.
//
Функция ПолеОрганизацииОбъектаМетаданных(ОбъектМетаданных, ВидМетаданных)

	Если ВидМетаданных = "Справочники" Или ВидМетаданных = "Документы" Тогда
		Реквизиты = ОбъектМетаданных.Реквизиты;
	ИначеЕсли ВидМетаданных = "РегистрыСведений" Тогда
		Реквизиты = ОбъектМетаданных.Измерения;
	Иначе
		Возврат "";
	КонецЕсли;

	Реквизит = Реквизиты.Найти("Организация");
	Если Реквизит <> Неопределено Тогда
		Возврат "Организация";
	КонецЕсли;

	Возврат "";

КонецФункции
#КонецОбласти 

#Область HTTPИнтеграция
// Отправляет POST-запрос в базу-приемник и возвращает разобранное тело ответа.
//
// Параметры:
//  ДанныеБазы - Структура - данные базы, см. КонструкторСтруктурыДанныеБазы;
//  ИмяКоманды - Строка - имя метода, зарезервировано для совместимости;
//  ДанныеЗапроса - Структура - тело запроса, сериализуется в JSON;
//  ПутьНаСервере - Строка - путь запроса. Если не заполнен, используется метод Обороты.
//
// Возвращаемое значение:
//  Произвольный - разобранное тело ответа базы-приемника.
//
 Функция ЗапросКБазеПриемнику(ДанныеБазы, ИмяКоманды, ДанныеЗапроса, ПутьНаСервере)
	 База = ДанныеБазы.База;
	 Если Не ЗначениеЗаполнено(ПутьНаСервере) Тогда
		 ПутьНаСервере = База.WSИмяБазы + "/hs/sverka/V1/Обороты";
	 КонецЕсли;
	 //Соединение = ПолучитьПодключениеHTTPСервер(База);
	 
	 Заголовки = Новый Соответствие;
	 Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	 
	 Запрос = Новый HTTPЗапрос(ПутьНаСервере, Заголовки);
	 Запрос.УстановитьТелоИзСтроки(JSON(ДанныеЗапроса, Ложь), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);   
	 
	 Ответ = ДанныеБазы.Соединение.ОтправитьДляОбработки(Запрос);	
	 Если Ответ.КодСостояния = 200 Тогда
		 
		 ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
		 
		 Попытка
			 ДанныеОтвета = unJSON(ТекстОтвета);
		 Исключение        
			 Коммментарий = СтрШаблон("Ошибка получения структуры из json. Причина: %1%2Данные ответа: %3", 
			 	ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, ДанныеОтвета);
			 ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. Разбор JSON'", ОбщегоНазначения.КодОсновногоЯзыка()),
			 УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий); 
			 ВызватьИсключение;
		 КонецПопытки;
		 
		 Возврат ДанныеОтвета;
		 
	 ИначеЕсли Ответ.КодСостояния = 302 или Ответ.КодСостояния = 301 Тогда 
		 НовыйАдрес = Ответ.Заголовки.Получить("Location"); 
	 Иначе        
		 Коммментарий = СтрШаблон("Не удалось выполнить запрос веб-сервиса. Код ответа: %1", Ответ.КодСостояния);
		 ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. Код состояния'", ОбщегоНазначения.КодОсновногоЯзыка()),
		 УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);   
		ВызватьИсключение("Не удалось выполнить запрос веб-сервиса.");
	 КонецЕсли;
	 
КонецФункции

// Создает таблицу результатов регистрации объектов к обмену.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ПолноеИмяМетаданных, УникальныйИдентификатор, Результат.
//
Функция ТаблицаРезультатаРегистрации()

	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("ПолноеИмяМетаданных", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультата.Колонки.Добавить("УникальныйИдентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультата.Колонки.Добавить("Результат", Новый ОписаниеТипов("Строка"));

	Возврат ТаблицаРезультата;

КонецФункции

// Добавляет строку в таблицу результатов регистрации.
//
// Параметры:
//  ТаблицаРезультата - ТаблицаЗначений - таблица результатов;
//  ПолноеИмяМетаданных - Строка - полное имя объекта метаданных;
//  УникальныйИдентификатор - Строка - ГУИД объекта;
//  Результат - Строка - текст результата.
//
Процедура ДобавитьРезультатРегистрации(ТаблицаРезультата, ПолноеИмяМетаданных, УникальныйИдентификатор, Результат)

	СтрокаРезультата = ТаблицаРезультата.Добавить();
	СтрокаРезультата.ПолноеИмяМетаданных = ПолноеИмяМетаданных;
	СтрокаРезультата.УникальныйИдентификатор = УникальныйИдентификатор;
	СтрокаРезультата.Результат = Результат;

КонецПроцедуры

// Возвращает параметры базы из списка актуальных баз.
//
// Параметры:
//  База - СправочникСсылка.EMS_ПараметрыБаз - ссылка на параметры базы.
//
// Возвращаемое значение:
//  Структура, Неопределено - параметры базы или Неопределено, если база не найдена.
//
Функция ПараметрыБазыПоСсылке(База)

	Для Каждого ПараметрыБазы Из БазыДляСинхронизации() Цикл
		Если ПараметрыБазы.Ссылка = База Тогда
			Возврат ПараметрыБазы;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Заполняет пакет регистрации по сообщениям синхронизации выбранной базы.
//
// Параметры:
//  База - СправочникСсылка.EMS_ПараметрыБаз - база, по которой берутся расхождения;
//  ЭлементыПакета - Массив из Структура - заполняемый массив элементов пакета для HTTP-запроса;
//  ОписанияЭлементов - Массив из Структура - заполняемый массив описаний элементов, позиция совпадает с ЭлементыПакета;
//  ТаблицаРезультата - ТаблицаЗначений - таблица результатов, в которую пишутся ошибки разбора.
//
Процедура ЗаполнитьПакетРегистрации(База, ЭлементыПакета, ОписанияЭлементов, ТаблицаРезультата)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сообщения.Тип КАК Тип,
		|	Сообщения.Вид КАК Вид,
		|	Сообщения.Сообщение КАК Сообщение
		|ИЗ
		|	РегистрСведений.EMS_СообщенияСинхронизации КАК Сообщения
		|ГДЕ
		|	Сообщения.База = &База
		|	И Сообщения.Сообщение ПОДОБНО ""%<Объект не найден>%""";
	Запрос.УстановитьПараметр("База", База);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ВидДанных = ВидДанныхДляРегистрации(Выборка.Тип);
		Если ВидДанных = "" Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, ИмяОбъектаМетаданных(Выборка.Тип, Выборка.Вид), "",
				"Неподдерживаемый тип метаданных для регистрации");
			Продолжить;
		КонецЕсли;

		ГУИДы = ГУИДыИзСообщения(Выборка.Сообщение);
		Если ГУИДы.Количество() = 0 Тогда
			ДобавитьРезультатРегистрации(ТаблицаРезультата, ИмяОбъектаМетаданных(Выборка.Тип, Выборка.Вид), "",
				"В сообщении не найден ГУИД объекта");
			Продолжить;
		КонецЕсли;

		ПолноеИмяМетаданных = ИмяОбъектаМетаданных(Выборка.Тип, Выборка.Вид);
		Для Каждого ГУИД Из ГУИДы Цикл

			ЭлементПакета = Новый Структура;
			ЭлементПакета.Вставить("ПолноеИмяМетаданных", ПолноеИмяМетаданных);
			ЭлементПакета.Вставить("ВидДанныхДляРегистрации", ВидДанных);
			ЭлементПакета.Вставить("КлючРегистрацииОтбор", КлючРегистрацииОтбор(ГУИД));
			ЭлементыПакета.Добавить(ЭлементПакета);

			ОписанияЭлементов.Добавить(Новый Структура(
				"ПолноеИмяМетаданных, УникальныйИдентификатор", ПолноеИмяМетаданных, ГУИД));

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Возвращает вид данных для регистрации по типу объекта метаданных.
//
// Параметры:
//  Тип - Строка - имя коллекции метаданных, например "Справочники".
//
// Возвращаемое значение:
//  Строка - вид данных для регистрации или пустая строка, если тип не поддержан.
//
Функция ВидДанныхДляРегистрации(Тип)

	Если Тип = "Справочники" Тогда
		Возврат "Catalog";
	ИначеЕсли Тип = "Документы" Тогда
		Возврат "Document";
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		Возврат "ChartOfCharacteristicTypes";
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает полное имя объекта метаданных по типу и виду.
//
// Параметры:
//  Тип - Строка - имя коллекции метаданных, например "Справочники";
//  Вид - Строка - имя объекта метаданных, например "ФизическиеЛица".
//
// Возвращаемое значение:
//  Строка - полное имя объекта метаданных, например "Справочник.ФизическиеЛица".
//
Функция ИмяОбъектаМетаданных(Тип, Вид)

	Если Тип = "Справочники" Тогда
		Возврат "Справочник." + Вид;
	ИначеЕсли Тип = "Документы" Тогда
		Возврат "Документ." + Вид;
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		Возврат "ПланВидовХарактеристик." + Вид;
	КонецЕсли;

	Возврат Тип + "." + Вид;

КонецФункции

// Извлекает ГУИДы объектов из текста сообщения вида "<Объект не найден> (702:8049...)".
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения регистра EMS_СообщенияСинхронизации.
//
// Возвращаемое значение:
//  Массив из Строка - найденные ГУИД в формате xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.
//
Функция ГУИДыИзСообщения(ТекстСообщения)

	Результат = Новый Массив;
	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(ТекстСообщения, "<Объект не найден> \([^)]*\)");
	Если Совпадения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Совпадение Из Совпадения Цикл
		Фрагмент = Сред(ТекстСообщения, Совпадение.НачальнаяПозиция, Совпадение.Длина);
		ГУИД = ГУИДИзФрагмента(Фрагмент);
		Если ЗначениеЗаполнено(ГУИД) Тогда
			Результат.Добавить(ГУИД);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует фрагмент "<Объект не найден> (702:8049...)" в строку ГУИД.
//
// Параметры:
//  Фрагмент - Строка - найденный фрагмент сообщения.
//
// Возвращаемое значение:
//  Строка - ГУИД или пустая строка, если преобразовать не удалось.
//
Функция ГУИДИзФрагмента(Фрагмент)

	Внутреннее = СтрЗаменить(Фрагмент, "<Объект не найден> (", "");
	Внутреннее = СтрЗаменить(Внутреннее, ")", "");
	Внутреннее = СтрЗаменить(Внутреннее, "0x", "");

	Части = СтрРазделить(Внутреннее, ":", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	Представление = СокрЛП(Части[1]);
	Если СтрДлина(Представление) <> 32 Тогда
		Возврат "";
	КонецЕсли;

	ГУИД = Сред(Представление, 25, 8) + "-" + Сред(Представление, 21, 4) + "-"
		+ Сред(Представление, 17, 4) + "-" + Сред(Представление, 1, 4) + "-"
		+ Сред(Представление, 5, 12);

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(ГУИД);
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат Строка(Идентификатор);

КонецФункции

Функция РазобратьФрагментОбъектНеНайден(Фрагмент)

	Внутреннее = СтрЗаменить(Фрагмент, "<Объект не найден> (", "");
	Если Прав(Внутреннее, 1) = ")" Тогда
		Внутреннее = Лев(Внутреннее, СтрДлина(Внутреннее) - 1);
	КонецЕсли;

	Позиция = СтрНайти(Внутреннее, ":");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодТипа = СтрЗаменить(СокрЛП(Лев(Внутреннее, Позиция - 1)), "0x", "");
	ГУИД = ГУИДИзФрагмента(Фрагмент);
	Если Не ЗначениеЗаполнено(ГУИД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("КодТипа, ГУИД", КодТипа, ГУИД);

КонецФункции

Функция КодыТиповСсылок()

	КодыТипов = Новый Соответствие;
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Справочники, "Справочник");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Документы, "Документ");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыСчетов, "ПланСчетов");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыВидовРасчета, "ПланВидовРасчета");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.ПланыОбмена, "ПланОбмена");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.БизнесПроцессы, "БизнесПроцесс");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Задачи, "Задача");
	ДобавитьКодыТиповКоллекции(КодыТипов, Метаданные.Перечисления, "Перечисление");
	Возврат КодыТипов;

КонецФункции

Процедура ДобавитьКодыТиповКоллекции(КодыТипов, Коллекция, Вид)

	Для Каждого ОбъектМетаданных Из Коллекция Цикл

		ПустаяСсылка = ПустаяСсылкаМенеджера(Вид, ОбъектМетаданных.Имя);
		Если ПустаяСсылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Смв = "";
		Тип = "";
		Код = "";
		УИД = "";
		СтрокаВнутрАнализ(ЗначениеВСтрокуВнутр(ПустаяСсылка), Смв, Тип, Код, УИД);
		Если Не ЗначениеЗаполнено(Код) Тогда
			Продолжить;
		КонецЕсли;

		КодыТипов.Вставить(Код, ОбъектМетаданных.ПолноеИмя());
		Попытка
			КодыТипов.Вставить(Формат(Число(Код), "ЧГ=0"), ОбъектМетаданных.ПолноеИмя());
		Исключение
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Функция ПустаяСсылкаМенеджера(Вид, Имя)

	Если Вид = "Справочник" Тогда
		Возврат Справочники[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[Имя].ПустаяСсылка();
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Перечисления[Имя].ПустаяСсылка();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ВидМетаданныхДляОтчета(ПолноеИмя)

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Синоним = ОбъектМетаданных.Представление();
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Возврат Синоним + " (" + ПолноеИмя + ")";

КонецФункции

Процедура ЗаполнитьПредставленияИзНижнейБазы(База, ЭлементыЗапроса, ФрагментыЗапроса, Описания)

	Если ЭлементыЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПараметрыБазы = ПараметрыБазыПоСсылке(База);
	Если ПараметрыБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеБазы = КонструкторСтруктурыДанныеБазы();
	ДанныеБазы.База = ПараметрыБазы;
	ДанныеБазы.Соединение = ПолучитьПодключениеHTTPСервер(ПараметрыБазы);
	Если ДанныеБазы.Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Ответ = ЗапросКБазеПриемнику(
			ДанныеБазы,
			"Представления",
			Новый Структура("Элементы", ЭлементыЗапроса),
			ПараметрыБазы.WSИмяБазы + "/hs/sverka/V1/Представления");
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаОтвета Из Ответ Цикл

		Индекс = Неопределено;
		Представление = "";
		Если ТипЗнч(СтрокаОтвета) = Тип("Структура") Тогда
			СтрокаОтвета.Свойство("Индекс", Индекс);
			СтрокаОтвета.Свойство("Представление", Представление);
		ИначеЕсли ТипЗнч(СтрокаОтвета) = Тип("Соответствие") Тогда
			Индекс = СтрокаОтвета.Получить("Индекс");
			Представление = СтрокаОтвета.Получить("Представление");
		Иначе
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Индекс) <> Тип("Число")
			Или Индекс < 0
			Или Индекс >= ФрагментыЗапроса.Количество() Тогда
			Продолжить;
		КонецЕсли;

		Описания[ФрагментыЗапроса[Индекс]].Представление = Строка(Представление);

	КонецЦикла;

КонецПроцедуры

// Формирует JSON-строку отбора для регистрации объекта по ГУИД.
//
// Параметры:
//  ГУИД - Строка - идентификатор объекта в формате xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.
//
// Возвращаемое значение:
//  Строка - JSON вида {"УникальныйИдентификатор":"..."}.
//
Функция КлючРегистрацииОтбор(ГУИД)

	Возврат JSON(Новый Структура("УникальныйИдентификатор", ГУИД), Ложь);

КонецФункции

// Переносит результаты регистрации из ответа базы-источника в таблицу результатов.
//
// Параметры:
//  Ответ - Произвольный - разобранное тело ответа базы-источника;
//  ОписанияЭлементов - Массив из Структура - описания отправленных элементов пакета;
//  ТаблицаРезультата - ТаблицаЗначений - заполняемая таблица результатов.
//
Процедура РазобратьРезультатРегистрации(Ответ, ОписанияЭлементов, ТаблицаРезультата)

	Если ТипЗнч(Ответ) <> Тип("Массив") Тогда
		ДобавитьРезультатРегистрации(ТаблицаРезультата, "", "",
			"База-источник вернула неожиданный ответ регистрации.");
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаОтвета Из Ответ Цикл

		Индекс = СтрокаОтвета.Индекс;
		Описание = Неопределено;
		Если ТипЗнч(Индекс) = Тип("Число")
			И Индекс >= 0
			И Индекс < ОписанияЭлементов.Количество() Тогда
			Описание = ОписанияЭлементов[Индекс];
		КонецЕсли;
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		РезультатРегистрации = "Зарегистрирован";
		Если Не СтрокаОтвета.Success Тогда
			РезультатРегистрации = СтрокаОтвета.ErrorText;
		КонецЕсли;

		ДобавитьРезультатРегистрации(ТаблицаРезультата, Описание.ПолноеИмяМетаданных,
			Описание.УникальныйИдентификатор, РезультатРегистрации);

	КонецЦикла;

КонецПроцедуры

Функция JSON(Данные, СОтступами = Истина)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	Если СОтступами Тогда
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(, "	");
	Иначе
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	КонецЕсли;
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Результат = ЗаписьJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция unJSON(JSONСтрока)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONСтрока);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

// Создает HTTP-соединение с базой-приемником.
//
// Параметры:
//  База - Структура - параметры базы (см. КонструкторСтруктурыБазыДляСинхронизации).
//
// Возвращаемое значение:
//  HTTPСоединение, Неопределено - соединение с базой или Неопределено, если создать соединение не удалось.
//
Функция ПолучитьПодключениеHTTPСервер(База)  

	Попытка
		ЗначениеSSL = НРег(СокрЛП(База.SSL));
		ИспользоватьSSL = ЗначениеSSL <> ""
			И ЗначениеSSL <> "нет" И ЗначениеSSL <> "no"
			И ЗначениеSSL <> "false" И ЗначениеSSL <> "0";

		ЗащищенноеСоединение = Неопределено;
		Если ИспользоватьSSL Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
		КонецЕсли;

		Соединение = Новый HTTPСоединение(База.WSИмяСервера, , База.WSИмяПользователя, База.WSПароль, , , ЗащищенноеСоединение);	
	Исключение 
		Коммментарий = СтрШаблон("Ошибка получения http соединения с базой. Причина: %1", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка синхронизации данных. ПолучитьПодключениеHTTPСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , База.Ссылка, Коммментарий);  
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции
#КонецОбласти  

#Область ПреобразованияСтрок
 	
Функция СтрокаПустогоЗначения(Знач Тип) 
	Возврат ЗначениеВСтрокуВнутр(ПустоеЗначение(Тип));
КонецФункции

Функция ПустоеЗначение(Знач Тип) 
	Если Тип =  "DocumentRef.Трансляция" или Тип = "DocumentRef.ТрансформационнаяКорректировка" Тогда
	 	Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Тип) = Тип("Строка") Тогда
		ТипСтр = Тип;
		Тип = Тип(Тип);
	Иначе 
		ТипСтр = XMLТип(Тип).ИмяТипа;
	КонецЕсли;
	
	ТипСтр = СтрРазделить(ТипСтр, ".")[0];
	
	Если      ТипСтр = "EnumRef" Тогда
		Возврат XMLЗначение(Тип, "");
	Иначе
		Возврат XMLЗначение(Тип, "00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Процедура СтрокаВнутрАнализ(СтрВн, Смв = "", Тип = "", Код = "", УИД = "")
	Смв = ""; Тип = ""; Код = ""; УИД = "";
	
	мСтр = СтрРазделить(Сред(СтрВн, 2, СтрДлина(СтрВн) - 2), ",", Истина);
	КолВо = мСтр.Количество();
	
	Смв = Сред(мСтр[0], 2, 1);
	
	Если КолВо < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Тип = мСтр[1];
	
	Если КолВо < 3 Тогда
		Возврат;
	КонецЕсли;
	
	мКодУИД = СтрРазделить(мСтр[2], ":", Истина);
	Код = мКодУИД[0];
	УИД = мКодУИД[1];
КонецПроцедуры

Функция СтрокаВнутрСинтез(Смв, Тип, Код, УИД)
	Возврат "{"
		+ """" + Смв + """" + ","
		+ Тип + ","
		+ Код + ":"
		+ УИД
		+ "}"
	;
КонецФункции

Функция СтрТипЗнч(ЗнчСтр) 
	Знч = ЗначениеИзСтрокиВнутр(ЗнчСтр);
	Тип = ТипЗнч(Знч);
	Возврат XMLТип(Тип).ИмяТипа;
КонецФункции
#КонецОбласти 

#Область АдаптацияДанных
Функция АдаптироватьHTTP(Знач Зн, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, АдаптироватьHTTP(Стр.Значение, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;
		
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(АдаптироватьHTTP(Стр, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;
		
	Иначе
		Рез = Зн;
		
		Если НаружуИстинаВнутрьЛожь = Ложь И СоответствияОбъектов <> Неопределено Тогда
			Соо = СоответствияОбъектов.Получить(Рез);
			Если Соо <> Неопределено Тогда
				Рез = Соо;
			КонецЕсли;
		КонецЕсли;
		
		
		Смв = ""; ТипУИД = ""; КодУИД = ""; УИД = "";
		СтрокаВнутрАнализ(Рез, Смв, ТипУИД, КодУИД, УИД);
		
		Если Смв = "#" И УИД <> "" Тогда 
			Пустое = Типы.Получить(ТипУИД);
			Если Пустое = Неопределено Тогда
				Если НаружуИстинаВнутрьЛожь = Истина Тогда 
					ТипСтр = СтрТипЗнч(Рез);
				Иначе
					тТипСтр = мТипы.Получить(ТипУИД); 
					Пустое = СтрокаПустогоЗначения(тТипСтр);
				КонецЕсли;
				Типы.Вставить(ТипУИД, Пустое);
			КонецЕсли;
			
			СтрокаВнутрАнализ(Пустое,, ТипУИД, КодУИД, );
			
			Рез = СтрокаВнутрСинтез(Смв, ТипУИД, КодУИД, УИД);
		КонецЕсли;
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция СтуктураВИзСтрокиВнутр(Зн, ВИстинаИзЛожь)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, СтуктураВИзСтрокиВнутр(Стр.Значение, ВИстинаИзЛожь));
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(СтуктураВИзСтрокиВнутр(Стр, ВИстинаИзЛожь));
		КонецЦикла;
	Иначе
		Рез = ?(ВИстинаИзЛожь, ЗначениеВСтрокуВнутр(Зн), ЗначениеИзСтрокиВнутр(Зн));
	КонецЕсли;
	Возврат Рез;
КонецФункции  

Функция СтуктураВИзСтрокиВнутрНорм(Зн)
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Для Каждого мСтр Из Стр Цикл
				Если мСтр = "{""B"",0}" Тогда
					Продолжить;	
				КонецЕсли;
				Рез.Добавить(ЗначениеИзСтрокиВнутр(мСтр));	
			КонецЦикла;
			
		КонецЦикла;
	Возврат Рез;
КонецФункции

#КонецОбласти

#Область СравнениеКлючей
 
Функция ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Индекс, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений)
	Если ДанныеБазы.Отладка Тогда
		Сообщить("Л " + соЛокал.Количество() + ", В " + соВнешн.Количество()); 
	КонецЕсли;
	соРазница = Новый Соответствие;
	мРазница = Новый Соответствие;  
	мКлючЗаписиРС = Новый Массив;
		Для Каждого Стр Из соВнешн Цикл
			Если соЛокал.Получить(Стр.Ключ) = Неопределено Тогда
				мСтр = Стр.Значение;
				СтрокаНабора = НаборЗаписейСообщений.Добавить();
				СтрокаНабора.НомерЗаписи = НаборЗаписейСообщений.Количество();
				СтрокаНабора.Дата = ТекущаяДатаСеанса();
				СтрокаНабора.База = ДанныеБазы.База.Ссылка;
				СтрокаНабора.Вид = ОбъектМетаданных.Вид;
				СтрокаНабора.Тип = ОбъектМетаданных.Тип;
				СтрокаНабора.Сообщение = СообщитьМассивСтрокуЗн(мСтр, "В<Л", ДанныеБазы.Отладка);
				Если Индекс = Неопределено Тогда
				  мКлючЗаписиРС.Добавить(Стр.Значение);      
				Иначе 
				соРазница.Вставить(мСтр[Индекс]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	Рез = Новый Массив;
	Для Каждого Стр Из соРазница Цикл
		мСтр = Новый Массив;
		мСтр.Добавить(Стр.Ключ);
		Рез.Добавить(мСтр);
	КонецЦикла; 
	
	Если мКлючЗаписиРС.Количество()>0   Тогда
		 Возврат мКлючЗаписиРС;
	КонецЕсли;
	Если ДанныеБазы.Отладка Тогда
		Сообщить("Разниц: " + Рез.Количество());
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция СообщитьМассивСтрокуЗн(Знач мСтр, Пре, Отладка)
	Сооб = "";
	Сооб = Пре + "|";
	Для Каждого Стр Из мСтр Цикл
		Зн = ЗначениеИзСтрокиВнутр(Стр);
				
		Сооб = Сооб
			+ Зн  + ","
			+ "|"
		;
	КонецЦикла;  
	Если Отладка Тогда
		Сообщить(Сооб);
	КонецЕсли;
	Возврат Сооб;
КонецФункции

Функция ПолучитьКлючиСтр(Внешн, ИнС = Неопределено) 
	соВнешн = Новый Соответствие;
	Для Каждого Стр Из Внешн Цикл
		Ключ = "";   
		сч = 0;
		Для Каждого Зн Из Стр Цикл  
			Если  ИнС = сч Тогда
				Продолжить;	
			КонецЕсли;
			
			Ключ = Ключ + Зн + ","; 
			сч = сч +1;
		КонецЦикла;
		
		соВнешн.Вставить(Ключ, Стр);
	КонецЦикла;
	
	Возврат соВнешн;
КонецФункции
