#Область ПрограммныйИнтерфейс

// Выполняет запрос в нижнюю базу организации.
// Логин, пароль, сервер и имя публикации наружу не возвращаются.
//
// Параметры:
//  ИдентификаторОрганизации - Строка - UUID головной организации.
//  ОтносительныйПуть - Строка - путь HTTP-сервиса нижней базы.
//  Метод - Строка - HTTP-метод. Сейчас допускается только POST.
//  ТелоЗапроса - Структура, Соответствие, Массив, Строка - тело запроса.
//  Таймаут - Число, Неопределено - таймаут соединения в секундах.
//             Неопределено сохраняет прежнее соединение без явного таймаута.
//
// Возвращаемое значение:
//  Структура - ОтветПолучен, ОшибкаРазбораJSON, КодСостояния, Тело, Данные,
//              ТекстОшибки, КодОрганизации, НаименованиеУзлаИБ, База.
//
Функция ВыполнитьЗапросПоОрганизации(Знач ИдентификаторОрганизации, Знач ОтносительныйПуть,
	Знач Метод, Знач ТелоЗапроса, Знач Таймаут = Неопределено) Экспорт
	
	ПроверитьДопустимыйЗапросНижнейБазы(Метод, ОтносительныйПуть);
	Организация = ОрганизацияПоИдентификатору(ИдентификаторОрганизации);
	КодОрганизации = КодОрганизацииEMS(Организация);
	ПараметрыБазы = ПолучитьПараметрыБазыПоКодуОрганизации(КодОрганизации);
	Если ПараметрыБазы = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Не найдены параметры нижней базы EMS для организации '%1' с кодом '%2'.",
			Организация,
			КодОрганизации);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ОтветПолучен", Ложь);
	Результат.Вставить("ОшибкаРазбораJSON", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Тело", "");
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КодОрганизации", ПараметрыБазы.КодОрганизации);
	Результат.Вставить("НаименованиеУзлаИБ", ПараметрыБазы.НаименованиеУзлаИБ);
	Результат.Вставить("База", ПараметрыБазы.Ссылка);
	
	Попытка
		ОтветHTTP = ОтправитьЗапросНижнейБазы(ПараметрыБазы, ОтносительныйПуть, ТелоЗапроса, Таймаут);
	Исключение
		Результат.ТекстОшибки = ТекстОшибкиПодключенияБезСекретов(
			ОписаниеОшибки(), ПараметрыБазы.WSИмяПользователя, ПараметрыБазы.WSПароль);
		Возврат Результат;
	КонецПопытки;
	
	Результат.ОтветПолучен = Истина;
	Результат.КодСостояния = ОтветHTTP.КодСостояния;
	Результат.Тело = ОтветHTTP.Тело;
	Попытка
		Результат.Данные = ПрочитатьJSONИзСтроки(ОтветHTTP.Тело);
	Исключение
		Результат.ОшибкаРазбораJSON = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДопустимыйЗапросНижнейБазы(Знач Метод, Знач ОтносительныйПуть)
	
	Если ВРег(СокрЛП(Метод)) = "POST"
		И ОтносительныйПуть = "/hs/ems-express-data/V1/command" Тогда
		Возврат;
	КонецЕсли;
	ВызватьИсключение "Запрос к нижней базе EMS отклонен: путь или метод не входит в допустимый список.";
	
КонецПроцедуры

Функция ОрганизацияПоИдентификатору(Знач ИдентификаторОрганизации)
	
	Идентификатор = Неопределено;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СокрЛП(ИдентификаторОрганизации));
	Исключение
		Идентификатор = Неопределено;
	КонецПопытки;
	Если Идентификатор = Неопределено Тогда
		ВызватьИсключение "Не определен код организации для выбора нижней базы EMS.";
	КонецЕсли;
	Возврат Справочники.Организации.ПолучитьСсылку(Идентификатор);
	
КонецФункции

Функция КодОрганизацииEMS(Знач Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	EMS_КодСопоставленияОрганизации.Code КАК КодОрганизации
		|ИЗ
		|	РегистрСведений.EMS_КодСопоставленияОрганизации КАК EMS_КодСопоставленияОрганизации
		|ГДЕ
		|	EMS_КодСопоставленияОрганизации.ГУИД = &ГУИД";
	Запрос.УстановитьПараметр("ГУИД", Строка(Организация.УникальныйИдентификатор()));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.КодОрганизации) Тогда
		Возврат Выборка.КодОрганизации;
	КонецЕсли;
	Возврат Организация.Код;
	
КонецФункции

Функция ПолучитьПараметрыБазыПоКодуОрганизации(Знач КодОрганизации)
	
	Если Не ЗначениеЗаполнено(КодОрганизации) Тогда
		ВызватьИсключение "Не определен код организации для выбора нижней базы EMS.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	EMS_ПараметрыБаз.Proxy КАК Proxy,
		|	EMS_ПараметрыБаз.SSL КАК SSL,
		|	EMS_ПараметрыБаз.WSИмяБазы КАК WSИмяБазы,
		|	EMS_ПараметрыБаз.WSИмяСервера КАК WSИмяСервера,
		|	EMS_ПараметрыБаз.КодОрганизации КАК КодОрганизации,
		|	EMS_ПараметрыБаз.НаименованиеУзлаИБ КАК НаименованиеУзлаИБ,
		|	EMS_ПараметрыБаз.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.EMS_ПараметрыБаз КАК EMS_ПараметрыБаз
		|ГДЕ
		|	EMS_ПараметрыБаз.КодОрганизации = &КодОрганизации
		|	И EMS_ПараметрыБаз.НаименованиеУзлаИБ <> """"
		|	И EMS_ПараметрыБаз.WSИмяБазы <> """"
		|	И EMS_ПараметрыБаз.WSИмяСервера <> """"";
	Запрос.УстановитьПараметр("КодОрганизации", КодОрганизации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыБазы = Новый Структура(
		"Proxy, SSL, WSИмяБазы, WSИмяСервера, КодОрганизации, НаименованиеУзлаИБ, Ссылка, WSИмяПользователя, WSПароль");
	ЗаполнитьЗначенияСвойств(ПараметрыБазы, Выборка);
	УчетныеДанные = ПрочитатьУчетныеДанныеСинхронизации();
	ПараметрыБазы.WSИмяПользователя = УчетныеДанные.Логин;
	ПараметрыБазы.WSПароль = УчетныеДанные.Пароль;
	Возврат ПараметрыБазы;
	
КонецФункции

Функция ПрочитатьУчетныеДанныеСинхронизации()
	
	ПривилегированныйРежимБылВключен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылВключен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		Логин = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Логин");
		Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("СинхронизацияEMS", "Пароль");
		Если Не ПривилегированныйРежимБылВключен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Не ПривилегированныйРежимБылВключен И ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("Логин, Пароль", Логин, Пароль);
	
КонецФункции

Функция ОтправитьЗапросНижнейБазы(Знач ПараметрыБазы, Знач ОтносительныйПуть, Знач ТелоЗапроса, Знач Таймаут)
	
	ЗащищенноеСоединение = Неопределено;
	Если ИспользоватьПараметрПодключенияБазы(ПараметрыБазы.SSL) Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
	КонецЕсли;
	Прокси = Неопределено;
	Если ИспользоватьПараметрПодключенияБазы(ПараметрыБазы.Proxy) Тогда
		Протокол = ?(ЗащищенноеСоединение = Неопределено, "http", "https");
		Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(Протокол);
	КонецЕсли;
	Если Таймаут = Неопределено Тогда
		Соединение = Новый HTTPСоединение(
			ПараметрыБазы.WSИмяСервера, , ПараметрыБазы.WSИмяПользователя, ПараметрыБазы.WSПароль,
			Прокси, , ЗащищенноеСоединение);
	Иначе
		Соединение = Новый HTTPСоединение(
			ПараметрыБазы.WSИмяСервера, , ПараметрыБазы.WSИмяПользователя, ПараметрыБазы.WSПароль,
			Прокси, Таймаут, ЗащищенноеСоединение);
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	ЗапросHTTP = Новый HTTPЗапрос(ПараметрыБазы.WSИмяБазы + ОтносительныйПуть, Заголовки);
	ТелоСтрокой = ?(ТипЗнч(ТелоЗапроса) = Тип("Строка"), ТелоЗапроса, СтрокаJSON(ТелоЗапроса));
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоСтрокой, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
	Возврат Новый Структура("КодСостояния, Тело", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	
КонецФункции

Функция ИспользоватьПараметрПодключенияБазы(Знач Значение)
	
	Возврат ЗначениеЗаполнено(Значение);
	
КонецФункции

Функция СтрокаJSON(Знач ДанныеJSON)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ПрочитатьJSONИзСтроки(Знач ТекстJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
	
КонецФункции

Функция ТекстОшибкиПодключенияБезСекретов(Знач ТекстОшибки, Знач Логин, Знач Пароль)
	
	Если ЗначениеЗаполнено(Пароль) И СтрНайти(ТекстОшибки, Пароль) > 0 Тогда
		Возврат "Не удалось соединиться с нижней базой.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Логин) И СтрНайти(ТекстОшибки, Логин) > 0 Тогда
		Возврат "Не удалось соединиться с нижней базой.";
	КонецЕсли;
	Возврат ТекстОшибки;
	
КонецФункции

#КонецОбласти
