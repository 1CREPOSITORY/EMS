// Адаптер сверки для Зарплаты и управления персоналом.
// Ядро EMS вызывает только EMS_АдаптерыСверки. Прямой ссылки на модуль ЗУП здесь нет:
// модуль берётся по имени после проверки метаданных.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ЗарегистрироватьАлгоритмы() Экспорт

	Результат = Новый Массив;
	Описание = ОписаниеАлгоритмаФИОСлужебные();
	Если Описание <> Неопределено Тогда
		Результат.Добавить(Описание);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПравилаПоУмолчанию() Экспорт

	Результат = Новый Массив;
	Описание = ОписаниеАлгоритмаФИОСлужебные();
	Если Описание = Неопределено Или Не Описание.Применимо Тогда
		Возврат Результат;
	КонецЕсли;

	Правило = Новый Структура;
	Правило.Вставить("ТипМетаданных", "РегистрыСведений");
	Правило.Вставить("Вид", "ФИОФизическихЛиц");
	Правило.Вставить("ИмяПоля", "ФИОСлужебные");
	Правило.Вставить("ИдентификаторАлгоритма", Описание.Идентификатор);
	Результат.Добавить(Правило);
	Возврат Результат;

КонецФункции

Функция Нормализовать(Идентификатор, ЗначенияПолей) Экспорт

	Ответ = Новый Структура("Успех, Значение, ТекстОшибки", Ложь, "", "");
	Если Идентификатор <> "ФИОСлужебныеЗУП" Тогда
		Ответ.ТекстОшибки = "Адаптер ЗУП не выполняет алгоритм " + Строка(Идентификатор) + ".";
		Возврат Ответ;
	КонецЕсли;

	Фамилия = СтрокаИсходногоПоля(ЗначенияПолей, "Фамилия");
	Имя = СтрокаИсходногоПоля(ЗначенияПолей, "Имя");
	Отчество = СтрокаИсходногоПоля(ЗначенияПолей, "Отчество");
	Если Фамилия = Неопределено Или Имя = Неопределено Или Отчество = Неопределено Тогда
		Ответ.ТекстОшибки = "Фамилия, имя или отчество не являются строкой.";
		Возврат Ответ;
	КонецЕсли;

	Модуль = МодульФизическихЛиц();
	Если Модуль = Неопределено Тогда
		Ответ.ТекстОшибки = "Общий модуль ФизическиеЛицаЗарплатаКадры недоступен.";
		Возврат Ответ;
	КонецЕсли;

	Попытка
		Результат = Модуль.НаименованиеСлужебноеПоЧастямИмени(Фамилия, Имя, Отчество);
	Исключение
		Ответ.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ответ;
	КонецПопытки;
	Если ТипЗнч(Результат) <> Тип("Строка") Тогда
		Ответ.ТекстОшибки = "НаименованиеСлужебноеПоЧастямИмени вернула не строку.";
		Возврат Ответ;
	КонецЕсли;

	Ответ.Успех = Истина;
	Ответ.Значение = Результат;
	Возврат Ответ;

КонецФункции

Функция ОписаниеАлгоритмаФИОСлужебные()

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "ФИОСлужебныеЗУП");
	Описание.Вставить("Представление", "ФИО служебные ЗУП");
	Описание.Вставить("Адаптер", "ЗУП");
	Описание.Вставить("ПолноеИмяОбъекта", "РегистрСведений.ФИОФизическихЛиц");
	Описание.Вставить("ТипМетаданных", "РегистрыСведений");
	Описание.Вставить("Вид", "ФИОФизическихЛиц");
	Описание.Вставить("ИмяПоля", "ФИОСлужебные");
	ИсходныеПоля = Новый Массив;
	ИсходныеПоля.Добавить("Фамилия");
	ИсходныеПоля.Добавить("Имя");
	ИсходныеПоля.Добавить("Отчество");
	Описание.Вставить("ИсходныеПоля", ИсходныеПоля);
	Причина = ПричинаНеприменимостиФИО(ИсходныеПоля);
	Описание.Вставить("Применимо", Не ЗначениеЗаполнено(Причина));
	Описание.Вставить("ТекстНеприменимости", Причина);
	Возврат Описание;

КонецФункции

Функция ПричинаНеприменимостиФИО(ИсходныеПоля)

	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти("ФИОФизическихЛиц");
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат "В конфигурации нет регистра сведений ФИОФизическихЛиц.";
	КонецЕсли;

	// В ЗУП ФИОСлужебные — реквизит регистра, Фамилия, Имя и Отчество — ресурсы.
	ПолеФИО = ПолеРегистраФИО(МетаданныеРегистра, "ФИОСлужебные");
	Если ПолеФИО = Неопределено Тогда
		Возврат "У регистра сведений ФИОФизическихЛиц нет ресурса или реквизита ФИОСлужебные.";
	КонецЕсли;
	Если Не ПолеСтроковогоТипа(ПолеФИО) Тогда
		Возврат "Поле ФИОСлужебные регистра ФИОФизическихЛиц не является строкой.";
	КонецЕсли;

	Для Каждого ИмяПоля Из ИсходныеПоля Цикл
		Поле = ПолеРегистраФИО(МетаданныеРегистра, ИмяПоля);
		Если Поле = Неопределено Тогда
			Возврат "У регистра сведений ФИОФизическихЛиц нет ресурса или реквизита " + ИмяПоля + ".";
		КонецЕсли;
		Если Не ПолеСтроковогоТипа(Поле) Тогда
			Возврат "Поле " + ИмяПоля + " регистра ФИОФизическихЛиц не является строкой.";
		КонецЕсли;
	КонецЦикла;

	Если Метаданные.ОбщиеМодули.Найти("ФизическиеЛицаЗарплатаКадры") = Неопределено Тогда
		Возврат "В конфигурации нет общего модуля ФизическиеЛицаЗарплатаКадры.";
	КонецЕсли;

	Попытка
		Модуль = ОбщегоНазначения.ОбщийМодуль("ФизическиеЛицаЗарплатаКадры");
	Исключение
		Возврат "ОбщегоНазначения.ОбщийМодуль(""ФизическиеЛицаЗарплатаКадры"") не выполнен: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Модуль = Неопределено Тогда
		Возврат "ОбщегоНазначения.ОбщийМодуль(""ФизическиеЛицаЗарплатаКадры"") вернул пустое значение.";
	КонецЕсли;

	Попытка
		Проба = Модуль.НаименованиеСлужебноеПоЧастямИмени("", "", "");
	Исключение
		Возврат "Пробный вызов НаименованиеСлужебноеПоЧастямИмени не выполнен: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ТипЗнч(Проба) <> Тип("Строка") Тогда
		Возврат "НаименованиеСлужебноеПоЧастямИмени вернула значение типа " + Строка(ТипЗнч(Проба)) + ".";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПолеРегистраФИО(МетаданныеРегистра, ИмяПоля)

	Поле = МетаданныеРегистра.Ресурсы.Найти(ИмяПоля);
	Если Поле <> Неопределено Тогда
		Возврат Поле;
	КонецЕсли;
	Возврат МетаданныеРегистра.Реквизиты.Найти(ИмяПоля);

КонецФункции

Функция МодульФизическихЛиц()

	Если Метаданные.ОбщиеМодули.Найти("ФизическиеЛицаЗарплатаКадры") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ОбщегоНазначения.ОбщийМодуль("ФизическиеЛицаЗарплатаКадры");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПолеСтроковогоТипа(ПолеМетаданных)

	Попытка
		ТипыПоля = ПолеМетаданных.Тип.Типы();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат ТипыПоля.Количество() = 1 И ТипыПоля[0] = Тип("Строка");

КонецФункции

Функция СтрокаИсходногоПоля(ЗначенияПолей, ИмяПоля)

	Если ТипЗнч(ЗначенияПолей) <> Тип("Структура") Или Не ЗначенияПолей.Свойство(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = ЗначенияПолей[ИмяПоля];
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецЕсли
