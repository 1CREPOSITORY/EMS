// Реестр алгоритмов нормализации контрольных полей.
// Ядро передаёт сюда идентификатор. Исполняемый текст из настроек не принимается.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ОписанияАлгоритмов() Экспорт

	Результат = Новый Массив;
	ДобавитьОписанияАдаптера(Результат, EMS_АдаптерЗУП.ЗарегистрироватьАлгоритмы());
	Возврат Результат;

КонецФункции

Функция ПравилаПоУмолчанию() Экспорт

	Результат = Новый Массив;
	ДобавитьОписанияАдаптера(Результат, EMS_АдаптерЗУП.ПравилаПоУмолчанию());
	Возврат Результат;

КонецФункции

Функция НормализоватьЗначение(ОписаниеАлгоритма, ЗначенияПолей) Экспорт

	Ответ = Новый Структура("Успех, Значение, ТекстОшибки", Ложь, "", "");
	Если ТипЗнч(ОписаниеАлгоритма) <> Тип("Структура") Или Не ОписаниеАлгоритма.Свойство("Идентификатор") Тогда
		Ответ.ТекстОшибки = "Алгоритм нормализации не зарегистрирован.";
		Возврат Ответ;
	КонецЕсли;
	Если Не ОписаниеАлгоритма.Свойство("Применимо") Или Не ОписаниеАлгоритма.Применимо Тогда
		Текст = "";
		Если ОписаниеАлгоритма.Свойство("ТекстНеприменимости") Тогда
			Текст = ОписаниеАлгоритма.ТекстНеприменимости;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = "Алгоритм " + ОписаниеАлгоритма.Идентификатор + " неприменим в этой конфигурации.";
		КонецЕсли;
		Ответ.ТекстОшибки = Текст;
		Возврат Ответ;
	КонецЕсли;

	Если ОписаниеАлгоритма.Адаптер = "ЗУП" Тогда
		Возврат EMS_АдаптерЗУП.Нормализовать(ОписаниеАлгоритма.Идентификатор, ЗначенияПолей);
	КонецЕсли;

	Ответ.ТекстОшибки = "Для алгоритма " + ОписаниеАлгоритма.Идентификатор + " не подключён адаптер.";
	Возврат Ответ;

КонецФункции

Функция ТекстОшибкиПравила(ТипМетаданных, Вид, ИмяПоля, Режим, ИдентификаторАлгоритма) Экспорт

	ТипМетаданных = СокрЛП(Строка(ТипМетаданных));
	Вид = СокрЛП(Строка(Вид));
	ИмяПоля = СокрЛП(Строка(ИмяПоля));
	ИдентификаторАлгоритма = СокрЛП(Строка(ИдентификаторАлгоритма));

	Если Не ЗначениеЗаполнено(ТипМетаданных) Или Не ЗначениеЗаполнено(ИмяПоля) Тогда
		Возврат "Укажите тип метаданных и имя поля.";
	КонецЕсли;
	Если Не EMS_ПроверкаСинхронизации.ИмяПоляЗапросаДопустимо(ИмяПоля) Тогда
		Возврат "Имя поля содержит недопустимые символы.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Вид) И Не EMS_ПроверкаСинхронизации.ИмяПоляЗапросаДопустимо(Вид) Тогда
		Возврат "Имя объекта метаданных содержит недопустимые символы.";
	КонецЕсли;

	Если ЗначениеЗаполнено(Вид) Тогда
		МетаданныеОбъекта = EMS_ПроверкаСинхронизации.МетаданныеОбъектаСверки(ТипМетаданных, Вид);
		Если МетаданныеОбъекта = Неопределено Тогда
			Возврат "Объект " + ТипМетаданных + "." + Вид + " отсутствует в этой конфигурации.";
		КонецЕсли;
		Если Не ПолеЕстьУОбъекта(МетаданныеОбъекта, ИмяПоля) Тогда
			Возврат "У объекта " + Вид + " нет поля " + ИмяПоля + ".";
		КонецЕсли;
	КонецЕсли;

	Если Режим = Перечисления.EMS_РежимыОбработкиПолейСверки.Нормализовать Тогда
		Если Не ЗначениеЗаполнено(ИдентификаторАлгоритма) Тогда
			Возврат "Для режима «Нормализовать» выберите зарегистрированный алгоритм.";
		КонецЕсли;
		Описание = ОписаниеПоИдентификатору(ИдентификаторАлгоритма);
		Если Описание = Неопределено Тогда
			Возврат "Алгоритм " + ИдентификаторАлгоритма + " не зарегистрирован.";
		КонецЕсли;
		ТекстСоответствия = ТекстНесоответствияАлгоритма(Описание, ТипМетаданных, Вид, ИмяПоля);
		Если ЗначениеЗаполнено(ТекстСоответствия) Тогда
			Возврат ТекстСоответствия;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ИдентификаторАлгоритма) Тогда
		Возврат "Алгоритм указывается только для режима «Нормализовать».";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ОписаниеПоИдентификатору(Идентификатор)

	Для Каждого Описание Из ОписанияАлгоритмов() Цикл
		Если Описание.Идентификатор = Идентификатор Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПредставленияАлгоритмов() Экспорт

	Результат = Новый Массив;
	Для Каждого Описание Из ОписанияАлгоритмов() Цикл
		Результат.Добавить(Новый Структура(
			"Идентификатор, Представление, Применимо, ТекстНеприменимости, ТипМетаданных, Вид, ИмяПоля",
			Описание.Идентификатор,
			Описание.Представление,
			Описание.Применимо,
			ЗначениеСвойстваОписания(Описание, "ТекстНеприменимости"),
			ЗначениеСвойстваОписания(Описание, "ТипМетаданных"),
			ЗначениеСвойстваОписания(Описание, "Вид"),
			ЗначениеСвойстваОписания(Описание, "ИмяПоля")));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстНесоответствияАлгоритма(Описание, ТипМетаданных, Вид, ИмяПоля)

	Если Описание.Свойство("Применимо") И Не Описание.Применимо Тогда
		Текст = ЗначениеСвойстваОписания(Описание, "ТекстНеприменимости");
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = "Алгоритм " + Описание.Представление + " неприменим в этой конфигурации.";
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;
	ТипАлгоритма = ЗначениеСвойстваОписания(Описание, "ТипМетаданных");
	Если ЗначениеЗаполнено(ТипАлгоритма) И ТипАлгоритма <> ТипМетаданных Тогда
		Возврат "Алгоритм """ + Описание.Представление + """ применяется к типу " + ТипАлгоритма + ".";
	КонецЕсли;
	ПолеАлгоритма = ЗначениеСвойстваОписания(Описание, "ИмяПоля");
	Если ЗначениеЗаполнено(ПолеАлгоритма) И ПолеАлгоритма <> ИмяПоля Тогда
		Возврат "Алгоритм """ + Описание.Представление + """ применяется к полю " + ПолеАлгоритма + ".";
	КонецЕсли;
	ВидАлгоритма = ЗначениеСвойстваОписания(Описание, "Вид");
	Если ЗначениеЗаполнено(ВидАлгоритма) И ВидАлгоритма <> Вид Тогда
		Возврат "Алгоритм """ + Описание.Представление + """ применяется к объекту " + ВидАлгоритма + ".";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ЗначениеСвойстваОписания(Описание, ИмяСвойства)

	Если ТипЗнч(Описание) <> Тип("Структура") Или Не Описание.Свойство(ИмяСвойства) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Описание[ИмяСвойства];

КонецФункции

Процедура ДобавитьОписанияАдаптера(Приемник, Источник)

	Если ТипЗнч(Источник) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Источник Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

Функция ПолеЕстьУОбъекта(МетаданныеОбъекта, ИмяПоля)

	ИменаКоллекций = СтрРазделить("СтандартныеРеквизиты,Измерения,Ресурсы,Реквизиты,ПризнакиУчета", ",", Ложь);
	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		Попытка
			Коллекция = МетаданныеОбъекта[ИмяКоллекции];
		Исключение
			Продолжить;
		КонецПопытки;
		Если ПолеЕстьВКоллекции(Коллекция, ИмяПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПолеЕстьВКоллекции(Коллекция, ИмяПоля)

	// У стандартных реквизитов нет метода Найти.
	Попытка
		Возврат Коллекция.Найти(ИмяПоля) <> Неопределено;
	Исключение
		Для Каждого Поле Из Коллекция Цикл
			Если Поле.Имя = ИмяПоля Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

#КонецЕсли
